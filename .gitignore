## ==============================================================================
## AloBall .gitignore
## Chuẩn hóa cho ASP.NET Core 8 LTS, Entity Framework Core, Visual Studio, SQLite, PostgreSQL
## ==============================================================================

# ------------------------------------------------------------------------------
# Build & Compilation Artifacts
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.build.log
project.lock.json
project.fragment.lock.json
artifacts/
Backup/
UpgradeLog.htm

# ------------------------------------------------------------------------------
# Visual Studio / Visual Studio Code / JetBrains Rider
# ------------------------------------------------------------------------------
.vs/
*.user
*.userosv
*.suo
*.userprefs
*.sln.docstates
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.DotSettings.user

# ------------------------------------------------------------------------------
# Databases & Local Data (CRITICAL: Do NOT commit local databases)
# ------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.dbmdl

# ------------------------------------------------------------------------------
# Configuration & Secrets (CRITICAL: Do NOT commit secrets / production credentials)
# ------------------------------------------------------------------------------
appsettings.Production.json
appsettings.*.local.json
appsettings.local.json
secrets.json
usersecrets/
*.pfx
*.p12
*.key
*.pem
*.cer
*.crt
*.certificate
*.env
*.env.*
!*.env.example

# ------------------------------------------------------------------------------
# Testing & Code Coverage Artifacts
# ------------------------------------------------------------------------------
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml

# ------------------------------------------------------------------------------
# NuGet Packages Cache (dự án có thư mục audit\packages cục bộ >600MB)
# ------------------------------------------------------------------------------
*.nupkg
*.snupkg
packages/
**/packages/*
**/audit/packages/
**/audit/test-results/
**/audit/*.db
**/audit/*.log
**/audit/*.zip

# Business / Sensitive Financial Documents (Báo giá, hợp đồng kinh doanh)
**/bao-gia/
bao-gia/

# Scratch & Temporary Reproduction Scripts
test_repro.cs
*.scratch.*

# ------------------------------------------------------------------------------
# OS-specific files
# ------------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
._*
