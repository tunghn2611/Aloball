@model AloBall.Web.Models.LeaderboardIndexViewModel
@using AloBall.Web.Data.Entities
@using AloBall.Web.Models
@{
    ViewData["Title"] = "Bảng Xếp Hạng Sao Aloball";
    var prog = Model.RegionProgress;
    bool canShowStandings = prog.IsUnlocked || Model.ShowPreview;
}

<style>
    .lb-hero {
        background: linear-gradient(135deg, #064E3B 0%, #0F172A 100%);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 18px;
        padding: 1.4rem;
        color: #F8FAFC;
        margin-bottom: 1.15rem;
        box-shadow: 0 12px 30px rgba(2, 6, 23, 0.22);
    }
    .lb-filter-bar {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        padding: 0.9rem 1rem;
        margin-bottom: 1.25rem;
        box-shadow: var(--ab-shadow-sm);
    }
    .lb-control {
        min-height: 44px;
    }
    .lb-podium-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 1.25rem;
    }
    @@media (max-width: 991px) {
        .lb-podium-grid { grid-template-columns: 1fr; }
    }
    .lb-podium-card {
        border-radius: 16px;
        padding: 1.2rem;
        position: relative;
        cursor: pointer;
        transition: transform 0.16s ease, box-shadow 0.16s ease;
        border: 2px solid transparent;
    }
    .lb-podium-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--ab-shadow);
    }
    .lb-podium-card.rank-1 {
        background: linear-gradient(145deg, #0F172A 0%, #1E293B 55%, #78350F 100%);
        border-color: #F59E0B;
        color: #F8FAFC;
    }
    .lb-podium-card.rank-2 {
        background: linear-gradient(145deg, #0F172A 0%, #334155 100%);
        border-color: #CBD5E1;
        color: #F8FAFC;
    }
    .lb-podium-card.rank-3 {
        background: linear-gradient(145deg, #1E293B 0%, #451A03 100%);
        border-color: #D97706;
        color: #F8FAFC;
    }
    .lb-rank-medal {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
    }
    .rank-1 .lb-rank-medal { background: #F59E0B; color: #0F172A; }
    .rank-2 .lb-rank-medal { background: #E2E8F0; color: #0F172A; }
    .rank-3 .lb-rank-medal { background: #D97706; color: #FFFFFF; }

    .lb-star-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.28rem 0.7rem;
        border-radius: 999px;
        background: rgba(245, 158, 11, 0.16);
        border: 1px solid rgba(245, 158, 11, 0.45);
        color: #B45309;
        font-weight: 800;
        font-size: 0.85rem;
    }
    .lb-podium-card .lb-star-pill {
        color: #FCD34D;
    }
    .lb-form-dot {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 800;
    }
    .lb-form-W { background: #10B981; color: #FFFFFF; }
    .lb-form-D { background: #94A3B8; color: #FFFFFF; }
    .lb-form-L { background: #EF4444; color: #FFFFFF; }
    .lb-unlock-card {
        background: linear-gradient(135deg, #ECFDF5 0%, #FFFFFF 100%);
        border: 1px solid #10B981;
        border-radius: 16px;
        padding: 1.15rem 1.25rem;
        margin-bottom: 1.25rem;
    }
    .lb-table-row {
        cursor: pointer;
        transition: background-color 0.12s ease;
    }
    .lb-table-row:hover {
        background-color: #ECFDF5 !important;
    }
</style>

<div class="container-fluid py-3">
    <div class="lb-hero">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(245,158,11,0.18); border: 1px solid rgba(245,158,11,0.4); color: #FDE68A; font-size: 0.78rem; font-weight: 700;">
                    <i class="bi bi-trophy-fill"></i> ALOBALL STARS &amp; CHỐNG CÀY ĐIỂM Ảo
                </div>
                <h1 class="h3 fw-bold text-white mb-1">Bảng Xếp Hạng Sao Aloball</h1>
                <p class="mb-0 text-white-50 small">Thắng = +3★ · Hòa = +1★ · Thua = 0★ · Chỉ tính trận xác nhận 2 đội hoặc có trọng tài · Tối đa 2 trận tính sao/tháng với cùng đối thủ.</p>
            </div>
            @if (Model.ManagedTeams.Any())
            {
                <div class="px-3 py-2 rounded-3" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.16);">
                    <span class="small text-white-50">Đối chiếu đối đầu theo CLB:</span>
                    <strong class="small text-warning ms-1">@(Model.ManagedTeams.FirstOrDefault(t => t.Id == Model.SelectedMyTeamId)?.Name)</strong>
                </div>
            }
        </div>
    </div>

    <!-- Filter Bar -->
    <form method="get" asp-controller="Leaderboard" asp-action="Index" class="lb-filter-bar">
        <input type="hidden" name="preview" value="@Model.ShowPreview.ToString().ToLowerInvariant()" />
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <select name="region" class="form-select lb-control" onchange="this.form.submit()">
                    <option value="">Tất cả khu vực</option>
                    @foreach (var r in Model.AvailableRegions)
                    {
                        <option value="@r" selected="@string.Equals(Model.SelectedRegion, r, StringComparison.OrdinalIgnoreCase)">Khu vực: @r</option>
                    }
                </select>
            </div>
            @if (Model.ManagedTeams.Count > 1)
            {
                <div class="col-12 col-md-3">
                    <select name="myTeamId" class="form-select lb-control" onchange="this.form.submit()">
                        @foreach (var mt in Model.ManagedTeams)
                        {
                            <option value="@mt.Id" selected="@(mt.Id == Model.SelectedMyTeamId)">Đội của tôi: @mt.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-12 col-md-3 d-flex align-items-center">
                <div class="form-check form-switch mb-0 lb-control d-flex align-items-center gap-2">
                    <input class="form-check-input" type="checkbox" name="onlyRanked" value="true" id="chkOnlyRanked" checked="@Model.OnlyRankedMatches" onchange="this.form.submit()" />
                    <input type="hidden" name="onlyRanked" value="false" />
                    <label class="form-check-label fw-semibold small" for="chkOnlyRanked">Chỉ trận tính sao chuẩn</label>
                </div>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-dark w-100 lb-control fw-bold">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc BXH
                </button>
            </div>
        </div>
    </form>

    <!-- Region Unlock Progress -->
    @if (!prog.IsUnlocked)
    {
        <div class="lb-unlock-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
                <div>
                    <div class="fw-bold text-dark">
                        <i class="bi bi-unlock-fill text-success me-1"></i>
                        Tiến độ mở khóa BXH chính thức @(string.IsNullOrEmpty(prog.Region) ? "Toàn hệ thống" : $"Khu vực {prog.Region}")
                    </div>
                    <div class="small text-muted">Cần tối thiểu <strong>@prog.TargetMatches trận chuẩn</strong> được xác nhận 2 đội hoặc trọng tài để mở bảng chính thức (hiện có <strong>@prog.CurrentRankedMatches/@prog.TargetMatches</strong> trận).</div>
                </div>
                <a asp-controller="Leaderboard"
                   asp-action="Index"
                   asp-route-region="@Model.SelectedRegion"
                   asp-route-onlyRanked="@Model.OnlyRankedMatches"
                   asp-route-preview="@(!Model.ShowPreview)"
                   asp-route-myTeamId="@Model.SelectedMyTeamId"
                   class="btn @(Model.ShowPreview ? "btn-success" : "btn-outline-success") fw-bold lb-control d-inline-flex align-items-center gap-2">
                    <i class="bi bi-eye-fill"></i>
                    <span>@(Model.ShowPreview ? "Đang bật: Bảng tạm tính (Preview)" : "Bảng tạm tính (Preview)")</span>
                </a>
            </div>
            <div class="progress" style="height: 12px; border-radius: 999px;">
                <div class="progress-bar bg-success progress-bar-striped progress-bar-animated"
                     role="progressbar"
                     style="width: @prog.ProgressPercent%;"
                     aria-valuenow="@prog.CurrentRankedMatches"
                     aria-valuemin="0"
                     aria-valuemax="@prog.TargetMatches"></div>
            </div>
        </div>
    }

    @if (!canShowStandings)
    {
        <div class="bg-white rounded-4 border p-5 text-center">
            <i class="bi bi-hourglass-split display-5 text-success"></i>
            <h2 class="h5 fw-bold mt-3">Khu vực đang tích lũy đủ @prog.TargetMatches trận chuẩn để mở BXH chính thức</h2>
            <p class="text-muted small mb-3">Bạn vẫn có thể nhấn nút <strong>“Bảng tạm tính (Preview)”</strong> ở trên để xem thứ hạng hiện tại của các CLB.</p>
            <a asp-controller="Leaderboard"
               asp-action="Index"
               asp-route-region="@Model.SelectedRegion"
               asp-route-onlyRanked="@Model.OnlyRankedMatches"
               asp-route-preview="true"
               asp-route-myTeamId="@Model.SelectedMyTeamId"
               class="btn btn-success fw-bold lb-control d-inline-flex align-items-center px-4">
                <i class="bi bi-eye-fill me-2"></i> Xem Bảng tạm tính (Preview)
            </a>
        </div>
    }
    else if (!Model.Standings.Any())
    {
        <div class="bg-white rounded-4 border p-5 text-center">
            <i class="bi bi-shield-exclamation display-5 text-secondary"></i>
            <h2 class="h5 fw-bold mt-3">Chưa có đội bóng công khai nào trong khu vực này</h2>
        </div>
    }
    else
    {
        <!-- TOP 3 STADIUM PODIUM -->
        @if (Model.TopThree.Any())
        {
            <div class="lb-podium-grid">
                @foreach (var top in Model.TopThree)
                {
                    <div class="lb-podium-card rank-@top.Rank js-open-h2h"
                         data-rival-id="@top.TeamId"
                         data-rival-name="@top.TeamName"
                         data-rival-slug="@top.TeamSlug">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="lb-rank-medal">#@top.Rank</div>
                            <span class="lb-star-pill"><i class="bi bi-star-fill"></i> @top.AloballStars ★</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            @if (!string.IsNullOrEmpty(top.LogoUrl))
                            {
                                <img src="@top.LogoUrl" alt="@top.TeamName" class="rounded-circle object-fit-cover" style="width: 44px; height: 44px; border: 2px solid rgba(255,255,255,0.4);" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px;">
                                    @top.TeamName[..Math.Min(2, top.TeamName.Length)].ToUpperInvariant()
                                </div>
                            }
                            <div>
                                <div class="fw-bold text-white fs-6">
                                    @top.TeamName
                                    @if (top.IsPaidPlanActive)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">@top.PlanTier</span>
                                    }
                                </div>
                                <div class="small text-white-50">@top.Region · Uy tín @top.AverageRating.ToString("0.0")★</div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small pt-2 border-top border-secondary">
                            <span>@top.MatchesPlayed trận (@top.Wins-@top.Draws-@top.Losses) · HS @(top.GoalDiff >= 0 ? "+" : "")@top.GoalDiff</span>
                            <span class="text-warning fw-semibold">Xem đối đầu <i class="bi bi-chevron-right"></i></span>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- RESPONSIVE LEADERBOARD TABLE -->
        <div class="bg-white rounded-4 border shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 64px;" class="text-center">#</th>
                            <th>CLB &amp; Khu vực</th>
                            <th class="text-center">Sao Aloball</th>
                            <th class="text-center">Số trận (W-D-L)</th>
                            <th class="text-center">Phong độ</th>
                            <th>Playstyle Vibe</th>
                            <th class="text-center">Uy tín</th>
                            <th class="text-end">Đối đầu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Standings)
                        {
                            <tr class="lb-table-row js-open-h2h"
                                data-rival-id="@row.TeamId"
                                data-rival-name="@row.TeamName"
                                data-rival-slug="@row.TeamSlug">
                                <td class="text-center fw-bold fs-5">@row.Rank</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(row.LogoUrl))
                                        {
                                            <img src="@row.LogoUrl" alt="" class="rounded-circle object-fit-cover" style="width: 36px; height: 36px;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold small" style="width: 36px; height: 36px; flex-shrink: 0;">
                                                @row.TeamName[..Math.Min(2, row.TeamName.Length)].ToUpperInvariant()
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold text-dark">
                                                @row.TeamName
                                                @if (row.IsPaidPlanActive)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1" style="font-size: 0.7rem;">@row.PlanTier</span>
                                                }
                                            </div>
                                            <div class="small text-muted">@row.Region</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="lb-star-pill"><i class="bi bi-star-fill"></i> @row.AloballStars ★</span>
                                </td>
                                <td class="text-center fw-semibold small">
                                    <div>@row.MatchesPlayed trận (@row.Wins-@row.Draws-@row.Losses)</div>
                                    <div class="text-muted">HS: @(row.GoalDiff >= 0 ? "+" : "")@row.GoalDiff</div>
                                </td>
                                <td class="text-center">
                                    @if (!row.RecentForm.Any())
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                    else
                                    {
                                        <div class="d-inline-flex gap-1">
                                            @foreach (var f in row.RecentForm)
                                            {
                                                <span class="lb-form-dot lb-form-@f">@f</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (row.TopVibes.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var vibe in row.TopVibes)
                                            {
                                                <span class="fc27-vibe-pill @PlayStyleCatalog.GetVibeCssClass(vibe)">@vibe</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa đủ đánh giá</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        <i class="bi bi-star-fill text-warning me-1"></i>@row.AverageRating.ToString("0.0")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-success fw-bold" style="min-height: 44px;">
                                        <i class="bi bi-bar-chart-line me-1"></i> H2H
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Head-to-Head Rivalry Modal -->
<div class="modal fade" id="h2hModal" tabindex="-1" aria-labelledby="h2hModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-dark text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="h2hModalTitle"><i class="bi bi-shield-shaded text-warning me-2"></i>Lịch sử đối đầu (Head-to-Head)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4" id="h2hModalBody">
                <div class="text-center py-4 text-muted">Đang tải dữ liệu đối đầu...</div>
            </div>
            <div class="modal-footer justify-content-between flex-wrap gap-2" id="h2hModalFooter">
                <a href="/Matchmaking" id="h2hProfileBtn" class="btn btn-outline-dark fw-bold lb-control d-inline-flex align-items-center">
                    <i class="bi bi-globe2 me-2"></i> Xem hồ sơ CLB
                </a>
                <a href="/Matchmaking" id="h2hRematchBtn" class="btn btn-success fw-bold lb-control d-inline-flex align-items-center px-4">
                    <i class="bi bi-lightning-charge-fill me-2"></i> Mời tái đấu
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var myTeamId = '@(Model.SelectedMyTeamId?.ToString() ?? "")';
            var modalEl = document.getElementById('h2hModal');
            var modal = modalEl ? new bootstrap.Modal(modalEl) : null;
            var bodyEl = document.getElementById('h2hModalBody');
            var titleEl = document.getElementById('h2hModalTitle');
            var profileBtn = document.getElementById('h2hProfileBtn');
            var rematchBtn = document.getElementById('h2hRematchBtn');

            function escapeHtml(s) {
                return String(s || '').replace(/[&<>"']/g, function (m) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
                });
            }

            document.querySelectorAll('.js-open-h2h').forEach(function (el) {
                el.addEventListener('click', function () {
                    var rivalId = el.getAttribute('data-rival-id');
                    var rivalName = el.getAttribute('data-rival-name') || 'Đối thủ';
                    var rivalSlug = el.getAttribute('data-rival-slug') || '';

                    if (titleEl) titleEl.innerHTML = '<i class="bi bi-shield-shaded text-warning me-2"></i>Đối đầu: ' + escapeHtml(rivalName);
                    if (profileBtn) profileBtn.href = rivalSlug ? ('/doi/' + encodeURIComponent(rivalSlug)) : '/Matchmaking';
                    if (rematchBtn) {
                        rematchBtn.href = myTeamId && rivalSlug
                            ? ('/doi/' + encodeURIComponent(rivalSlug) + '#inviteFriendlyModal')
                            : (myTeamId ? ('/Concierge?teamId=' + encodeURIComponent(myTeamId)) : '/Matchmaking');
                    }

                    if (!modal) return;
                    modal.show();

                    if (!myTeamId || myTeamId === rivalId) {
                        bodyEl.innerHTML =
                            '<div class="text-center py-4">' +
                            '<div class="fw-bold fs-5 mb-2">' + escapeHtml(rivalName) + '</div>' +
                            '<p class="text-muted small mb-0">' +
                            (myTeamId === rivalId
                                ? 'Đây chính là đội bóng của bạn đang chọn. Hãy chọn CLB đối thủ khác để xem thành tích đối đầu.'
                                : 'Đăng nhập bằng tài khoản có CLB để đối chiếu thành tích đối đầu trực tiếp (W-D-L, bàn thắng) với CLB này.') +
                            '</p></div>';
                        return;
                    }

                    bodyEl.innerHTML = '<div class="text-center py-4 text-muted">Đang tải lịch sử đối đầu...</div>';
                    fetch('/Leaderboard/HeadToHead?myTeamId=' + encodeURIComponent(myTeamId) + '&rivalTeamId=' + encodeURIComponent(rivalId))
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            if (d.error) {
                                bodyEl.innerHTML = '<div class="alert alert-warning mb-0">' + escapeHtml(d.error) + '</div>';
                                return;
                            }
                            var rowsHtml = '';
                            if (!d.matches || d.matches.length === 0) {
                                rowsHtml = '<div class="text-center py-3 text-muted small border rounded-3 bg-light">Hai đội chưa có trận đấu xác nhận nào với nhau. Hãy mời tái đấu ngay!</div>';
                            } else {
                                rowsHtml = '<div class="list-group">';
                                d.matches.forEach(function (m) {
                                    var dt = new Date(m.kickoffLocal);
                                    var dtStr = dt.toLocaleDateString('vi-VN') + ' ' + dt.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                                    var capBadge = m.wasCappedByMonthlyLimit
                                        ? '<span class="badge bg-secondary ms-1">Vượt 2 trận/tháng (0★)</span>'
                                        : '<span class="badge bg-warning text-dark ms-1">+' + m.awardedStars + '★</span>';
                                    rowsHtml += '<div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">' +
                                        '<div><div class="fw-bold">' + m.myScore + ' - ' + m.rivalScore + ' (' + escapeHtml(m.resultCode) + ')' + capBadge + '</div>' +
                                        '<div class="small text-muted">' + escapeHtml(m.pitchName) + ' · ' + dtStr + ' · ' + escapeHtml(m.verificationLabel) + '</div></div>' +
                                        '<a href="/Matches/Detail/' + encodeURIComponent(m.matchId) + '" class="btn btn-sm btn-outline-secondary">Chi tiết</a></div>';
                                });
                                rowsHtml += '</div>';
                            }

                            bodyEl.innerHTML =
                                '<div class="row g-2 text-center mb-3">' +
                                '<div class="col-4"><div class="p-3 rounded-3 bg-light border"><div class="small text-muted">Số trận</div><div class="fs-4 fw-bold">' + d.totalMatches + '</div></div></div>' +
                                '<div class="col-4"><div class="p-3 rounded-3 bg-success-subtle border border-success-subtle"><div class="small text-success">Thắng - Hòa - Thua</div><div class="fs-4 fw-bold text-success">' + d.wins + ' - ' + d.draws + ' - ' + d.losses + '</div></div></div>' +
                                '<div class="col-4"><div class="p-3 rounded-3 bg-light border"><div class="small text-muted">Tổng bàn thắng</div><div class="fs-4 fw-bold">' + d.goalsFor + ' - ' + d.goalsAgainst + '</div></div></div>' +
                                '</div>' + rowsHtml;
                        })
                        .catch(function () {
                            bodyEl.innerHTML = '<div class="alert alert-danger mb-0">Không thể tải dữ liệu đối đầu.</div>';
                        });
                });
            });
        });
    </script>
}
