@model AloBall.Web.Data.Entities.PitchBookingRequest
@{
    ViewData["Title"] = $"Yêu cầu đặt sân - {Model.PitchVenue?.Name}";
    var canManage = ViewBag.CanManage as bool? ?? false;
    var isPlatformAdmin = ViewBag.IsPlatformAdmin as bool? ?? false;
}

<header class="page-heading">
    <div>
        <span class="eyebrow">CHI TIẾT YÊU CẦU ĐẶT SÂN</span>
        <h1>Đặt sân: @Model.PitchVenue?.Name</h1>
        <div class="d-flex align-items-center gap-2 mt-2">
            @switch (Model.Status)
            {
                case AloBall.Web.Data.Entities.PitchBookingStatus.Pending:
                    <span class="badge bg-secondary-subtle text-secondary fs-6"><i class="bi bi-clock me-1"></i> Chờ tiếp nhận</span>
                    break;
                case AloBall.Web.Data.Entities.PitchBookingStatus.UnderReview:
                    <span class="badge bg-info-subtle text-info fs-6"><i class="bi bi-telephone-inbound me-1"></i> AloBall đang liên hệ sân</span>
                    break;
                case AloBall.Web.Data.Entities.PitchBookingStatus.AwaitingTeamDecision:
                    <span class="badge bg-warning text-dark fs-6 fw-bold"><i class="bi bi-bell-fill me-1"></i> Đã có báo giá - Chờ đội duyệt</span>
                    break;
                case AloBall.Web.Data.Entities.PitchBookingStatus.Confirmed:
                    <span class="badge bg-success text-white fs-6"><i class="bi bi-check-circle-fill me-1"></i> Đã xác nhận đặt sân</span>
                    break;
                case AloBall.Web.Data.Entities.PitchBookingStatus.Cancelled:
                    <span class="badge bg-danger-subtle text-danger fs-6"><i class="bi bi-x-circle me-1"></i> Đã hủy</span>
                    break;
                case AloBall.Web.Data.Entities.PitchBookingStatus.UnableToFulfill:
                    <span class="badge bg-dark-subtle text-dark fs-6"><i class="bi bi-exclamation-octagon me-1"></i> Sân kín lịch / Không thể đặt</span>
                    break;
                case AloBall.Web.Data.Entities.PitchBookingStatus.Completed:
                    <span class="badge bg-primary text-white fs-6"><i class="bi bi-award-fill me-1"></i> Hoàn thành trận đấu</span>
                    break;
            }
            <span class="text-muted small">Mã yêu cầu: #@Model.Id.ToString()[..8]</span>
        </div>
    </div>
    <div>
        <a asp-action="Index" asp-route-tab="stadium" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Danh sách đặt sân
        </a>
    </div>
</header>

<div class="row g-4">
    <!-- Cột trái: Thông tin Snapshot của Yêu cầu -->
    <div class="col-12 col-lg-5">
        <div class="arena-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-card-checklist text-primary me-2"></i>Thông Tin Đặt Sân</h5>
                <span class="badge bg-light text-dark border">@Model.Team?.Name</span>
            </div>

            <div class="list-group list-group-flush mb-3">
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Cụm sân:</span>
                    <strong class="text-dark">@Model.PitchVenue?.Name</strong>
                </div>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Địa chỉ:</span>
                    <span class="text-dark text-end small" style="max-width: 60%;">@Model.PitchVenue?.FullAddress</span>
                </div>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Ngày thi đấu:</span>
                    <strong class="text-dark">@Model.ServiceDate.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Khung giờ:</span>
                    <strong class="text-dark">@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</strong>
                </div>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Thể thức:</span>
                    <strong class="text-dark">Sân @Model.PitchFormat</strong>
                </div>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Số lượng sân:</span>
                    <span class="badge bg-primary">@Model.PitchCount sân</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ConfirmedFieldCode))
                {
                    <div class="list-group-item px-0 py-2 d-flex justify-content-between bg-success-subtle bg-opacity-25 rounded px-2">
                        <span class="text-success fw-bold">Sân con xác nhận:</span>
                        <strong class="text-success">@Model.ConfirmedFieldCode</strong>
                    </div>
                }
                @if (Model.BudgetVND.HasValue)
                {
                    <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Ngân sách dự kiến:</span>
                        <strong class="text-success">@Model.BudgetVND.Value.ToString("N0") VNĐ</strong>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="list-group-item px-0 py-2">
                        <span class="text-muted d-block small">Ghi chú:</span>
                        <span class="text-dark small">@Model.Notes</span>
                    </div>
                }
                <div class="list-group-item px-0 py-2 d-flex justify-content-between text-muted small">
                    <span>Thời gian gửi:</span>
                    <span>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>

            <!-- Nút Hủy cho Đội trưởng -->
            @if (canManage && (Model.Status == AloBall.Web.Data.Entities.PitchBookingStatus.Pending
                || Model.Status == AloBall.Web.Data.Entities.PitchBookingStatus.UnderReview
                || Model.Status == AloBall.Web.Data.Entities.PitchBookingStatus.AwaitingTeamDecision))
            {
                <hr />
                <form asp-action="CancelPitchBookingRequest" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy yêu cầu đặt sân này không?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="bi bi-x-circle me-1"></i> Hủy yêu cầu đặt sân này
                    </button>
                </form>
            }
            else if (Model.Status == AloBall.Web.Data.Entities.PitchBookingStatus.Confirmed)
            {
                <div class="alert alert-success border-0 small mt-3 mb-0">
                    <i class="bi bi-check-circle-fill me-1"></i> <strong>Sân đã được chốt giữ chỗ!</strong> Nếu cần hủy hoặc dời lịch, vui lòng liên hệ hotline AloBall <strong>1900 6868</strong> để được hỗ trợ với ban quản lý sân.
                </div>
            }

            @if (isPlatformAdmin)
            {
                <div class="mt-3 pt-3 border-top">
                    <a asp-controller="Admin" asp-action="PitchBookingRequestDetails" asp-route-id="@Model.Id" class="btn btn-sm btn-dark w-100">
                        <i class="bi bi-gear-fill me-1"></i> Mở trang xử lý của Super Admin
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Cột phải: Phương án Báo giá & Xác nhận từ Super Admin -->
    <div class="col-12 col-lg-7">
        <div class="arena-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-cash-stack me-2 text-warning"></i>Phương Án Báo Giá & Xác Nhận Chỗ</h5>
                <span class="badge bg-secondary-subtle text-secondary">@Model.Offers.Count() phương án</span>
            </div>

            @if (!Model.Offers.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-hourglass-split fs-1 text-secondary d-block mb-2"></i>
                    <h6>Quản trị viên đang liên hệ xác minh chỗ với chủ sân</h6>
                    <p class="small mb-0">Khi chủ sân xác nhận lịch trống và mức giá thực tế, báo giá chính thức sẽ hiển thị tại đây để bạn duyệt.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var o in Model.Offers.OrderByDescending(x => x.SubmittedAt))
                    {
                        var isAccepted = o.Status == AloBall.Web.Data.Entities.PitchBookingOfferStatus.Accepted;
                        var isPending = o.Status == AloBall.Web.Data.Entities.PitchBookingOfferStatus.Pending;

                        <div class="border rounded-3 p-3 @(isAccepted ? "border-success bg-success-subtle bg-opacity-10 shadow-sm" : "bg-white")">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="fw-bold mb-0 text-dark">
                                        @o.TotalPriceVND.ToString("N0") VNĐ
                                    </h5>
                                    <small class="text-muted">(Thuê @o.ConfirmedPitchCount sân @o.ConfirmedPitchFormat)</small>
                                </div>
                                <div>
                                    @switch (o.Status)
                                    {
                                        case AloBall.Web.Data.Entities.PitchBookingOfferStatus.Pending:
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Chờ đội duyệt</span>
                                            break;
                                        case AloBall.Web.Data.Entities.PitchBookingOfferStatus.Accepted:
                                            <span class="badge bg-success text-white"><i class="bi bi-check-lg me-1"></i> Đã chấp nhận</span>
                                            break;
                                        case AloBall.Web.Data.Entities.PitchBookingOfferStatus.Declined:
                                            <span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-lg me-1"></i> Đã từ chối</span>
                                            break;
                                        case AloBall.Web.Data.Entities.PitchBookingOfferStatus.NotSelected:
                                            <span class="badge bg-light text-muted border">Không chọn</span>
                                            break;
                                        case AloBall.Web.Data.Entities.PitchBookingOfferStatus.Withdrawn:
                                            <span class="badge bg-secondary-subtle text-secondary">Đã thu hồi</span>
                                            break;
                                    }
                                </div>
                            </div>

                            <div class="list-group list-group-flush mb-3 small">
                                <div class="list-group-item px-0 py-1 d-flex justify-content-between">
                                    <span class="text-muted">Sân xác nhận:</span>
                                    <strong class="text-dark">@o.ConfirmedVenueName</strong>
                                </div>
                                <div class="list-group-item px-0 py-1 d-flex justify-content-between">
                                    <span class="text-muted">Khung giờ:</span>
                                    <span>@o.ConfirmedDate.ToString("dd/MM/yyyy") (@o.ConfirmedStartTime.ToString(@"hh\:mm") – @o.ConfirmedEndTime.ToString(@"hh\:mm"))</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(o.SpecificFieldCode))
                                {
                                    <div class="list-group-item px-0 py-1 d-flex justify-content-between">
                                        <span class="text-muted">Vị trí sân con:</span>
                                        <strong class="text-success">@o.SpecificFieldCode</strong>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(o.DepositInstructions))
                            {
                                <div class="small text-dark mb-2 bg-warning-subtle bg-opacity-25 p-2 rounded border border-warning-subtle">
                                    <i class="bi bi-cash me-1 text-warning"></i><strong>Hướng dẫn cọc / thanh toán:</strong> @o.DepositInstructions
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(o.Notes))
                            {
                                <div class="small text-muted mb-3 bg-light p-2 rounded">
                                    <strong>Ghi chú:</strong> @o.Notes
                                </div>
                            }

                            <!-- Nút Chấp nhận / Từ chối -->
                            @if (canManage && isPending && Model.Status != AloBall.Web.Data.Entities.PitchBookingStatus.Confirmed && Model.Status != AloBall.Web.Data.Entities.PitchBookingStatus.Cancelled)
                            {
                                <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                                    <form asp-action="DeclinePitchBookingOffer" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn từ chối báo giá đặt sân này không?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="offerId" value="@o.Id" />
                                        <input type="hidden" name="requestId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-x-circle me-1"></i> Từ chối
                                        </button>
                                    </form>

                                    <form asp-action="AcceptPitchBookingOffer" method="post" onsubmit="return confirm('Xác nhận đồng ý đặt sân với mức giá này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="offerId" value="@o.Id" />
                                        <input type="hidden" name="requestId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-success px-3">
                                            <i class="bi bi-check-circle-fill me-1"></i> Chấp nhận đặt sân
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
