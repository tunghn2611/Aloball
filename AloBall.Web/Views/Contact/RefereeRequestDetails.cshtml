@model AloBall.Web.Data.Entities.RefereeRequest
@{
    ViewData["Title"] = $"Yêu cầu trọng tài - {Model.VenueName}";
    var canManage = ViewBag.CanManage as bool? ?? false;
    var isPlatformAdmin = ViewBag.IsPlatformAdmin as bool? ?? false;
}

<header class="page-heading">
    <div>
        <span class="eyebrow">CHI TIẾT ĐIỀU PHỐI DỊCH VỤ</span>
        <h1>Yêu cầu trọng tài: @Model.VenueName</h1>
        <div class="d-flex align-items-center gap-2 mt-2">
            @switch (Model.Status)
            {
                case AloBall.Web.Data.Entities.RefereeRequestStatus.Pending:
                    <span class="badge bg-secondary-subtle text-secondary fs-6"><i class="bi bi-clock me-1"></i> Chờ tiếp nhận</span>
                    break;
                case AloBall.Web.Data.Entities.RefereeRequestStatus.UnderReview:
                    <span class="badge bg-info-subtle text-info fs-6"><i class="bi bi-search me-1"></i> Đang tìm trọng tài phù hợp</span>
                    break;
                case AloBall.Web.Data.Entities.RefereeRequestStatus.AwaitingTeamDecision:
                    <span class="badge bg-warning text-dark fs-6 fw-bold"><i class="bi bi-bell-fill me-1"></i> Đã có báo giá - Chờ đội quyết định</span>
                    break;
                case AloBall.Web.Data.Entities.RefereeRequestStatus.Confirmed:
                    <span class="badge bg-success text-white fs-6"><i class="bi bi-check-circle-fill me-1"></i> Dịch vụ đã xác nhận</span>
                    break;
                case AloBall.Web.Data.Entities.RefereeRequestStatus.Cancelled:
                    <span class="badge bg-danger-subtle text-danger fs-6"><i class="bi bi-x-circle me-1"></i> Đã hủy</span>
                    break;
                case AloBall.Web.Data.Entities.RefereeRequestStatus.UnableToFulfill:
                    <span class="badge bg-dark-subtle text-dark fs-6"><i class="bi bi-exclamation-octagon me-1"></i> Không thể đáp ứng</span>
                    break;
                case AloBall.Web.Data.Entities.RefereeRequestStatus.Completed:
                    <span class="badge bg-primary text-white fs-6"><i class="bi bi-award-fill me-1"></i> Hoàn thành</span>
                    break;
            }
            <span class="text-muted small">Mã yêu cầu: #@Model.Id.ToString()[..8]</span>
        </div>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Danh sách yêu cầu
        </a>
    </div>
</header>

<div class="row g-4">
    <!-- Cột trái: Thông tin Snapshot của Yêu cầu -->
    <div class="col-12 col-lg-5">
        <div class="arena-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-file-text me-2 text-primary"></i>Thông Tin Trận Đấu</h5>
                <span class="badge bg-light text-dark border">@Model.Team?.Name</span>
            </div>

            <div class="list-group list-group-flush mb-3">
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Ngày thi đấu:</span>
                    <strong class="text-dark">@Model.ServiceDate.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Khung giờ:</span>
                    <strong class="text-dark">@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</strong>
                </div>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Tên sân:</span>
                    <strong class="text-dark text-end">@Model.VenueName</strong>
                </div>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Địa chỉ:</span>
                    <span class="text-dark text-end small" style="max-width: 60%;">@Model.VenueAddress</span>
                </div>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Thể thức:</span>
                    <strong class="text-dark">Sân @Model.MatchFormat</strong>
                </div>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                    <span class="text-muted">Số lượng trọng tài:</span>
                    <span class="badge bg-primary">@Model.RefereeCount người</span>
                </div>
                @if (Model.BudgetVND.HasValue)
                {
                    <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Ngân sách dự kiến:</span>
                        <strong class="text-success">@Model.BudgetVND.Value.ToString("N0") VNĐ</strong>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.PreferredExperience))
                {
                    <div class="list-group-item px-0 py-2">
                        <span class="text-muted d-block small">Yêu cầu kinh nghiệm:</span>
                        <span class="text-dark small">@Model.PreferredExperience</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="list-group-item px-0 py-2">
                        <span class="text-muted d-block small">Ghi chú:</span>
                        <span class="text-dark small">@Model.Notes</span>
                    </div>
                }
                <div class="list-group-item px-0 py-2 d-flex justify-content-between text-muted small">
                    <span>Thời gian tạo:</span>
                    <span>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>

            <!-- Hành động Hủy cho Đội trưởng -->
            @if (canManage && (Model.Status == AloBall.Web.Data.Entities.RefereeRequestStatus.Pending
                || Model.Status == AloBall.Web.Data.Entities.RefereeRequestStatus.UnderReview
                || Model.Status == AloBall.Web.Data.Entities.RefereeRequestStatus.AwaitingTeamDecision))
            {
                <hr />
                <form asp-action="CancelRefereeRequest" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy yêu cầu trọng tài này không?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="bi bi-x-circle me-1"></i> Hủy yêu cầu này
                    </button>
                </form>
            }
            else if (Model.Status == AloBall.Web.Data.Entities.RefereeRequestStatus.Confirmed)
            {
                <div class="alert alert-success border-0 small mt-3 mb-0">
                    <i class="bi bi-info-circle-fill me-1"></i> <strong>Lưu ý:</strong> Dịch vụ đã được xác nhận. Để hủy hoặc đổi lịch, vui lòng liên hệ Admin qua hotline <strong>1900 6868</strong>.
                </div>
            }

            @if (isPlatformAdmin)
            {
                <div class="mt-3 pt-3 border-top">
                    <a asp-controller="Admin" asp-action="RefereeRequestDetails" asp-route-id="@Model.Id" class="btn btn-sm btn-dark w-100">
                        <i class="bi bi-gear-fill me-1"></i> Mở trang xử lý của Super Admin
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Cột phải: Phương án Báo giá & Điều phối từ Admin -->
    <div class="col-12 col-lg-7">
        <div class="arena-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-cash-coin me-2 text-warning"></i>Phương Án Báo Giá & Trọng Tài</h5>
                <span class="badge bg-secondary-subtle text-secondary">@Model.Proposals.Count() phương án</span>
            </div>

            @if (!Model.Proposals.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-hourglass-split fs-1 text-secondary d-block mb-2"></i>
                    <h6>Quản trị viên đang tổng hợp và sắp xếp trọng tài</h6>
                    <p class="small mb-0">Khi có phương án trọng tài khả dụng, báo giá trọn gói sẽ xuất hiện tại đây để đội bạn chốt.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var p in Model.Proposals.OrderByDescending(x => x.SubmittedAt))
                    {
                        var isAccepted = p.Status == AloBall.Web.Data.Entities.RefereeProposalStatus.Accepted;
                        var isPending = p.Status == AloBall.Web.Data.Entities.RefereeProposalStatus.Pending;

                        <div class="border rounded-3 p-3 @(isAccepted ? "border-success bg-success-subtle bg-opacity-10 shadow-sm" : "bg-white")">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="fw-bold mb-0 text-dark">
                                        @p.TotalPriceVND.ToString("N0") VNĐ
                                    </h5>
                                    <small class="text-muted">(Trọn gói @p.Assignments.Count() trọng tài)</small>
                                </div>
                                <div>
                                    @switch (p.Status)
                                    {
                                        case AloBall.Web.Data.Entities.RefereeProposalStatus.Pending:
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Chờ duyệt</span>
                                            break;
                                        case AloBall.Web.Data.Entities.RefereeProposalStatus.Accepted:
                                            <span class="badge bg-success text-white"><i class="bi bi-check-lg me-1"></i> Đã chấp nhận</span>
                                            break;
                                        case AloBall.Web.Data.Entities.RefereeProposalStatus.Declined:
                                            <span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-lg me-1"></i> Đã từ chối</span>
                                            break;
                                        case AloBall.Web.Data.Entities.RefereeProposalStatus.NotSelected:
                                            <span class="badge bg-light text-muted border">Không chọn</span>
                                            break;
                                        case AloBall.Web.Data.Entities.RefereeProposalStatus.Withdrawn:
                                            <span class="badge bg-secondary-subtle text-secondary">Đã thu hồi</span>
                                            break;
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(p.ServiceNote))
                            {
                                <div class="small text-muted mb-3 bg-light p-2 rounded">
                                    <strong>Ghi chú từ AloBall:</strong> @p.ServiceNote
                                </div>
                            }

                            <!-- Danh sách Trọng tài trong gói -->
                            <h6 class="fw-bold small text-secondary text-uppercase mb-2">Danh sách trọng tài phụ trách:</h6>
                            <div class="d-flex flex-column gap-2 mb-3">
                                @foreach (var assignment in p.Assignments)
                                {
                                    var referee = assignment.Referee;
                                    if (referee != null)
                                    {
                                        <div class="p-2 rounded border bg-light bg-opacity-50">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong class="text-dark"><i class="bi bi-person-badge me-1"></i> @referee.Name</strong>
                                                <span class="badge bg-info-subtle text-info">Sân @referee.SupportedFormats</span>
                                            </div>
                                            <div class="small text-muted mt-1">@referee.ExperienceSummary</div>

                                            @if (isAccepted || isPlatformAdmin)
                                            {
                                                <div class="mt-2 pt-2 border-top text-success small fw-semibold">
                                                    <i class="bi bi-telephone-fill me-1"></i> Liên hệ trực tiếp: <span class="text-dark">@referee.ContactInfo</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="mt-2 pt-2 border-top text-muted small">
                                                    <i class="bi bi-lock-fill me-1 text-warning"></i> Liên hệ: <span class="fst-italic text-secondary">[Bảo mật - Mở khóa ngay sau khi xác nhận]</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Nút Chấp nhận / Từ chối dành cho Ban cán sự đội -->
                            @if (canManage && isPending && Model.Status != AloBall.Web.Data.Entities.RefereeRequestStatus.Confirmed && Model.Status != AloBall.Web.Data.Entities.RefereeRequestStatus.Cancelled)
                            {
                                <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                                    <form asp-action="DeclineProposal" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn từ chối phương án báo giá này không?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="proposalId" value="@p.Id" />
                                        <input type="hidden" name="requestId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-x-circle me-1"></i> Từ chối
                                        </button>
                                    </form>

                                    <form asp-action="AcceptProposal" method="post" onsubmit="return confirm('Xác nhận chọn phương án trọng tài này cho trận đấu?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="proposalId" value="@p.Id" />
                                        <input type="hidden" name="requestId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-success px-3">
                                            <i class="bi bi-check-circle-fill me-1"></i> Chấp nhận báo giá
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
