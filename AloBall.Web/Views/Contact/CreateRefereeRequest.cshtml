@model AloBall.Web.Models.CreateRefereeRequestViewModel
@{
    ViewData["Title"] = "Tạo yêu cầu trọng tài";
    var managedTeams = ViewBag.ManagedTeams as IEnumerable<AloBall.Web.Data.Entities.Team> ?? Enumerable.Empty<AloBall.Web.Data.Entities.Team>();
}

<header class="page-heading">
    <div>
        <span class="eyebrow">ĐIỀU PHỐI DỊCH VỤ TRẬN ĐẤU</span>
        <h1>Yêu cầu trọng tài</h1>
        <p class="text-muted">Cung cấp thông tin trận đấu để AloBall sắp xếp trọng tài phù hợp và gửi phương án báo giá.</p>
    </div>
</header>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="arena-card p-4">
            <form asp-action="CreateRefereeRequest" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MatchId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @if (Model.MatchId.HasValue)
                {
                    <div class="alert alert-success-subtle border-0 mb-4 d-flex align-items-center gap-2">
                        <i class="bi bi-link-45deg fs-4 text-success"></i>
                        <div>
                            <strong>Yêu cầu gắn liền với trận đấu đã lên lịch.</strong>
                            <div class="small text-muted">Các thông tin ngày giờ, địa điểm và sân đã được tự động điền sẵn. Bạn có thể điều chỉnh trước khi gửi.</div>
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="TeamId" class="form-label fw-bold">Đội bóng yêu cầu <span class="text-danger">*</span></label>
                    <select asp-for="TeamId" class="form-select" required>
                        @foreach (var t in managedTeams)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                    <span asp-validation-for="TeamId" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="ServiceDate" class="form-label fw-semibold">Ngày thi đấu <span class="text-danger">*</span></label>
                        <input asp-for="ServiceDate" type="date" class="form-control" required min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ServiceDate" class="text-danger small"></span>
                    </div>
                    <div class="col-6 col-md-4">
                        <label asp-for="StartTime" class="form-label fw-semibold">Giờ bắt đầu <span class="text-danger">*</span></label>
                        <input asp-for="StartTime" type="time" class="form-control" required />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>
                    <div class="col-6 col-md-4">
                        <label asp-for="EndTime" class="form-label fw-semibold">Giờ kết thúc <span class="text-danger">*</span></label>
                        <input asp-for="EndTime" type="time" class="form-control" required />
                        <span asp-validation-for="EndTime" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="VenueName" class="form-label fw-semibold">Tên sân thi đấu <span class="text-danger">*</span></label>
                        <input asp-for="VenueName" class="form-control" placeholder="Ví dụ: Sân bóng Thành Phát" required />
                        <span asp-validation-for="VenueName" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="VenueAddress" class="form-label fw-semibold">Địa chỉ cụ thể <span class="text-danger">*</span></label>
                        <input asp-for="VenueAddress" class="form-control" placeholder="Số 2 Hoàng Minh Giám, Cầu Giấy, HN" required />
                        <span asp-validation-for="VenueAddress" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="MatchFormat" class="form-label fw-semibold">Thể thức sân <span class="text-danger">*</span></label>
                        <select asp-for="MatchFormat" class="form-select" required>
                            <option value="7 người">Sân 7 người</option>
                            <option value="5 người">Sân 5 người (Futsal / Mini)</option>
                            <option value="11 người">Sân 11 người (Tiêu chuẩn)</option>
                        </select>
                        <span asp-validation-for="MatchFormat" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="RefereeCount" class="form-label fw-semibold">Số lượng trọng tài <span class="text-danger">*</span></label>
                        <input asp-for="RefereeCount" type="number" min="1" max="10" class="form-control" required />
                        <span asp-validation-for="RefereeCount" class="text-danger small"></span>
                        <div class="form-text">Thông thường 1 trọng tài chính (sân 5/7) hoặc 2-3 người (sân 11).</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="BudgetVND" class="form-label fw-semibold">Ngân sách dự kiến (VNĐ)</label>
                        <input asp-for="BudgetVND" type="number" min="0" step="50000" class="form-control" placeholder="Ví dụ: 350000" />
                        <span asp-validation-for="BudgetVND" class="text-danger small"></span>
                        <div class="form-text">Tùy chọn. Giúp Admin đề xuất mức giá sát nhất.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="PreferredExperience" class="form-label fw-semibold">Yêu cầu kinh nghiệm / cấp độ trọng tài</label>
                    <input asp-for="PreferredExperience" class="form-control" placeholder="Ví dụ: Cần trọng tài có chứng chỉ VFF, nghiêm khắc, quen bắt giải cúp..." />
                    <span asp-validation-for="PreferredExperience" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label fw-semibold">Ghi chú đặc biệt hoặc yêu cầu khác</label>
                    <textarea asp-for="Notes" rows="3" class="form-control" placeholder="Tính chất trận đấu, màu áo đội, lưu ý về nội quy riêng của sân..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-arena-primary px-4">
                        <i class="bi bi-send-fill me-1"></i> Gửi yêu cầu trọng tài
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
