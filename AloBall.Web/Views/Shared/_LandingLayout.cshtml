<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    @{
        var seoTitle = $"Aloball — {ViewData["Title"] ?? "Đội Bóng Trong Mơ"}";
        var seoDescription = ViewData["Description"]?.ToString()
            ?? "Nền tảng quản lý đội bóng phủi: điểm danh qua Zalo, chia tiền sân bằng VietQR, cáp kèo cân trình và tạo thẻ chỉ số cầu thủ chuẩn FIFA.";
    }
    <title>@seoTitle</title>
    <meta name="description" content="@seoDescription" />
    <link rel="canonical" href="https://aloball.vercel.app/" />
    <meta name="theme-color" content="#064E3B" />
    <meta property="og:site_name" content="Aloball" />
    <meta property="og:title" content="@seoTitle" />
    <meta property="og:description" content="@seoDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://aloball.vercel.app/" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content="https://aloball.vercel.app/icon-512.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@seoTitle" />
    <meta name="twitter:description" content="@seoDescription" />
    <meta name="twitter:image" content="https://aloball.vercel.app/icon-512.png" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "Aloball",
      "alternateName": ["Alo Ball", "Aloball VN"],
      "url": "https://aloball.vercel.app/",
      "inLanguage": "vi-VN",
      "description": "Nền tảng quản lý đội bóng phủi: điểm danh qua Zalo, chia tiền sân bằng VietQR, cáp kèo cân trình và tạo thẻ chỉ số cầu thủ chuẩn FIFA."
    }
    </script>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="alternate icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/icon-192.png" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body class="lp">
    <a class="lp-skip" href="#main-content">Bỏ qua điều hướng</a>
    <header class="lp-nav" id="lpNav">
        <div class="lp-container lp-nav__bar">
            <a class="lp-brand" asp-controller="Home" asp-action="Index" aria-label="AloBall — trang chủ">
                <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true"><path d="M16 2 4 6.5V15c0 7.2 5 12.2 12 15 7-2.800 12-7.800 12-15V6.500z" fill="#064E3B"/><circle cx="16" cy="15.500" r="7" fill="#fff"/><path d="m16 11.500 3.300 2.400-1.300 3.900h-4l-1.300-3.900z" fill="#064E3B"/><path d="M16 11.500V8.800M19.300 13.900l2.600-.9M18 17.800l1.600 2.300M14 17.800l-1.600 2.300M12.700 13.900l-2.600-.9" stroke="#064E3B" stroke-width="1.200" stroke-linecap="round"/></svg>
                <span>ALOBALL</span>
            </a>
            <nav class="lp-nav__links" aria-label="Điều hướng chính">
                <a href="#tinh-nang">Tính năng</a>
                <a href="#he-sinh-thai">Hệ sinh thái phủi</a>
                <a href="#cach-hoat-dong">Cách hoạt động</a>
            </nav>
            <div class="lp-nav__cta">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="lp-btn lp-btn--ghost" href="/kham-pha">Khám phá</a>
                    <a class="lp-btn lp-btn--pill" href="/Teams">Vào Đội của tôi →</a>
                }
                else
                {
                    <a class="lp-btn lp-btn--ghost" href="/Account/Login">Đăng nhập</a>
                    <a class="lp-btn lp-btn--pill" href="/Account/Register">Tạo đội miễn phí</a>
                }
            </div>
            <button class="lp-burger" type="button" aria-controls="lpDrawer" aria-expanded="false" aria-label="Mở menu"><span></span><span></span><span></span></button>
        </div>
        <div class="lp-drawer" id="lpDrawer" hidden>
            <a href="#tinh-nang">Tính năng</a>
            <a href="#he-sinh-thai">Hệ sinh thái phủi</a>
            <a href="#cach-hoat-dong">Cách hoạt động</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="lp-btn lp-btn--ghost" href="/kham-pha">Khám phá</a>
                <a class="lp-btn lp-btn--pill" href="/Teams">Vào Đội của tôi →</a>
            }
            else
            {
                <a class="lp-btn lp-btn--ghost" href="/Account/Login">Đăng nhập</a>
                <a class="lp-btn lp-btn--pill" href="/Account/Register">Tạo đội miễn phí</a>
            }
        </div>
    </header>

    <main id="main-content">@RenderBody()</main>

    <footer class="lp-footer">
        <div class="lp-container lp-footer__grid">
            <div>
                <a class="lp-brand lp-brand--light" asp-controller="Home" asp-action="Index"><svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path d="M16 2 4 6.5V15c0 7.2 5 12.2 12 15 7-2.800 12-7.800 12-15V6.500z" fill="#064E3B"/><circle cx="16" cy="15.500" r="7" fill="#fff"/><path d="m16 11.500 3.300 2.400-1.300 3.900h-4l-1.300-3.900z" fill="#064E3B"/><path d="M16 11.500V8.800M19.300 13.900l2.600-.9M18 17.800l1.600 2.300M14 17.800l-1.600 2.300M12.700 13.900l-2.600-.9" stroke="#064E3B" stroke-width="1.200" stroke-linecap="round"/></svg><span>ALOBALL</span></a>
                <p>Quản lý đội bóng phủi gọn trong một chạm.</p>
            </div>
            <nav aria-label="Liên kết nhanh">
                <a href="#tinh-nang">Tính năng</a>
                <a asp-controller="Home" asp-action="Explore">Khám phá đội &amp; kèo</a>
                <a asp-controller="Matchmaking" asp-action="Index">Tìm đối giao lưu</a>
                <a asp-controller="Contact" asp-action="Index">Liên hệ</a>
                <a asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
            </nav>
        </div>
        <div class="lp-container lp-footer__copy">© @DateTime.Now.Year AloBall. Đam mê trên sân, kết nối ngoài sân.</div>
    </footer>
    <script src="~/js/landing.js" asp-append-version="true"></script>
    <script src="~/js/landing-fx.js" asp-append-version="true" defer></script>
</body>
</html>
