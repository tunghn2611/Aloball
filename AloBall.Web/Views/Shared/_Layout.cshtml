@{
    var section = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var sectionName = section switch { "Teams" => "Đội bóng", "Matches" => "Thi đấu", "Attendance" => "Sinh hoạt", "FireKeeping" => "Giữ Lửa", "Matchmaking" => "Kết nối", "LoanMarket" => "Mượn cầu thủ", "Concierge" => "Thi đấu trọn gói", "Leaderboard" => "Bảng xếp hạng", "Tournaments" => "Giải đấu", "PartnerPortal" => "Đối tác B2B", "Account" => "Tài khoản", "Admin" => "Quản trị", "Sheets" => "Dữ liệu đội", "Contact" => "Liên hệ", _ => "Khám phá" };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · AloBall</title>
    <meta name="theme-color" content="#064E3B" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/arena.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fc27-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fc27-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/playstyles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/aloball-theme.css" asp-append-version="true" />
</head>
<body class="arena-app page-@(section.ToLowerInvariant()) view-@(action.ToLowerInvariant())">
    <a class="skip-link" href="#main-content">Đến nội dung chính</a>
    <aside class="arena-sidebar" id="arenaSidebar" aria-label="Điều hướng chính">
        <a class="arena-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-symbol">
                <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><path d="M16 2 4 6.5V15c0 7.2 5 12.2 12 15 7-2.8 12-7.8 12-15V6.5z" fill="#10B981"/><circle cx="16" cy="15.5" r="6.5" fill="#fff"/><path d="m16 11.8 3 2.2-1.2 3.6h-3.6L13 14z" fill="#064E3B"/></svg>
            </span>
            <span>ALO<span class="brand-light">BALL</span><small>THE FOOTBALL CLUBHOUSE</small></span>
        </a>
        <button class="sidebar-close" type="button" aria-label="Đóng menu"><i class="bi bi-x-lg"></i></button>
        <div class="sidebar-label">SÂN CHƠI CỦA BẠN</div>
        <nav class="primary-nav" aria-label="Menu ứng dụng">
            <a class="@(section == "Home" ? "active" : "")" asp-controller="Home" asp-action="Explore"><i class="bi bi-compass"></i><span>Khám phá</span><span class="nav-index">01</span></a>
            <a class="@(section == "Teams" || section == "Attendance" || section == "Matches" || section == "FireKeeping" || section == "Sheets" ? "active" : "")" asp-controller="Teams" asp-action="Index"><i class="bi bi-shield-check"></i><span>Đội của tôi</span><span class="nav-index">02</span></a>
            <a class="@(section == "Matchmaking" ? "active" : "")" asp-controller="Matchmaking" asp-action="Index"><i class="bi bi-lightning-charge"></i><span>Tìm đối giao lưu</span><span class="nav-index">03</span></a>
            <a class="@(section == "LoanMarket" ? "active" : "")" asp-controller="LoanMarket" asp-action="Index"><i class="bi bi-person-plus"></i><span>Mượn cầu thủ</span><span class="nav-index">04</span></a>
            <a class="@(section == "Concierge" ? "active" : "")" asp-controller="Concierge" asp-action="Index"><i class="bi bi-stars"></i><span>Thi đấu trọn gói</span><span class="nav-index">05</span></a>
            <a class="@(section == "Leaderboard" ? "active" : "")" asp-controller="Leaderboard" asp-action="Index"><i class="bi bi-trophy"></i><span>Bảng xếp hạng</span><span class="nav-index">06</span></a>
            <a class="@(section == "Tournaments" ? "active" : "")" asp-controller="Tournaments" asp-action="Index"><i class="bi bi-diagram-3"></i><span>Giải đấu</span><span class="nav-index">07</span></a>
            <a class="@(section == "PartnerPortal" ? "active" : "")" asp-controller="PartnerPortal" asp-action="Index"><i class="bi bi-lightning-charge"></i><span>Đối tác B2B</span><span class="nav-index">08</span></a>
            <a class="@(section == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Index"><i class="bi bi-geo-alt"></i><span>Đặt sân &amp; Trọng tài</span><span class="nav-index">09</span></a>
            <a href="/kham-pha#lich-dau-ket-qua"><i class="bi bi-calendar2-event"></i><span>Lịch đấu &amp; kết quả</span><span class="nav-index">10</span></a>
        </nav>
        <div class="sidebar-callout">
            <span class="eyebrow">⚡ MỘT ĐỘI. MỘT ĐAM MÊ.</span>
            <h2>Ra sân cùng nhau, mỗi tuần.</h2>
            <p>Điểm danh Zalo, chia tiền sân VietQR và lưu thẻ FIFA cho cả đội.</p>
            <a asp-controller="Teams" asp-action="Create">Tạo đội bóng ngay <i class="bi bi-arrow-up-right"></i></a>
        </div>
        <div class="sidebar-foot"><span class="status-dot"></span> Bóng đá kết nối chúng ta.<small>ALOBALL / EST. 2026</small></div>
    </aside>
    <button class="sidebar-scrim" aria-label="Đóng điều hướng" type="button" tabindex="-1"></button>
    <div class="arena-shell">
        <header class="arena-topbar">
            <div class="topbar-path">
                <button class="menu-trigger" type="button" aria-controls="arenaSidebar" aria-expanded="false" aria-label="Mở menu Thêm"><i class="bi bi-list"></i><span class="mobile-more-label">Thêm</span></button>
                <span class="topbar-wordmark">ALOBALL<span>®</span></span>
                <span class="path-divider">/</span>
                <span class="topbar-SectionPill">@sectionName</span>
            </div>
            <div class="topbar-actions">
                <a class="topbar-create" asp-controller="Teams" asp-action="Create"><i class="bi bi-plus-lg"></i> Tạo đội</a>
                @if (User.Identity?.IsAuthenticated == true) {
                    <a class="ab-coin-pill" asp-controller="Teams" asp-action="Index" title="Điểm uy tín &amp; AB Coin">
                        <i class="bi bi-coin"></i><span>AB Coin</span><b>PRO</b>
                    </a>
                    <div class="dropdown">
                        <button class="account-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tài khoản">
                            <span class="account-monogram">@(string.IsNullOrEmpty(User.Identity.Name) ? "A" : User.Identity.Name[..1].ToUpperInvariant())</span>
                            <span class="account-name">@User.Identity.Name</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-header">@User.Identity.Name</span></li>
                            <li><a class="dropdown-item" asp-controller="Teams" asp-action="Index"><i class="bi bi-shield-check me-2"></i>Đội của tôi</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-badge me-2"></i>Hồ sơ cá nhân</a></li>
                            @if(string.Equals(User.Identity.Name, "admin@aloball.vn", StringComparison.OrdinalIgnoreCase)) {
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-sliders me-2"></i>Quản trị hệ thống</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button></form></li>
                        </ul>
                    </div>
                } else {
                    <a class="btn btn-arena-primary" asp-controller="Account" asp-action="Login">Đăng nhập <i class="bi bi-arrow-up-right"></i></a>
                }
            </div>
        </header>
        <main id="main-content" class="arena-content">
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show" role="status"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button></div> }
            @RenderBody()
        </main>
        <footer class="arena-footer">
            <a asp-controller="Home" asp-action="Index">ALOBALL<span>®</span></a>
            <span>Đam mê trên sân. Kết nối ngoài sân.</span>
            <a asp-controller="Home" asp-action="Explore">Khám phá</a>
            <a asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
            <small>© @DateTime.Now.Year AloBall</small>
        </footer>
    </div>
    <nav class="ab-mobile-bottom-nav" aria-label="Điều hướng nhanh trên di động">
        <a class="ab-mobile-tab @(section == "Teams" || section == "Home" || section == "Attendance" || section == "FireKeeping" || section == "Sheets" ? "active" : "")"
           asp-controller="@(User.Identity?.IsAuthenticated == true ? "Teams" : "Home")"
           asp-action="@(User.Identity?.IsAuthenticated == true ? "Index" : "Explore")"
           aria-label="Trang chủ / CLB">
            <i class="bi @(User.Identity?.IsAuthenticated == true ? "bi-shield-check" : "bi-house-door-fill")"></i>
            <span>@(User.Identity?.IsAuthenticated == true ? "CLB" : "Trang chủ")</span>
        </a>
        <a class="ab-mobile-tab @(section == "Matchmaking" || section == "Matches" ? "active" : "")"
           asp-controller="Matchmaking" asp-action="Index">
            <i class="bi bi-lightning-charge-fill"></i>
            <span>Trận đấu</span>
        </a>
        <a class="ab-mobile-tab @(section == "LoanMarket" ? "active" : "")"
           asp-controller="LoanMarket" asp-action="Index">
            <i class="bi bi-person-plus-fill"></i>
            <span>Mượn quân</span>
        </a>
        <a class="ab-mobile-tab @(section == "Concierge" ? "active" : "")"
           asp-controller="Concierge" asp-action="Index">
            <i class="bi bi-stars"></i>
            <span>Trọn gói</span>
        </a>
        <a class="ab-mobile-tab @(section == "Leaderboard" ? "active" : "")"
           asp-controller="Leaderboard" asp-action="Index">
            <i class="bi bi-trophy-fill"></i>
            <span>BXH Sao</span>
        </a>
    </nav>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/arena.js" asp-append-version="true"></script>
    <script src="~/js/share-card.js" asp-append-version="true"></script>
    <script src="~/js/fc27-playstyles.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
