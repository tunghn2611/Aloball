@model AloBall.Web.Models.TeamFinanceReportViewModel
@{
    ViewData["Title"] = $"Báo cáo tài chính & Quỹ đội - {Model.TeamName}";
}

@await Html.PartialAsync("_TeamNavigation", Model.TeamId)

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <span class="eyebrow"><i class="bi bi-wallet2 me-1"></i>QUẢN LÝ QUỸ &amp; THU CHI CLB</span>
            <h2 class="h3 fw-bold mb-1 text-dark">Báo Cáo Tài Chính &amp; Thu Tiền Trận</h2>
            <p class="text-muted small mb-0">Theo dõi ngân sách, số tiền các trận đấu, tình trạng đóng quỹ của từng cầu thủ và xuất dữ liệu báo cáo.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Bộ lọc tháng -->
            <form method="get" class="d-flex align-items-center gap-2">
                <input type="hidden" name="teamId" value="@Model.TeamId" />
                <select name="month" class="form-select form-select-sm" style="min-width: 160px;" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.MonthFilter))">Tất cả các tháng</option>
                    @foreach (var m in Model.AvailableMonths)
                    {
                        <option value="@m" selected="@(Model.MonthFilter == m)">Tháng @m[5..]/@m[..4]</option>
                    }
                </select>
            </form>

            @if (Model.IsManager)
            {
                <a asp-action="ExportCsv" asp-route-teamId="@Model.TeamId" asp-route-month="@Model.MonthFilter" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
                </a>
            }
        </div>
    </div>

    <!-- 4 THẺ CHỈ SỐ TÀI CHÍNH TỔNG QUAN -->
    <div class="row g-3 mb-4">
        <!-- 1. Tổng chi phí các trận -->
        <div class="col-6 col-lg-3">
            <div class="arena-card p-3 h-100 border-start border-4 border-dark">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">
                    <i class="bi bi-receipt text-dark me-1"></i>Tổng chi phí trận
                </span>
                <div class="d-flex align-items-baseline gap-1">
                    <span class="fs-3 fw-bold text-dark">@Model.TotalMatchExpenses.ToString("N0")</span>
                    <small class="text-muted">đ</small>
                </div>
                <small class="text-muted d-block mt-1">@Model.TotalSettledMatches trận đã quyết toán</small>
            </div>
        </div>

        <!-- 2. Tổng tiền cần thu từ cầu thủ -->
        <div class="col-6 col-lg-3">
            <div class="arena-card p-3 h-100 border-start border-4 border-primary">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">
                    <i class="bi bi-cash-stack text-primary me-1"></i>Tổng tiền phân bổ
                </span>
                <div class="d-flex align-items-baseline gap-1">
                    <span class="fs-3 fw-bold text-primary">@Model.TotalMemberContributionsDue.ToString("N0")</span>
                    <small class="text-muted">đ</small>
                </div>
                <small class="text-muted d-block mt-1">Số tiền thành viên cần đóng</small>
            </div>
        </div>

        <!-- 3. Đã thu thực tế -->
        <div class="col-6 col-lg-3">
            <div class="arena-card p-3 h-100 border-start border-4 border-success">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">
                    <i class="bi bi-check-circle-fill text-success me-1"></i>Đã thu thực tế
                </span>
                <div class="d-flex align-items-baseline gap-1">
                    <span class="fs-3 fw-bold text-success">@Model.TotalCollected.ToString("N0")</span>
                    <small class="text-muted">đ</small>
                </div>
                <small class="text-muted d-block mt-1">Đã vào quỹ đội</small>
            </div>
        </div>

        <!-- 4. Còn tồn đọng chưa thu -->
        <div class="col-6 col-lg-3">
            <div class="arena-card p-3 h-100 border-start border-4 border-danger">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>Còn thiếu / Tồn đọng
                </span>
                <div class="d-flex align-items-baseline gap-1">
                    <span class="fs-3 fw-bold text-danger">@Model.TotalOutstanding.ToString("N0")</span>
                    <small class="text-muted">đ</small>
                </div>
                <div class="d-flex align-items-center justify-content-between mt-1">
                    <small class="text-muted">Tỉ lệ thu:</small>
                    <span class="badge @(Model.CollectionRatePercentage >= 80 ? "bg-success" : (Model.CollectionRatePercentage >= 50 ? "bg-warning text-dark" : "bg-danger"))">
                        @Model.CollectionRatePercentage.ToString("0.0")%
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- TỔNG KẾT THEO THÁNG (CSS/SVG LIGHTWEIGHT BARS) -->
    @if (Model.MonthlySummaries.Any())
    {
        <div class="arena-card p-4 mb-4">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-calendar2-range-fill text-primary me-2"></i>Biểu Đồ &amp; Xu Hướng Thu Chi Theo Tháng
            </h5>

            <div class="row g-3">
                @foreach (var m in Model.MonthlySummaries)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="p-3 border rounded bg-white h-100 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-dark">@m.MonthDisplay</span>
                                <span class="badge bg-light text-muted border">@m.MatchesCount trận</span>
                            </div>

                            <div class="small d-flex justify-content-between mb-1">
                                <span class="text-muted">Tổng chi phí:</span>
                                <strong class="text-dark">@m.TotalExpenses.ToString("N0") đ</strong>
                            </div>

                            <div class="small d-flex justify-content-between mb-1">
                                <span class="text-muted">Đã thu:</span>
                                <strong class="text-success">@m.TotalCollected.ToString("N0") đ</strong>
                            </div>

                            <div class="small d-flex justify-content-between mb-2">
                                <span class="text-muted">Còn thiếu:</span>
                                <strong class="text-danger">@m.TotalOutstanding.ToString("N0") đ</strong>
                            </div>

                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @m.CollectionRate%;" aria-valuenow="@m.CollectionRate" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1" style="font-size: 10px;">
                                <span class="text-muted">Tiến độ thu</span>
                                <span class="fw-bold text-success">@m.CollectionRate.ToString("0.0")%</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- TAB TÙY CHỌN: THEO TỪNG TRẬN ĐẤU & THEO CẦU THỦ -->
    <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="pills-matches-tab" data-bs-toggle="pill" data-bs-target="#pills-matches" type="button" role="tab" aria-controls="pills-matches" aria-selected="true">
                <i class="bi bi-clock-history me-1"></i> Lịch Sử Quyết Toán Trận (@Model.MatchHistory.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="pills-members-tab" data-bs-toggle="pill" data-bs-target="#pills-members" type="button" role="tab" aria-controls="pills-members" aria-selected="false">
                <i class="bi bi-person-lines-fill me-1"></i> Tình Hình Nộp Quỹ Từng Cầu Thủ (@Model.MemberRecords.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        <!-- 1. LỊCH SỬ QUYẾT TOÁN CÁC TRẬN ĐẤU -->
        <div class="tab-pane fade show active" id="pills-matches" role="tabpanel" aria-labelledby="pills-matches-tab">
            <div class="arena-card p-3">
                @if (!Model.MatchHistory.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-receipt fs-1 d-block mb-2 text-muted"></i>
                        <span>Chưa có trận đấu nào được quyết toán trong kỳ báo cáo này.</span>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="small text-muted text-uppercase">
                                    <th class="ps-3">Ngày đấu</th>
                                    <th>Đối thủ</th>
                                    <th>Sân bóng</th>
                                    <th class="text-end">Tổng chi</th>
                                    <th class="text-center">Số người</th>
                                    <th class="text-end">Mỗi người</th>
                                    <th class="text-end">Đã thu</th>
                                    <th class="text-end">Còn thiếu</th>
                                    <th class="text-end pe-3">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.MatchHistory)
                                {
                                    <tr>
                                        <td class="ps-3 text-muted small">
                                            @m.MatchDateTime.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            <strong class="text-dark">@m.OpponentName</strong>
                                        </td>
                                        <td class="small text-muted">
                                            <i class="bi bi-geo-alt me-1 text-danger"></i>@m.PitchName
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            @m.TotalAmount.ToString("N0") đ
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">@m.ParticipantCount</span>
                                        </td>
                                        <td class="text-end text-muted small">
                                            @m.PerPersonShare.ToString("N0") đ
                                        </td>
                                        <td class="text-end fw-bold text-success">
                                            @m.TotalPaid.ToString("N0") đ
                                        </td>
                                        <td class="text-end fw-bold @(m.RemainingBalance > 0 ? "text-danger" : "text-muted")">
                                            @(m.RemainingBalance > 0 ? m.RemainingBalance.ToString("N0") + " đ" : "0 đ")
                                        </td>
                                        <td class="text-end pe-3">
                                            <a asp-action="SettlementDetail" asp-route-matchId="@m.MatchId" asp-route-teamId="@Model.TeamId" class="btn btn-outline-secondary btn-sm py-1 px-2" style="font-size: 11px;">
                                                Chi tiết thu chi →
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- 2. TÌNH HÌNH NỘP QUỸ TỪNG CẦU THỦ -->
        <div class="tab-pane fade" id="pills-members" role="tabpanel" aria-labelledby="pills-members-tab">
            <div class="arena-card p-3">
                @if (!Model.MemberRecords.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-people fs-1 d-block mb-2 text-muted"></i>
                        <span>Chưa có dữ liệu thành viên trong kỳ báo cáo này.</span>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="small text-muted text-uppercase">
                                    <th class="ps-3">Cầu thủ</th>
                                    <th>Vị trí</th>
                                    <th class="text-center">Số trận tham gia</th>
                                    <th class="text-end">Tổng tiền phải nộp</th>
                                    <th class="text-end">Đã đóng</th>
                                    <th class="text-end">Còn thiếu</th>
                                    <th class="text-center">Trận nợ</th>
                                    <th class="text-center pe-3">Tình trạng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mem in Model.MemberRecords)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <span class="badge bg-secondary-subtle text-secondary border me-1">
                                                @(mem.KitNumber.HasValue ? $"#{mem.KitNumber}" : "—")
                                            </span>
                                            <strong class="text-dark">@mem.FullName</strong>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@(mem.Position ?? "Cầu thủ")</span>
                                        </td>
                                        <td class="text-center fw-bold">
                                            @mem.MatchesParticipated trận
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            @mem.TotalAmountDue.ToString("N0") đ
                                        </td>
                                        <td class="text-end fw-bold text-success">
                                            @mem.TotalAmountPaid.ToString("N0") đ
                                        </td>
                                        <td class="text-end fw-bold @(mem.OutstandingBalance > 0 ? "text-danger" : "text-muted")">
                                            @(mem.OutstandingBalance > 0 ? mem.OutstandingBalance.ToString("N0") + " đ" : "0 đ")
                                        </td>
                                        <td class="text-center">
                                            @if (mem.UnpaidCount + mem.PartialCount > 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                    @(mem.UnpaidCount + mem.PartialCount) trận chưa xong
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    ✓ Đủ
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center pe-3">
                                            @if (mem.OutstandingBalance == 0)
                                            {
                                                <span class="badge bg-success text-white">Hoàn tất</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger text-white">Còn nợ quỹ</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
