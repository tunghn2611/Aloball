@model AloBall.Web.Controllers.LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-layout">
    <section class="auth-story">
        <div>
            <a href="/" class="auth-back-link"><i class="bi bi-arrow-left"></i> Về trang giới thiệu AloBall</a>
            <div class="mt-2"><span class="eyebrow">⚡ WELCOME TO THE CLUB</span></div>
            <h1>Đồng đội<br />đang <em>chờ bạn.</em></h1>
            <p>Quản lý điểm danh Zalo, chia tiền sân VietQR minh bạch và nhận thẻ cầu thủ FIFA sau mỗi trận cầu.</p>
        </div>
        <div class="d-flex flex-wrap gap-3 small text-light opacity-75">
            <span>✓ Miễn phí cho CLB</span>
            <span>✓ 37 PlayStyles chuẩn FIFA</span>
        </div>
        <span class="auth-mark" aria-hidden="true">AB.</span>
    </section>
    <section class="auth-form">
        <span class="eyebrow text-success">KHÔNG GIAN ĐỘI BÓNG</span>
        <h2>Đăng nhập tài khoản</h2>
        <p>Một tài khoản duy nhất để kết nối mọi đội bóng phủi của bạn.</p>
        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Địa chỉ Email</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ban@example.com" autocomplete="username" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <div class="pw-field">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" required />
                    <button type="button" class="pw-toggle" aria-label="Hiện hoặc ẩn mật khẩu" onclick="const i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';this.firstElementChild.className=i.type==='password'?'bi bi-eye':'bi bi-eye-slash'"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small fw-semibold">Duy trì đăng nhập trên thiết bị này</label>
            </div>
            <button type="submit" class="btn btn-arena-primary">Vào sân cùng AloBall <i class="bi bi-arrow-right"></i></button>
        </form>
        <div class="auth-switch">Mới đến với AloBall? <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Tạo tài khoản miễn phí</a></div>
        @if(HostEnvironment.EnvironmentName == "Development") {
        <details class="demo-accounts"><summary>Tài khoản dùng thử trong môi trường phát triển</summary><p>Lãnh đội: <code>owner@klbfc.vn</code> · Mật khẩu: <code>Owner@123456</code></p><p>Thành viên: <code>member@klbfc.vn</code> · Mật khẩu: <code>Member@123456</code></p></details>
        }
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
