@model AloBall.Web.Controllers.HomeViewModel
@using AloBall.Web.Data.Entities
@{ ViewData["Title"] = "Khám phá sân chơi"; }
<div class="discovery-kicker"><strong>CỘNG ĐỒNG BÓNG ĐÁ PHONG TRÀO</strong><span>CHƠI HẾT MÌNH. KẾT NỐI HẾT LÒNG.</span></div>
<section class="discovery-hero">
    <div class="hero-copy"><span class="hero-label">YOUR TEAM. YOUR GAME.</span><h1>Hẹn nhau<br />trên <em>sân bóng.</em></h1><p>Tập hợp đồng đội, tìm một đối thủ mới và lưu lại những trận cầu đáng nhớ. Tất cả bắt đầu từ đây.</p><div class="hero-links"><a asp-controller="Matchmaking" asp-action="Index" class="btn btn-arena-primary">Tìm đối giao lưu <i class="bi bi-arrow-up-right"></i></a><a asp-controller="Teams" asp-action="Index" class="text-link">Vào đội của tôi <i class="bi bi-arrow-right"></i></a></div></div>
    <div class="pitch-poster" role="img" aria-label="Minh họa sân bóng và những vị trí cầu thủ, cùng nhau ra sân mỗi tuần">
        <div class="poster-grain"></div><span class="poster-label">THE BEAUTIFUL GAME / 001</span><span class="poster-number">90</span>
        <div class="pitch-drawing"><div class="pitch-box top"></div><div class="pitch-box bottom"></div><span class="pitch-token one">10</span><span class="pitch-token two">07</span><span class="pitch-token three">09</span><span class="pitch-token four">01</span></div>
        <span class="poster-stamp">MADE FOR YOUR TEAM</span><div class="poster-caption"><strong>CHUNG MỘT SÂN.<br />CHUNG ĐAM MÊ.</strong><span>ALOBALL FOOTBALL CLUBHOUSE</span></div>
    </div>
</section>
<form asp-controller="Matchmaking" asp-action="Index" method="get" class="discovery-search" id="tim-doi"><div class="search-field"><label for="discoveryArea">01 / KHU VỰC THI ĐẤU</label><input id="discoveryArea" name="area" placeholder="Bạn muốn đá ở đâu?" /></div><div class="search-field"><label for="discoveryDate">02 / NGÀY RA SÂN</label><input type="date" id="discoveryDate" name="date" aria-label="Ngày ra sân" /></div><button class="btn btn-arena-primary">Tìm trận phù hợp <i class="bi bi-search"></i></button></form>
<section id="lich-dau-ket-qua">
    <div class="section-heading"><h2><span class="section-no">01</span>Nhịp sân bóng</h2><span class="eyebrow">LỊCH ĐẤU & KẾT QUẢ</span></div>
    <ul class="nav nav-pills mb-3" role="tablist"><li role="presentation"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#new-upcoming" type="button" role="tab" aria-controls="new-upcoming" aria-selected="true">Sắp diễn ra <span class="ms-2">@Model.UpcomingMatches.Count</span></button></li><li role="presentation"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#new-results" type="button" role="tab" aria-controls="new-results" aria-selected="false">Kết quả gần đây <span class="ms-2">@Model.RecentCompletedMatches.Count</span></button></li></ul>
    <div class="tab-content">
    @foreach (var completed in new[]{ false, true }) {
        var matches = completed ? Model.RecentCompletedMatches : Model.UpcomingMatches;
        <div id="@(completed ? "new-results" : "new-upcoming")" class="tab-pane fade @(!completed ? "show active" : "")" role="tabpanel">
        @if(matches.Any()) { <div class="match-strip">
        @foreach(var match in matches) {
            <a class="fixture-ticket" asp-controller="Matches" asp-action="Detail" asp-route-id="@match.Id"><div class="fixture-ticket-top"><span>@(match.Category == MatchCategory.Internal ? "NỘI BỘ" : match.Category == MatchCategory.Tournament ? "ĐÁ GIẢI" : "GIAO HỮU")</span><span>@match.MatchDateTime.ToString("dd.MM.yyyy") · @match.MatchDateTime.ToString("HH:mm")</span></div><div class="fixture-opponents"><strong>@(match.Category == MatchCategory.Internal ? match.TeamA.Name + " · A" : match.TeamA.Name)</strong><span>@(completed ? $"{match.ScoreA} : {match.ScoreB}" : "VS")</span><strong>@(match.Category == MatchCategory.Internal ? match.TeamA.Name + " · B" : match.TeamB?.Name ?? match.TeamBExternalName ?? "Chờ đối thủ")</strong></div><div class="fixture-venue"><span><i class="bi bi-geo-alt"></i> @match.PitchName</span><i class="bi bi-arrow-up-right"></i></div></a>
        }</div> } else { <div class="empty-state"><i class="bi bi-calendar2-week"></i><h3>@(completed ? "Chưa có kết quả mới" : "Trận tiếp theo đang chờ bạn")</h3><p class="mb-0">Kết nối một đội bạn và cùng tạo nên trận cầu tiếp theo.</p></div> }
        </div>
    }
    </div>
</section>
<div class="discovery-columns">
    <section id="kham-pha-doi"><div class="section-heading"><h2><span class="section-no">02</span>Gặp gỡ đội bạn</h2><span class="eyebrow">HỒ SƠ CÔNG KHAI</span></div>
        @if(!Model.PublicTeams.Any()) { <div class="empty-state"><i class="bi bi-shield"></i><h3>Trở thành đội đầu tiên</h3><a asp-controller="Teams" asp-action="Create" class="text-link">Tạo hồ sơ đội →</a></div> }
        else { <div class="club-directory">@foreach(var team in Model.PublicTeams) { <a class="directory-row" href="/doi/@team.Slug"><div class="club-logo">@if(!string.IsNullOrWhiteSpace(team.LogoUrl)) { <img src="@team.LogoUrl" alt="" loading="lazy" /> } else { @team.Name[..Math.Min(2,team.Name.Length)] }</div><div><h3>@team.Name</h3><p>@(team.ActivityArea ?? "Chưa cập nhật khu vực") · @team.Players.Count cầu thủ</p></div><span class="directory-rating"><i class="bi bi-star-fill"></i> @team.AverageRating.ToString("0.0")</span><i class="bi bi-arrow-up-right"></i></a> }</div> }
    </section>
    <section><div class="section-heading"><h2><span class="section-no">03</span>Đang tìm đối</h2><a asp-controller="Matchmaking" asp-action="Index">Xem tất cả <i class="bi bi-arrow-up-right"></i></a></div>
        @if(!Model.RecentPosts.Any()) { <div class="empty-state"><i class="bi bi-intersect"></i><h3>Mở lời giao lưu</h3><p class="mb-0">Đăng khung giờ của đội để tìm đối thủ phù hợp.</p></div> }
        @foreach(var post in Model.RecentPosts.Take(4)) { <a class="open-invitation" asp-controller="Matchmaking" asp-action="Details" asp-route-id="@post.Id"><div><span class="eyebrow">@post.MatchDate.ToString("dd.MM") · @post.StartTime.ToString(@"hh\:mm")</span><span>@(post.PitchArrangement == PitchArrangement.HomePitch ? "Sân nhà" : post.PitchArrangement == PitchArrangement.AwayPitch ? "Đi khách" : "Linh hoạt")</span></div><h3>@post.Team.Name <i class="bi bi-arrow-up-right float-end"></i></h3><div><span><i class="bi bi-geo-alt"></i> @post.Area</span><span>@post.PitchType · @post.DesiredLevel</span></div></a> }
    </section>
</div>
<section class="editorial-banner"><div><span class="eyebrow">GIỮ NHỊP ĐAM MÊ</span><h2 class="mt-2">Đội bóng của bạn xứng đáng có một ngôi nhà.</h2><p>Hồ sơ, áo đấu, lịch ra sân và điểm AB — cùng một không gian.</p></div><a asp-controller="Teams" asp-action="Create" class="btn btn-arena-primary">Bắt đầu với đội của bạn <i class="bi bi-arrow-up-right"></i></a></section>
