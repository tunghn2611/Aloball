@model IEnumerable<AloBall.Web.Data.Entities.Player>
@{
    var team = ViewBag.Team as AloBall.Web.Data.Entities.Team;
    ViewData["Title"] = $"Danh sách Thành viên - {team?.Name}";
    bool isManager = ViewBag.IsManager ?? false;
}

@await Html.PartialAsync("_TeamNavigation", team!.Id)
@if (!isManager) { <div class="read-only-note">Bạn có thể xem hồ sơ cầu thủ. Lãnh đội phụ trách cập nhật thông tin.</div> }

<div class="page-heading">
    <div><span class="eyebrow">ĐỘI HÌNH · @team?.Name</span><h1>Những người cùng màu áo.</h1><p>@Model.Count() cầu thủ · Hồ sơ, số áo và thông tin đặt áo của đội.</p></div>
    @if (isManager)
    {
        <div class="d-flex gap-2">
            <button class="btn btn-arena-outline btn-sm" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                <i class="bi bi-file-earmark-arrow-up me-1"></i> Nhập từ Excel
            </button>
            <a asp-controller="Sheets" asp-action="ExportPlayers" asp-route-teamId="@team?.Id" class="btn btn-arena-outline btn-sm">
                <i class="bi bi-file-earmark-arrow-down me-1"></i> Xuất Excel
            </a>
            <a asp-action="PlayerEditor" asp-route-teamId="@team?.Id" class="btn btn-arena-primary btn-sm shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Thêm cầu thủ
            </a>
        </div>
    }
    else
    {
        <div>
            <a asp-action="Messages" asp-route-teamId="@team?.Id" class="btn btn-arena-primary btn-sm shadow-sm">
                <i class="bi bi-chat-left-text-fill me-1"></i> Liên hệ Đội trưởng
            </a>
        </div>
    }
</div>


<!-- Thanh tìm kiếm, lọc nhanh & Chế độ xem Windows Explorer -->
<div class="arena-card p-2 mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="memberSearch" class="form-control border-start-0" placeholder="Tìm kiếm theo tên, số áo, vị trí..." onkeyup="filterMembers()" />
            </div>
        </div>
        <div class="col-6 col-md-2">
            <select id="statusFilter" class="form-select" onchange="filterMembers()">
                <option value="all" selected>Tất cả (@Model.Count())</option>
                <option value="active">Đang đá</option>
                <option value="inactive">Nghỉ / Tạm dừng</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select id="positionFilter" class="form-select" onchange="filterMembers()">
                <option value="all">Tất cả vị trí</option>
                <option value="tiền đạo">Tiền đạo</option>
                <option value="tiền vệ">Tiền vệ</option>
                <option value="hậu vệ">Hậu vệ</option>
                <option value="thủ môn">Thủ môn</option>
            </select>
        </div>
        <!-- Bộ chọn 7 Chế độ xem phong cách Windows File Explorer -->
        <div class="col-12 col-md-4">
            <div class="dropdown">
                <button class="btn btn-arena-outline w-100 dropdown-toggle d-flex align-items-center justify-content-between text-truncate" type="button" id="rosterViewModeBtn" data-bs-toggle="dropdown" aria-expanded="false">
                    <span id="activeViewModeLabel" class="text-truncate"><i class="bi bi-table text-primary me-1"></i> Chi tiết</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2" aria-labelledby="rosterViewModeBtn">
                    <li><h6 class="dropdown-header text-uppercase text-muted" style="font-size: 10px; letter-spacing: 1px;">Chế độ xem</h6></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 view-mode-item active bg-light" type="button" data-mode="details" onclick="setRosterViewMode('details')"><i class="bi bi-table text-primary"></i> <span>Chi tiết (Details) <small class="text-muted">(Mặc định)</small></span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 view-mode-item" type="button" data-mode="content" onclick="setRosterViewMode('content')"><i class="bi bi-card-text text-primary"></i> <span>Nội dung (Content)</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 view-mode-item" type="button" data-mode="list" onclick="setRosterViewMode('list')"><i class="bi bi-list-ul text-primary"></i> <span>Danh sách (List)</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 view-mode-item" type="button" data-mode="tiles" onclick="setRosterViewMode('tiles')"><i class="bi bi-grid-fill text-primary"></i> <span>Ô gạch (Tiles)</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 view-mode-item" type="button" data-mode="large-icons" onclick="setRosterViewMode('large-icons')"><i class="bi bi-grid text-primary"></i> <span>Biểu tượng lớn (Large icons)</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 view-mode-item" type="button" data-mode="medium-icons" onclick="setRosterViewMode('medium-icons')"><i class="bi bi-grid-3x2-gap text-primary"></i> <span>Biểu tượng vừa (Medium icons)</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 view-mode-item" type="button" data-mode="small-icons" onclick="setRosterViewMode('small-icons')"><i class="bi bi-grid-3x3 text-primary"></i> <span>Biểu tượng nhỏ (Small icons)</span></button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Container 7 Chế độ xem Roster -->
<div id="rosterViewContainer" class="roster-view-container mode-details">
    <!-- View Mode: Details (Bảng chi tiết Table) -->
    <div class="roster-details-table arena-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="small text-muted text-uppercase">
                        <th class="ps-3" style="width: 70px;">Số áo</th>
                        <th>Cầu thủ</th>
                        <th>Vị trí</th>
                        <th>Tên in áo</th>
                        <th>Size Áo / Quần</th>
                        <th>Thể hình</th>
                        <th>Trạng thái</th>
                        @if (isManager) { <th><span class="visually-hidden">Thao tác</span></th> }
                    </tr>
                </thead>
                <tbody id="memberTableBody">
                    @foreach (var p in Model)
                    {
                        <tr class="roster-filterable member-row" data-name="@p.FullName.ToLower()" data-number="@(p.KitNumber?.ToString() ?? "")" data-pos="@(p.Position?.ToLower() ?? "")" data-active="@(p.IsActive ? "active" : "inactive")">
                            <td class="ps-3">
                                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 fw-bold fs-6">
                                    @(p.KitNumber?.ToString() ?? "-")
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@p.FullName</div>
                                @if (!string.IsNullOrEmpty(p.LinkedUserId))
                                {
                                    <small class="text-success"><i class="bi bi-check-circle-fill"></i> Đã liên kết tài khoản</small>
                                }
                            </td>
                            <td><span class="text-muted">@(p.Position ?? "Chưa đặt")</span></td>
                            <td><code class="text-dark fw-bold">@(p.ShirtName ?? "-")</code></td>
                            <td>
                                <span class="badge bg-light text-dark border">Áo: @(p.ShirtSize ?? "-")</span>
                                <span class="badge bg-light text-dark border">Quần: @(p.ShortSize ?? "-")</span>
                            </td>
                            <td class="small text-muted">
                                @(p.HeightCm.HasValue ? $"{p.HeightCm}cm" : "-") / @(p.WeightKg.HasValue ? $"{p.WeightKg}kg" : "-")
                            </td>
                            <td>
                                <span class="badge @(p.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") border px-2 py-1">
                                    @(p.IsActive ? "Đang hoạt động" : "Nghỉ đá")
                                </span>
                            </td>
                            @if(isManager) {
                                <td>
                                    <div class="d-flex gap-1">
                                        @if (!string.IsNullOrEmpty(p.LinkedUserId))
                                        {
                                            <a asp-action="Messages" asp-route-teamId="@team?.Id" asp-route-contactUserId="@p.LinkedUserId" class="btn btn-arena-outline btn-sm" title="Nhắn tin cho cầu thủ"><i class="bi bi-chat-dots"></i></a>
                                        }
                                        <a asp-action="PlayerEditor" asp-route-teamId="@team?.Id" asp-route-id="@p.Id" class="btn btn-arena-outline btn-sm">Sửa</a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- View Modes: Content, List, Tiles, Large icons, Medium icons, Small icons -->
    <div class="roster-grid" id="rosterGridContainer">
        @foreach (var p in Model)
        {
            <div class="roster-filterable roster-item-card" data-name="@p.FullName.ToLower()" data-number="@(p.KitNumber?.ToString() ?? "")" data-pos="@(p.Position?.ToLower() ?? "")" data-active="@(p.IsActive ? "active" : "inactive")">
                <!-- Avatar & Kit Number Badge -->
                <div class="card-avatar-wrap bg-light border d-flex align-items-center justify-content-center text-primary position-relative flex-shrink-0">
                    @if (p.KitNumber.HasValue)
                    {
                        <strong class="fw-bold">@p.KitNumber</strong>
                    }
                    else
                    {
                        <i class="bi bi-person-fill"></i>
                    }
                </div>

                <!-- Main Info -->
                <div class="roster-card-body flex-grow-1 min-w-0">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                        <h6 class="fw-bold mb-0 text-dark text-truncate" title="@p.FullName">@p.FullName</h6>
                        <span class="badge @(p.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") border px-2 py-1 card-status-badge">
                            @(p.IsActive ? "Đang đá" : "Nghỉ")
                        </span>
                    </div>

                    <div class="card-pos-badge mb-1">
                        <small class="text-muted"><i class="bi bi-shield-fill me-1 text-success"></i>@(p.Position ?? "Cầu thủ")</small>
                        @if (!string.IsNullOrEmpty(p.LinkedUserId))
                        {
                            <span class="badge bg-success-subtle text-success border ms-1" style="font-size: 9px;" title="Đã liên kết tài khoản"><i class="bi bi-check"></i> Liên kết</span>
                        }
                    </div>

                    <!-- Shirt details (for Content and Tiles mode) -->
                    <div class="card-shirt-spec small text-muted mb-1" style="font-size: 11px;">
                        <span>In áo: <strong class="text-dark">@(p.ShirtName ?? "-")</strong></span>
                        @if (!string.IsNullOrEmpty(p.ShirtSize) || !string.IsNullOrEmpty(p.ShortSize))
                        {
                            <span class="ms-1">· Size: @(p.ShirtSize ?? "-")/@(p.ShortSize ?? "-")</span>
                        }
                    </div>

                    <!-- Physical details (for Content mode) -->
                    @if (p.HeightCm.HasValue || p.WeightKg.HasValue)
                    {
                        <div class="card-body-specs small text-muted" style="font-size: 11px;">
                            <span>Thể hình: @(p.HeightCm.HasValue ? $"{p.HeightCm}cm" : "-") / @(p.WeightKg.HasValue ? $"{p.WeightKg}kg" : "-")</span>
                        </div>
                    }
                </div>

                <!-- Action Button for Managers -->
                @if (isManager)
                {
                    <div class="card-action-btn mt-2 mt-sm-0 flex-shrink-0 d-flex gap-1">
                        @if (!string.IsNullOrEmpty(p.LinkedUserId))
                        {
                            <a asp-action="Messages" asp-route-teamId="@team?.Id" asp-route-contactUserId="@p.LinkedUserId" class="btn btn-arena-outline btn-sm py-1 px-2" style="font-size: 11px;" title="Nhắn tin cho cầu thủ">
                                <i class="bi bi-chat-dots"></i>
                            </a>
                        }
                        <a asp-action="PlayerEditor" asp-route-teamId="@team?.Id" asp-route-id="@p.Id" class="btn btn-arena-outline btn-sm py-1 px-2" style="font-size: 11px;">
                            <i class="bi bi-pencil-square me-1"></i>Sửa
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal Thêm Cầu Thủ -->
@if (isManager)
{
    <div class="modal fade" id="addPlayerModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Thêm Cầu Thủ Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="AddPlayer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="teamId" value="@team?.Id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" name="fullName" class="form-control" placeholder="Nguyễn Văn A" required />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <label class="form-label fw-semibold">Số áo</label>
                                <input type="number" name="kitNumber" class="form-control" placeholder="10" />
                            </div>
                            <div class="col-8">
                                <label class="form-label fw-semibold">Vị trí</label>
                                <input type="text" name="position" class="form-control" placeholder="Tiền đạo, Tiền vệ..." />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tên in trên áo</label>
                            <input type="text" name="shirtName" class="form-control" placeholder="VAN A" />
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Size Áo</label>
                                <select name="shirtSize" class="form-select">
                                    <option value="">Chọn size</option>
                                    <option value="S">S</option>
                                    <option value="M">M</option>
                                    <option value="L">L</option>
                                    <option value="XL">XL</option>
                                    <option value="XXL">XXL</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Size Quần</label>
                                <select name="shortSize" class="form-select">
                                    <option value="">Chọn size</option>
                                    <option value="S">S</option>
                                    <option value="M">M</option>
                                    <option value="L">L</option>
                                    <option value="XL">XL</option>
                                    <option value="XXL">XXL</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-arena-outline" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-arena-primary">Lưu Cầu Thủ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Nhập Excel -->
    <div class="modal fade" id="importExcelModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Nhập Danh Sách Cầu Thủ Từ Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Sheets" asp-action="PreviewImport" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="teamId" value="@team?.Id" />
                    <div class="modal-body">
                        <p class="small text-muted mb-3">
                            Tải file Excel mẫu được xuất từ hệ thống để chỉnh sửa Tên in áo, Size áo/quần. Hệ thống sẽ mở bảng <strong>Xem trước (Preview)</strong> các thay đổi trước khi ghi dữ liệu.
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn file Excel (.xlsx)</label>
                            <input type="file" name="excelFile" class="form-control" accept=".xlsx" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-arena-outline" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-arena-primary">Tải lên & Xem trước</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    function removeVietnameseTones(str) {
        if (!str) return '';
        str = str.toLowerCase();
        str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
        str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
        str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
        str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
        str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
        str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
        str = str.replace(/đ/g, "d");
        return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }

    function filterMembers() {
        const searchInput = document.getElementById('memberSearch');
        const statusSelect = document.getElementById('statusFilter');
        const posSelect = document.getElementById('positionFilter');

        const rawQuery = searchInput ? searchInput.value.trim() : '';
        const query = removeVietnameseTones(rawQuery);
        const statusFilter = statusSelect ? statusSelect.value : 'all';
        const posFilter = posSelect ? posSelect.value.toLowerCase() : 'all';

        document.querySelectorAll('.roster-filterable').forEach(item => {
            const rawName = item.getAttribute('data-name') || '';
            const name = removeVietnameseTones(rawName);
            const num = item.getAttribute('data-number') || '';
            const rawPos = item.getAttribute('data-pos') || '';
            const pos = removeVietnameseTones(rawPos);
            const active = item.getAttribute('data-active') || '';

            const matchQuery = !query || name.includes(query) || num.includes(query) || pos.includes(query);
            const matchStatus = (statusFilter === 'all') || (statusFilter === active);
            const matchPos = (posFilter === 'all') || rawPos.includes(posFilter) || pos.includes(removeVietnameseTones(posFilter));

            item.style.display = (matchQuery && matchStatus && matchPos) ? '' : 'none';
        });
    }

    function setRosterViewMode(mode, save = true) {
        const validModes = ['details', 'content', 'list', 'tiles', 'large-icons', 'medium-icons', 'small-icons'];
        if (!validModes.includes(mode)) mode = 'details';

        const container = document.getElementById('rosterViewContainer');
        if (container) {
            validModes.forEach(m => container.classList.remove('mode-' + m));
            container.classList.add('mode-' + mode);
        }

        const labels = {
            'details': '<i class="bi bi-table text-primary me-1"></i> Chi tiết',
            'content': '<i class="bi bi-card-text text-primary me-1"></i> Nội dung',
            'list': '<i class="bi bi-list-ul text-primary me-1"></i> Danh sách',
            'tiles': '<i class="bi bi-grid-fill text-primary me-1"></i> Ô gạch',
            'large-icons': '<i class="bi bi-grid text-primary me-1"></i> Biểu tượng lớn',
            'medium-icons': '<i class="bi bi-grid-3x2-gap text-primary me-1"></i> Biểu tượng vừa',
            'small-icons': '<i class="bi bi-grid-3x3 text-primary me-1"></i> Biểu tượng nhỏ'
        };

        const labelEl = document.getElementById('activeViewModeLabel');
        if (labelEl && labels[mode]) {
            labelEl.innerHTML = labels[mode];
        }

        document.querySelectorAll('.view-mode-item').forEach(btn => {
            if (btn.getAttribute('data-mode') === mode) {
                btn.classList.add('active', 'bg-light');
            } else {
                btn.classList.remove('active', 'bg-light');
            }
        });

        if (save) {
            try {
                localStorage.setItem('aloball_roster_view_mode', mode);
            } catch (e) { }
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        let saved = 'details';
        try {
            saved = localStorage.getItem('aloball_roster_view_mode') || 'details';
        } catch (e) { }
        setRosterViewMode(saved, false);
        filterMembers();
    });
</script>
}
