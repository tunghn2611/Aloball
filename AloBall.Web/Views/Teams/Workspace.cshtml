@model AloBall.Web.Data.Entities.Team
@using AloBall.Web.Data.Entities
@{
    ViewData["Title"] = Model.Name + " · Không gian đội";
    bool isManager = ViewBag.IsManager ?? false;
    var upcoming = ViewBag.UpcomingSessions as List<AttendanceSession> ?? new();
    var incoming = ViewBag.IncomingChallenges as List<MatchmakingPost> ?? new();
    var outgoing = ViewBag.OutgoingChallenges as List<MatchmakingPost> ?? new();
}
<header class="team-masthead"><div class="club-logo">@if(!string.IsNullOrEmpty(Model.LogoUrl)) { <img src="@Model.LogoUrl" alt="" /> } else { @Model.Name[..Math.Min(2,Model.Name.Length)] }</div><div><span class="heading-index">YOUR TEAM / YOUR HOME</span><h1>@Model.Name</h1><p>@(Model.ActivityArea ?? "Chưa cập nhật khu vực") <span class="mx-2">/</span> @(isManager ? "Không gian lãnh đội" : "Không gian thành viên")</p></div><div class="masthead-actions">@if(Model.IsPublic) { <a asp-action="PublicProfile" asp-route-slug="@Model.Slug" class="btn btn-arena-outline"><i class="bi bi-globe2"></i> Hồ sơ công khai</a> }@if(isManager) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-arena-primary">Sửa hồ sơ <i class="bi bi-pencil"></i></a> }</div></header>
@await Html.PartialAsync("_TeamNavigation", Model.Id)
@if(Model.IsRestrictedFromMatchmaking) { <div class="alert alert-warning"><strong>Tạm ngưng bắt đối.</strong> @Model.MatchmakingRestrictionReason Quản lý nội bộ và điểm AB vẫn hoạt động.</div> }
@if(!isManager) { <div class="read-only-note">Bạn đang xem thông tin nội bộ. Lãnh đội phụ trách cập nhật dữ liệu thi đấu.</div> }
<div class="metric-band"><div><span>QUÂN SỐ ĐANG HOẠT ĐỘNG</span><strong>@Model.Players.Count(p=>p.IsActive)<small> cầu thủ</small></strong></div><div><span>ĐÁNH GIÁ TỪ ĐỘI BẠN</span><strong>@Model.AverageRating.ToString("0.0")<small> / 5 ★</small></strong></div><div><span>LỜI MỜI ĐANG CHỜ</span><strong>@incoming.Count.ToString("00")<small> giao lưu</small></strong></div></div>
<div class="command-grid">
    <section class="next-fixture"><span class="eyebrow"><span class="status-dot"></span> NEXT UP / HẸN NHAU TRÊN SÂN</span>
        @if(upcoming.FirstOrDefault() is {} next) { <h2>@next.Title</h2><p><i class="bi bi-calendar3 me-2"></i>@next.SessionDateTime.ToString("dd.MM.yyyy · HH:mm")<br /><i class="bi bi-geo-alt me-2"></i>@(string.IsNullOrEmpty(next.PitchName) ? Model.HomePitch : next.PitchName)</p><a asp-controller="Attendance" asp-action="Detail" asp-route-id="@next.Id" class="btn btn-arena-primary">@(isManager ? "Mở bảng điểm danh" : "Xem buổi sinh hoạt") <i class="bi bi-arrow-right"></i></a> }
        else { <h2>Chọn một ngày.<br />Hẹn đủ đồng đội.</h2><p>Lịch ra sân tiếp theo của đội sẽ xuất hiện tại đây.</p><a asp-controller="Attendance" asp-action="Sessions" asp-route-teamId="@Model.Id" class="btn btn-arena-primary">@(isManager ? "Lên lịch sinh hoạt" : "Xem lịch sinh hoạt") <i class="bi bi-arrow-right"></i></a> }
    </section>
    <nav class="quick-actions" aria-label="Thao tác nhanh"><a class="quick-action" asp-action="Players" asp-route-teamId="@Model.Id"><i class="bi bi-person-vcard"></i><div><h3>Cầu thủ & áo đấu</h3><p>Mọi thông tin đồng đội, cùng một nơi.</p></div><i class="bi bi-arrow-up-right"></i></a><a class="quick-action" asp-controller="Matches" asp-action="Index" asp-route-teamId="@Model.Id"><i class="bi bi-trophy"></i><div><h3>Trận đấu & thành tích</h3><p>Ghi lại hành trình của đội.</p></div><i class="bi bi-arrow-up-right"></i></a><a class="quick-action" asp-controller="FireKeeping" asp-action="Index" asp-route-teamId="@Model.Id"><i class="bi bi-fire"></i><div><h3>Giữ Lửa cùng AB</h3><p>Bảng điểm, cúp tháng & penalty.</p></div><i class="bi bi-arrow-up-right"></i></a><a class="quick-action" asp-controller="Matchmaking" asp-action="Index"><i class="bi bi-intersect"></i><div><h3>Tìm một đối thủ mới</h3><p>Kết nối qua những trận cầu.</p></div><i class="bi bi-arrow-up-right"></i></a></nav>
</div>
<div class="command-grid"><section><div class="section-heading"><h2><span class="section-no">01</span>Lịch của đội</h2><a asp-controller="Attendance" asp-action="Sessions" asp-route-teamId="@Model.Id">Tất cả buổi đá ↗</a></div><div class="arena-card px-4">
@if(!upcoming.Any()) { <div class="empty-state"><i class="bi bi-calendar-week"></i><h3>Chưa có lịch mới</h3><p class="mb-0">Cùng lên kế hoạch cho buổi đá tiếp theo.</p></div> }
@foreach(var session in upcoming) { <div class="fixture-row"><div class="d-flex align-items-center gap-3"><div class="date-chip"><strong>@session.SessionDateTime.ToString("dd")</strong><small>THÁNG @session.SessionDateTime.ToString("MM")</small></div><div><strong>@session.Title</strong><div class="small text-muted">@session.SessionDateTime.ToString("HH:mm") · @session.PitchName</div></div></div><a asp-controller="Attendance" asp-action="Detail" asp-route-id="@session.Id" class="btn btn-arena-outline btn-sm" aria-label="Chi tiết @session.Title"><i class="bi bi-arrow-up-right"></i></a></div> }
</div></section><section><div class="section-heading"><h2><span class="section-no">02</span>Lời mời giao lưu</h2><span class="eyebrow">@incoming.Count ĐANG CHỜ</span></div><div class="arena-card px-4">
@if(!incoming.Any() && !outgoing.Any()) { <div class="empty-state"><i class="bi bi-envelope-open"></i><h3>Sẵn sàng cho kết nối mới</h3><p class="mb-0">Chia sẻ hồ sơ đội để nhận lời mời giao lưu.</p></div> }
@foreach(var invitation in incoming) { <div class="fixture-row"><div><strong>@invitation.Team.Name</strong><div class="small text-muted">@invitation.MatchDate.ToString("dd.MM") · @invitation.StartTime.ToString(@"hh\:mm")</div></div><a asp-controller="Matchmaking" asp-action="Details" asp-route-id="@invitation.Id" class="btn btn-arena-outline btn-sm">Xem lời mời</a></div> }
@foreach(var invitation in outgoing) { <div class="fixture-row"><div><span class="eyebrow">ĐÃ GỬI</span><div><strong>@invitation.TargetTeam?.Name</strong></div></div><a asp-controller="Matchmaking" asp-action="Details" asp-route-id="@invitation.Id" class="btn btn-arena-outline btn-sm">Theo dõi</a></div> }
</div></section></div>
