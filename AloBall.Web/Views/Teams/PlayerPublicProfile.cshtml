@model AloBall.Web.Models.PlayerPublicProfileViewModel
@{
    ViewData["Title"] = $"{Model.DisplayName} - Hồ sơ cầu thủ";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            @if (Model.CanShowTeam)
            {
                <li class="breadcrumb-item"><a href="/doi/@Model.TeamSlug">CLB @Model.TeamName</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.DisplayName</li>
        </ol>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.IsPublicProfile && (Model.IsSelf || Model.IsManager))
    {
        <div class="alert alert-warning mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2" role="alert">
            <div>
                <i class="bi bi-lock-fill me-2 fs-5"></i>
                <strong>Hồ sơ đang ở chế độ riêng tư:</strong> Chỉ bạn và ban huấn luyện mới có thể xem trang này. Người ngoài sẽ không truy cập được.
            </div>
            <button type="button" class="btn btn-warning btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#privacySettingsModal">
                <i class="bi bi-gear-fill me-1"></i> Đổi quyền riêng tư
            </button>
        </div>
    }

    <!-- 1. PASSPORT CẦU THỦ (PLAYER HERO CARD) -->
    <div class="arena-card p-4 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row gap-4 align-items-start align-items-md-center justify-content-between">
            <div class="d-flex gap-3 align-items-center">
                <!-- Avatar & Kit Number -->
                <div class="position-relative flex-shrink-0">
                    <div class="bg-light border rounded-circle d-flex align-items-center justify-content-center text-primary overflow-hidden shadow-sm" style="width: 90px; height: 90px;">
                        @if (Model.ShowPhoto && !string.IsNullOrEmpty(Model.PhotoUrl))
                        {
                            <img src="@Model.PhotoUrl" alt="@Model.DisplayName" class="w-100 h-100 object-fit-cover" />
                        }
                        else
                        {
                            <i class="bi bi-person-fill" style="font-size: 48px;"></i>
                        }
                    </div>
                    @if (Model.ShowKitNumber && Model.KitNumber.HasValue)
                    {
                        <span class="position-absolute bottom-0 end-0 badge bg-primary text-white border border-2 border-white rounded-pill px-2 py-1 shadow-sm" style="font-size: 13px;">
                            #@Model.KitNumber
                        </span>
                    }
                </div>

                <!-- Main Info -->
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <span class="badge bg-secondary-subtle text-secondary border">HỒ SƠ CẦU THỦ</span>
                        @if (Model.IsLinkedUser)
                        {
                            <span class="badge bg-success-subtle text-success border"><i class="bi bi-patch-check-fill me-1"></i>Đã liên kết tài khoản</span>
                        }
                    </div>
                    <h2 class="fw-bold mb-1 text-dark">@Model.DisplayName</h2>
                    <div class="d-flex align-items-center gap-2 flex-wrap text-muted small">
                        @if (Model.CanShowTeam)
                        {
                            <a href="/doi/@Model.TeamSlug" class="fw-semibold text-decoration-none text-primary">
                                <i class="bi bi-shield-shaded me-1"></i>@Model.TeamName
                            </a>
                            <span>•</span>
                        }
                        <span><i class="bi bi-geo-alt me-1"></i>@(Model.Region ?? "Chưa rõ khu vực")</span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons for Owner / Manager -->
            <div class="d-flex flex-wrap gap-2 align-self-stretch align-self-md-center">
                @if (Model.IsSelf || Model.IsManager)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#privacySettingsModal">
                        <i class="bi bi-shield-lock"></i> Quyền riêng tư
                    </button>
                }
                @if (Model.IsSelf)
                {
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-arena-primary btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-pencil-square"></i> Cập nhật hồ sơ
                    </a>
                }
                else if (Model.IsManager)
                {
                    <a asp-controller="Teams" asp-action="PlayerEditor" asp-route-teamId="@Model.TeamId" asp-route-id="@Model.PlayerId" class="btn btn-arena-outline btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-pencil-square"></i> Quản lý cầu thủ
                    </a>
                }
                @if (Model.CanShowTeam)
                {
                    <a href="/doi/@Model.TeamSlug" class="btn btn-light border btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-arrow-left"></i> Về CLB
                    </a>
                }
            </div>
        </div>

        <!-- Spec Chips -->
        <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
            <div class="badge bg-light text-dark border p-2 d-flex align-items-center gap-2">
                <i class="bi bi-person-badge text-primary"></i>
                <span>Vị trí: <strong>@(Model.ShowPosition ? (Model.Position ?? "Cầu thủ") : "Cầu thủ")</strong></span>
            </div>

            @if (Model.ShowPreferredFoot && !string.IsNullOrWhiteSpace(Model.PreferredFoot))
            {
                <div class="badge bg-light text-dark border p-2 d-flex align-items-center gap-2">
                    <i class="bi bi-lightning text-warning"></i>
                    <span>Chân thuận: <strong>@Model.PreferredFoot</strong></span>
                </div>
            }

            @if (Model.ShowExperience && !string.IsNullOrWhiteSpace(Model.Experience))
            {
                <div class="badge bg-light text-dark border p-2 d-flex align-items-center gap-2">
                    <i class="bi bi-award text-success"></i>
                    <span>Kinh nghiệm: <strong>@Model.Experience</strong></span>
                </div>
            }

            @if (Model.ShowHeightWeight && (Model.HeightCm.HasValue || Model.WeightKg.HasValue))
            {
                <div class="badge bg-light text-dark border p-2 d-flex align-items-center gap-2">
                    <i class="bi bi-rulers text-info"></i>
                    <span>Thể hình: <strong>@(Model.HeightCm.HasValue ? $"{Model.HeightCm}cm" : "") @(Model.WeightKg.HasValue ? $"/ {Model.WeightKg}kg" : "")</strong></span>
                </div>
            }
        </div>
    </div>

    <!-- 2. THỐNG KÊ HIỆU SUẤT CHÍNH THỨC (OFFICIAL STATS) -->
    <h5 class="arena-sports-heading text-dark mb-3">
        <i class="bi bi-bar-chart-fill text-success me-2"></i>Thống Kê Trận Đấu Chính Thức &amp; Chuyên Cần
    </h5>
    <div class="row g-3 mb-4">
        <!-- Số trận ra sân -->
        <div class="col-6 col-lg-3">
            <div class="arena-card p-3 h-100 border-start border-4 border-success">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">
                    <i class="bi bi-shield-shaded text-success me-1"></i>Số trận chính thức
                </span>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-2 fw-bold text-dark">@Model.OfficialAppearances</span>
                    <small class="text-muted">trận đối soát</small>
                </div>
                <small class="text-muted d-block mt-1">Đã xác nhận ra sân</small>
            </div>
        </div>

        <!-- Bàn thắng -->
        <div class="col-6 col-lg-3">
            <div class="arena-card p-3 h-100 border-start border-4 border-primary">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">
                    <i class="bi bi-bullseye text-primary me-1"></i>Bàn thắng chính thức
                </span>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-2 fw-bold text-primary">@Model.OfficialGoals</span>
                    <small class="text-muted">bàn thắng</small>
                </div>
                <small class="text-muted d-block mt-1">Không đếm trùng</small>
            </div>
        </div>

        <!-- Kiến tạo -->
        <div class="col-6 col-lg-3">
            <div class="arena-card p-3 h-100 border-start border-4 border-warning">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">
                    <i class="bi bi-send-fill text-warning me-1"></i>Kiến tạo chính thức
                </span>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-2 fw-bold text-warning">@Model.OfficialAssists</span>
                    <small class="text-muted">lần dọn cỗ</small>
                </div>
                <small class="text-muted d-block mt-1">Ghi nhận biên bản</small>
            </div>
        </div>

        <!-- Tỉ lệ chuyên cần -->
        <div class="col-6 col-lg-3">
            <div class="arena-card p-3 h-100 border-start border-4 border-info">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">
                    <i class="bi bi-calendar-check-fill text-info me-1"></i>Tỉ lệ chuyên cần
                </span>
                <div class="d-flex align-items-baseline gap-2">
                    @if (Model.HasAttendanceData)
                    {
                        <span class="fs-2 fw-bold text-dark">@Model.AttendanceRatePercentage.ToString("0.0")%</span>
                        <small class="text-muted">(@Model.AttendedSessions/@Model.TotalAttendanceSessions buổi)</small>
                    }
                    else
                    {
                        <span class="fs-5 fw-bold text-muted">—</span>
                        <small class="text-muted">Chưa có dữ liệu</small>
                    }
                </div>
                <small class="text-muted d-block mt-1">Theo điểm danh CLB</small>
            </div>
        </div>
    </div>

    <!-- 3. LỊCH SỬ THI ĐẤU & ĐÓNG GÓP GẦN NHẤT (RECENT MATCH CONTRIBUTIONS) -->
    <div class="arena-card p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="arena-sports-heading text-dark mb-0 fs-6">
                <i class="bi bi-clock-history text-primary me-2"></i>Lịch Sử Thi Đấu &amp; Đóng Góp Gần Nhất
            </h5>
            <span class="badge bg-light text-muted border">@Model.RecentMatches.Count trận đối soát</span>
        </div>

        @if (!Model.RecentMatches.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-calendar-x fs-2 d-block mb-2 text-muted"></i>
                <span class="small">Cầu thủ chưa có dữ liệu ra sân trong các trận đấu chính thức đã đối soát.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-3">Ngày đấu</th>
                            <th>Đối thủ</th>
                            <th>Sân</th>
                            <th class="text-center">Tỉ số</th>
                            <th>Vai trò</th>
                            <th class="text-center">Bàn thắng</th>
                            <th class="text-center">Kiến tạo</th>
                            <th class="text-end pe-3">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.RecentMatches)
                        {
                            <tr>
                                <td class="ps-3 text-muted small">
                                    @m.MatchDateTime.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    <strong class="text-dark">vs @m.OpponentName</strong>
                                </td>
                                <td class="small text-muted">
                                    <i class="bi bi-geo-alt me-1 text-danger"></i>@m.PitchName
                                </td>
                                <td class="text-center">
                                    <span class="badge @(m.TeamScore > m.OpponentScore ? "bg-success" : (m.TeamScore == m.OpponentScore ? "bg-secondary" : "bg-danger"))">
                                        @m.TeamScore - @m.OpponentScore
                                    </span>
                                </td>
                                <td>
                                    @if (m.IsStarting)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border">Đá chính</span>
                                    }
                                    else if (m.HasActuallyPlayed)
                                    {
                                        <span class="badge bg-success-subtle text-success border">Vào sân</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Dự bị</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (m.GoalsInMatch > 0)
                                    {
                                        <span class="badge bg-primary text-white fw-bold">@m.GoalsInMatch <i class="bi bi-ball"></i></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (m.AssistsInMatch > 0)
                                    {
                                        <span class="badge bg-warning text-dark fw-bold">@m.AssistsInMatch <i class="bi bi-lightning-fill"></i></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-controller="Matches" asp-action="Detail" asp-route-id="@m.MatchId" class="btn btn-outline-secondary btn-sm py-1 px-2" style="font-size: 11px;">
                                        Xem trận →
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- MODAL CÀI ĐẶT QUYỀN RIÊNG TƯ (IDOR PROTECTED) -->
@if (Model.IsSelf || Model.IsManager)
{
    <div class="modal fade" id="privacySettingsModal" tabindex="-1" aria-labelledby="privacySettingsModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Teams" asp-action="UpdatePlayerPrivacy" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PlayerId" value="@Model.PlayerId" />

                    <div class="modal-header">
                        <h5 class="modal-title" id="privacySettingsModalLabel">
                            <i class="bi bi-shield-lock-fill text-primary me-2"></i>Quyền Riêng Tư Hồ Sơ Cầu Thủ
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <p class="small text-muted mb-3">
                            Bạn có thể chủ động quyết định những thông tin nào được hiển thị công khai tới cộng đồng bóng đá phủi trên AloBall.
                        </p>

                        <!-- Công khai toàn bộ hồ sơ -->
                        <div class="form-check form-switch mb-3 p-3 bg-light rounded border">
                            <input class="form-check-input" type="checkbox" id="chkPublicProfile" name="IsPublicProfile" value="true" @(Model.IsPublicProfile ? "checked" : "") />
                            <label class="form-check-label fw-bold ms-2" for="chkPublicProfile">
                                Cho phép tìm kiếm &amp; hiển thị hồ sơ công khai
                            </label>
                            <small class="d-block text-muted ms-2 mt-1">Khi tắt, trang hồ sơ này sẽ bị ẩn với khách vãng lai (chỉ bạn và Lãnh đội xem được).</small>
                        </div>

                        <h6 class="fw-bold small text-muted text-uppercase mb-2">Chi tiết từng trường thông tin:</h6>

                        <div class="d-flex flex-column gap-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkKitNumber" name="PublicKitNumber" value="true" @(Model.PublicKitNumber ? "checked" : "") />
                                <label class="form-check-label" for="chkKitNumber">Hiển thị Số áo thi đấu</label>
                            </div>

                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkPosition" name="PublicPosition" value="true" @(Model.PublicPosition ? "checked" : "") />
                                <label class="form-check-label" for="chkPosition">Hiển thị Vị trí sở trường</label>
                            </div>

                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkPhoto" name="PublicPhoto" value="true" @(Model.PublicPhoto ? "checked" : "") />
                                <label class="form-check-label" for="chkPhoto">Hiển thị Ảnh đại diện cá nhân</label>
                            </div>

                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkFoot" name="PublicPreferredFoot" value="true" @(Model.PublicPreferredFoot ? "checked" : "") />
                                <label class="form-check-label" for="chkFoot">Hiển thị Chân thuận</label>
                            </div>

                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkExp" name="PublicExperience" value="true" @(Model.PublicExperience ? "checked" : "") />
                                <label class="form-check-label" for="chkExp">Hiển thị Kinh nghiệm / Trình độ</label>
                            </div>

                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkPhysical" name="PublicHeightWeight" value="true" @(Model.PublicHeightWeight ? "checked" : "") />
                                <label class="form-check-label" for="chkPhysical">Hiển thị Chiều cao &amp; Cân nặng</label>
                            </div>
                        </div>

                        <div class="alert alert-info py-2 px-3 small mt-3 mb-0">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Số điện thoại, email và ghi chú nội bộ luôn được bảo mật tuyệt đối và không bao giờ xuất hiện trên hồ sơ công khai.
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-arena-primary">Lưu cài đặt</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
