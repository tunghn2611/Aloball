@model AloBall.Web.Data.Entities.Team
@{
    ViewData["Title"] = $"Quản lý: {Model.Name}";
    var role = ViewBag.UserRole as AloBall.Web.Data.Entities.TeamRole?;
    bool isManager = ViewBag.IsManager ?? false;
    bool isOwner = ViewBag.IsOwner ?? false;
    var upcomingSessions = ViewBag.UpcomingSessions as IEnumerable<AloBall.Web.Data.Entities.AttendanceSession> ?? Enumerable.Empty<AloBall.Web.Data.Entities.AttendanceSession>();
}

<!-- Header Đội Đang Làm Việc -->
<div class="ab-card p-3 p-md-4 mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="ab-team-avatar" style="width: 60px; height: 60px; font-size: 1.5rem;">
                @Model.Name.Substring(0, Math.Min(2, Model.Name.Length))
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h3 class="fw-bold mb-0 text-dark">@Model.Name</h3>
                    @if (Model.IsRestrictedFromMatchmaking)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                            <i class="bi bi-slash-circle me-1"></i> Bị hạn chế bắt đối
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                            <i class="bi bi-shield-check me-1"></i> Sẵn sàng giao lưu
                        </span>
                    }
                </div>
                <div class="text-muted small mt-1">
                    <span class="me-3"><i class="bi bi-geo-alt-fill text-danger"></i> @(Model.ActivityArea ?? "Chưa đặt khu vực")</span>
                    <span><i class="bi bi-star-fill text-warning"></i> @Model.AverageRating.ToString("0.0") (@Model.ValidReviewCount đánh giá)</span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Teams" asp-action="PublicProfile" asp-route-slug="@Model.Slug" class="btn btn-ab-outline btn-sm" target="_blank">
                <i class="bi bi-box-arrow-up-right me-1"></i> Trang công khai
            </a>
            @if (isManager)
            {
                <a asp-controller="Attendance" asp-action="Sessions" asp-route-teamId="@Model.Id" class="btn btn-ab-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Tạo buổi sinh hoạt
                </a>
            }
        </div>
    </div>
</div>

@if ((ViewBag.UnreadMessagesCount ?? 0) > 0)
{
    <div class="alert alert-info d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 mb-4 rounded-3 shadow-sm border-info-subtle">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-bell-fill text-primary fs-5"></i>
            <span>Bạn có <strong>@ViewBag.UnreadMessagesCount tin nhắn chưa đọc</strong> từ @(isManager ? "thành viên đội" : "Ban cán sự / Đội trưởng").</span>
        </div>
        <a asp-controller="Teams" asp-action="Messages" asp-route-teamId="@Model.Id" class="btn btn-primary btn-sm px-3">
            Xem hộp thư <i class="bi bi-chevron-right ms-1"></i>
        </a>
    </div>
}

<!-- Lối vào các tác vụ chính (Quick Action Cards) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <a asp-action="Messages" asp-route-teamId="@Model.Id" class="text-decoration-none">
            <div class="ab-card p-3 text-center h-100">
                <div class="ab-empty-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem; background: #e0f2fe; color: #0284c7;">
                    <i class="bi bi-chat-dots-fill"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">Tin nhắn</h6>
                <div class="fs-4 fw-bold text-info">@((ViewBag.UnreadMessagesCount ?? 0) > 0 ? $"{ViewBag.UnreadMessagesCount} mới" : "Hộp thư")</div>
                <small class="text-muted">Liên hệ nội bộ</small>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a asp-action="Players" asp-route-teamId="@Model.Id" class="text-decoration-none">

            <div class="ab-card p-3 text-center h-100">
                <div class="ab-empty-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">Thành viên</h6>
                <div class="fs-4 fw-bold text-success">@ViewBag.TotalPlayers</div>
                <small class="text-muted">Cầu thủ trong đội</small>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="Attendance" asp-action="Sessions" asp-route-teamId="@Model.Id" class="text-decoration-none">
            <div class="ab-card p-3 text-center h-100">
                <div class="ab-empty-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem; background: #e0e7ff; color: #4338ca;">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">Điểm danh</h6>
                <div class="fs-4 fw-bold text-primary">@upcomingSessions.Count()</div>
                <small class="text-muted">Lịch thi đấu & tập</small>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="Matchmaking" asp-action="Index" class="text-decoration-none">
            <div class="ab-card p-3 text-center h-100">
                <div class="ab-empty-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem; background: #fef3c7; color: #b45309;">
                    <i class="bi bi-fire"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">Bắt đối</h6>
                <div class="fs-4 fw-bold text-warning">Sàn đấu</div>
                <small class="text-muted">Tìm kèo giao hữu</small>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="FireKeeping" asp-action="Index" asp-route-teamId="@Model.Id" class="text-decoration-none">
            <div class="ab-card p-3 text-center h-100 border-warning-subtle">
                <div class="ab-empty-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem; background: #fffbeb; color: #d97706;">
                    <span>🔥</span>
                </div>
                <h6 class="fw-bold text-dark mb-1">Giữ Lửa</h6>
                <div class="fs-4 fw-bold text-warning">Xếp Hạng AB</div>
                <small class="text-muted">Thi đua & Cúp tháng</small>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="Sheets" asp-action="ExportAttendance" asp-route-teamId="@Model.Id" class="text-decoration-none">
            <div class="ab-card p-3 text-center h-100">
                <div class="ab-empty-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem; background: #ecfdf5; color: #047857;">
                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">Xuất Excel</h6>
                <div class="fs-4 fw-bold text-success">Sheets</div>
                <small class="text-muted">Chuyên cần & Size áo</small>
            </div>
        </a>
    </div>
</div>

<!-- Buổi Sinh Hoạt Sắp Tới / Chưa Chốt -->
<div class="ab-card p-3 p-md-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-clock-history text-primary me-2"></i>Lịch hoạt động & Điểm danh gần nhất
        </h5>
        <a asp-controller="Attendance" asp-action="Sessions" asp-route-teamId="@Model.Id" class="small text-decoration-none fw-semibold">
            Xem tất cả <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    @if (!upcomingSessions.Any())
    {
        <div class="text-center py-4 bg-light rounded-3">
            <p class="text-muted small mb-2">Đội chưa có buổi tập hoặc thi đấu nào sắp tới.</p>
            @if (isManager)
            {
                <a asp-controller="Attendance" asp-action="Sessions" asp-route-teamId="@Model.Id" class="btn btn-ab-outline btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Tạo buổi mới ngay
                </a>
            }
        </div>
    }
    else
    {
        <div class="list-group list-group-flush border rounded-3 overflow-hidden">
            @foreach (var s in upcomingSessions)
            {
                <a asp-controller="Attendance" asp-action="Detail" asp-route-id="@s.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div>
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                @s.SessionDateTime.ToString("dd/MM/yyyy HH:mm")
                            </span>
                            @if (!string.IsNullOrEmpty(s.PitchName))
                            {
                                <span class="badge bg-light text-muted border">
                                    <i class="bi bi-geo-alt-fill text-danger"></i> @s.PitchName
                                </span>
                            }
                        </div>
                        <h6 class="fw-bold mb-1 text-dark">@s.Title</h6>
                        <small class="text-muted">Hạn báo quân: <strong class="text-danger">@s.ResponseDeadline.ToString("dd/MM HH:mm")</strong></small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (s.Status == AloBall.Web.Data.Entities.SessionStatus.Finalized)
                        {
                            <span class="badge bg-primary">Đã chốt sổ (+AB)</span>
                        }
                        else if (s.MatchId.HasValue)
                        {
                            <span class="badge bg-info text-dark">Đang đá / Có trận</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Đang điểm danh</span>
                        }
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            }
        </div>
    }
</div>

<!-- Lời Mời Giao Hữu Đích Danh (Thách đấu 1-1) -->
@{
    var incomingChallenges = ViewBag.IncomingChallenges as IEnumerable<AloBall.Web.Data.Entities.MatchmakingPost> ?? Enumerable.Empty<AloBall.Web.Data.Entities.MatchmakingPost>();
    var outgoingChallenges = ViewBag.OutgoingChallenges as IEnumerable<AloBall.Web.Data.Entities.MatchmakingPost> ?? Enumerable.Empty<AloBall.Web.Data.Entities.MatchmakingPost>();
}

<div class="ab-card p-3 p-md-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-envelope-paper-heart-fill text-danger me-2"></i>Lời Mời Thách Đấu Giao Hữu (1 - 1)
            </h5>
            <small class="text-muted">Phân biệt rõ ràng với kèo công khai trên sàn tìm đối chung</small>
        </div>
        <a asp-controller="Matchmaking" asp-action="Index" class="btn btn-ab-outline btn-sm">
            <i class="bi bi-search me-1"></i> Đến sàn bắt đối chung
        </a>
    </div>

    <!-- Nav tabs -->
    <ul class="nav nav-tabs mb-3" id="challengeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold" id="incoming-tab" data-bs-toggle="tab" data-bs-target="#incoming-pane" type="button" role="tab">
                Lời mời gửi đến (@incomingChallenges.Count())
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="outgoing-tab" data-bs-toggle="tab" data-bs-target="#outgoing-pane" type="button" role="tab">
                Lời mời đã gửi đi (@outgoingChallenges.Count())
            </button>
        </li>
    </ul>

    <div class="tab-content" id="challengeTabContent">
        <!-- Tab 1: Lời mời gửi đến -->
        <div class="tab-pane fade show active" id="incoming-pane" role="tabpanel">
            @if (!incomingChallenges.Any())
            {
                <div class="text-center py-4 bg-light rounded-3 text-muted small">
                    Hiện chưa có đội nào gửi lời mời thách đấu đích danh tới @Model.Name.
                </div>
            }
            else
            {
                <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                    @foreach (var c in incomingChallenges)
                    {
                        var prop = c.Proposals.FirstOrDefault();
                        <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-3 py-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        <i class="bi bi-shield-shaded me-1"></i> @c.Team.Name mời giao lưu
                                    </span>
                                    <span class="badge bg-light text-dark border">@c.PitchType</span>
                                </div>
                                <h6 class="fw-bold mb-1 text-dark">
                                    Thời gian: @c.MatchDate.ToString("dd/MM/yyyy") (@c.StartTime.ToString(@"hh\:mm") - @c.EndTime.ToString(@"hh\:mm"))
                                </h6>
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> @(c.PitchName ?? c.Area) | Tiền sân: <strong>@c.CostSharing</strong>
                                </div>
                                @if (!string.IsNullOrEmpty(c.Notes))
                                {
                                    <div class="small text-secondary fst-italic">"@c.Notes"</div>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Matchmaking" asp-action="Details" asp-route-id="@c.Id" class="btn btn-ab-outline btn-sm">
                                    Xem chi tiết
                                </a>
                                @if (isManager && prop != null && prop.Status == AloBall.Web.Data.Entities.ProposalStatus.Pending)
                                {
                                    <form asp-controller="Matchmaking" asp-action="AcceptProposal" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@c.Id" />
                                        <input type="hidden" name="proposalId" value="@prop.Id" />
                                        <button type="submit" class="btn btn-ab-primary btn-sm px-3" onclick="return confirm('Bạn có đồng ý nhận lời mời thách đấu này và tạo trận đấu chính thức giữa 2 đội?')">
                                            <i class="bi bi-check-lg me-1"></i> Đồng Ý Nhận Kèo
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Tab 2: Lời mời đã gửi đi -->
        <div class="tab-pane fade" id="outgoing-pane" role="tabpanel">
            @if (!outgoingChallenges.Any())
            {
                <div class="text-center py-4 bg-light rounded-3 text-muted small">
                    Đội của bạn chưa gửi lời mời thách đấu đích danh nào đang chờ duyệt.
                </div>
            }
            else
            {
                <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                    @foreach (var c in outgoingChallenges)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-3 py-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-warning-subtle text-dark border border-warning">
                                        <i class="bi bi-arrow-right me-1"></i> Đã gửi tới @(c.TargetTeam?.Name ?? "Đội bạn")
                                    </span>
                                    <span class="badge bg-light text-dark border">@c.PitchType</span>
                                </div>
                                <h6 class="fw-bold mb-1 text-dark">
                                    Thời gian: @c.MatchDate.ToString("dd/MM/yyyy") (@c.StartTime.ToString(@"hh\:mm") - @c.EndTime.ToString(@"hh\:mm"))
                                </h6>
                                <div class="small text-muted">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> @(c.PitchName ?? c.Area) | Tiền sân: <strong>@c.CostSharing</strong>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-warning text-dark px-3 py-2">Đang chờ đối thủ phản hồi</span>
                                <a asp-controller="Matchmaking" asp-action="Details" asp-route-id="@c.Id" class="btn btn-ab-outline btn-sm">
                                    Chi tiết
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
