@model AloBall.Web.Data.Entities.MatchGame
@{
    bool canEdit = ViewBag.IsManagerA ?? false;
    var teamAPlayers = Model.TeamA.Players.Where(p => p.IsActive).OrderBy(p => p.KitNumber ?? 999).ToList();
    var allFormations = AloBall.Web.Services.TeamDivision.FormationRegistry.AllFormations;
    var currentFormation = AloBall.Web.Services.TeamDivision.FormationRegistry.GetByCode(Model.FormationCode, Model.PitchType);
}

<style>
    /* ==========================================================================
       FIFA-STYLE TACTICAL PITCH & DRAG-AND-DROP STYLES
       ========================================================================== */
    .fifa-pitch-wrapper {
        background: #0f172a;
        border-radius: 16px;
        padding: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        margin-bottom: 20px;
    }

    .fifa-pitch-container {
        position: relative;
        width: 100%;
        max-width: 580px;
        aspect-ratio: 3 / 4;
        min-height: 520px;
        margin: 0 auto;
        background: radial-gradient(circle at 50% 50%, #15803d 0%, #166534 65%, #14532d 100%),
                    repeating-linear-gradient(0deg, rgba(255,255,255,0.035) 0, rgba(255,255,255,0.035) 45px, transparent 45px, transparent 90px);
        border: 4px solid #14532d;
        border-radius: 14px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), inset 0 0 50px rgba(0, 0, 0, 0.35);
        overflow: hidden;
        user-select: none;
    }

    /* Pitch markings */
    .fifa-pitch-markings {
        position: absolute;
        inset: 16px;
        border: 2px solid rgba(255, 255, 255, 0.65);
        border-radius: 4px;
        pointer-events: none;
    }
    .fifa-center-line {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 2px;
        background: rgba(255, 255, 255, 0.65);
    }
    .fifa-center-circle {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 110px;
        height: 110px;
        border: 2px solid rgba(255, 255, 255, 0.65);
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }
    .fifa-center-spot {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 8px;
        height: 8px;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }
    .fifa-penalty-top {
        position: absolute;
        top: 0;
        left: 50%;
        width: 170px;
        height: 65px;
        border: 2px solid rgba(255, 255, 255, 0.65);
        border-top: none;
        transform: translateX(-50%);
    }
    .fifa-penalty-bottom {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 170px;
        height: 65px;
        border: 2px solid rgba(255, 255, 255, 0.65);
        border-bottom: none;
        transform: translateX(-50%);
    }
    .fifa-goal-bottom {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 85px;
        height: 28px;
        border: 2px solid rgba(255, 255, 255, 0.65);
        border-bottom: none;
        transform: translateX(-50%);
    }

    /* Player Token on Pitch */
    .fifa-player-token {
        position: absolute;
        transform: translate(-50%, -50%);
        width: 90px;
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: grab;
        transition: transform 0.15s ease, filter 0.15s ease;
        z-index: 10;
        touch-action: manipulation;
    }
    .fifa-player-token:active {
        cursor: grabbing;
        transform: translate(-50%, -50%) scale(1.08);
        z-index: 50;
    }
    .fifa-player-token.drag-hover {
        transform: translate(-50%, -50%) scale(1.15);
        filter: drop-shadow(0 0 14px #facc15);
    }
    .fifa-player-token.selected-swap {
        filter: drop-shadow(0 0 16px #38bdf8);
        animation: pulseToken 1.2s infinite;
    }
    @@keyframes pulseToken {
        0%, 100% { transform: translate(-50%, -50%) scale(1.08); }
        50% { transform: translate(-50%, -50%) scale(1.18); }
    }

    /* FIFA Token Card Badge */
    .fifa-card-badge {
        position: relative;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 1.05rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.45);
        border: 2.5px solid #fff;
    }
    .fifa-card-badge.side-A {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        border-color: #bfdbfe;
    }
    .fifa-card-badge.side-B {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #1e1b4b;
        border-color: #fef08a;
    }
    .fifa-card-badge.empty {
        background: rgba(255, 255, 255, 0.2);
        color: rgba(255, 255, 255, 0.8);
        border: 2px dashed rgba(255, 255, 255, 0.6);
    }

    /* Compatibility indicator dot */
    .fifa-compat-dot {
        position: absolute;
        top: -2px;
        right: -2px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 2px solid #fff;
    }
    .fifa-compat-dot.primary {
        background-color: #22c55e;
    }
    .fifa-compat-dot.secondary {
        background-color: #f59e0b;
    }

    /* Slot Label Pill */
    .fifa-slot-pill {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 1px 6px;
        border-radius: 4px;
        background: rgba(0, 0, 0, 0.8);
        color: #facc15;
        letter-spacing: 0.5px;
        margin-top: 3px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.3);
        border: 1px solid rgba(250, 204, 21, 0.4);
    }

    /* Player Name Label */
    .fifa-name-pill {
        font-size: 0.72rem;
        font-weight: 750;
        color: #fff;
        background: rgba(15, 23, 42, 0.9);
        padding: 2px 7px;
        border-radius: 6px;
        margin-top: 2px;
        white-space: nowrap;
        max-width: 90px;
        overflow: hidden;
        text-overflow: ellipsis;
        box-shadow: 0 2px 6px rgba(0,0,0,0.4);
        border: 1px solid rgba(255,255,255,0.25);
        text-align: center;
    }

    /* Bench / Subs Bar */
    .fifa-bench-container {
        background: #1e293b;
        border-radius: 12px;
        padding: 14px;
        margin-top: 16px;
        border: 1px solid #334155;
    }
    .fifa-bench-container.drag-hover {
        border-color: #facc15;
        background: #283548;
    }
    .fifa-bench-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        min-height: 52px;
        align-items: center;
    }
    .fifa-sub-token {
        background: #334155;
        color: #fff;
        border: 1px solid #475569;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.8rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: grab;
        transition: transform 0.15s ease, background-color 0.15s ease;
    }
    .fifa-sub-token:hover {
        background: #475569;
        transform: translateY(-2px);
    }
    .fifa-sub-token:active {
        cursor: grabbing;
    }
        /* Read-only mode styling for team members */
    .fifa-pitch-readonly .fifa-player-token,
    .fifa-pitch-readonly .fifa-sub-token,
    .fifa-pitch-readonly .player-touch-card {
        cursor: default !important;
    }
    .fifa-pitch-readonly .fifa-player-token:hover,
    .fifa-pitch-readonly .fifa-sub-token:hover,
    .fifa-pitch-readonly .player-touch-card:hover {
        transform: none !important;
    }
    
    .fifa-sub-token.selected-swap {
        border-color: #38bdf8;
        background: #0284c7;
        box-shadow: 0 0 12px rgba(56, 189, 248, 0.6);
    }
</style>

<div class="division-studio mb-4" id="divisionContainer">
    <!-- Header & Action Controls -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <span class="eyebrow">BẢNG CHIẾN THUẬT</span>
            <h2 class="mt-2 h4 fw-bold">Chia đội & Đội hình ra sân</h2>
            <small class="text-muted">Sa bàn chiến thuật kéo thả cầu thủ kiểu FIFA · Cân bằng sở trường · Khóa vị trí & Dự bị</small>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleSettingsModal()" style="min-height: 44px;">
                <i class="bi bi-gear-fill me-1"></i> Thiết lập quân số
            </button>
            <button type="button" class="btn btn-arena-outline btn-sm fw-semibold" id="btnRunDivision" onclick="runAutoDivision()" style="min-height: 44px;">
                <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Chia đội tự động
            </button>
            <button type="button" class="btn btn-arena-primary btn-sm px-3 fw-bold shadow-sm" id="btnConfirmDivision" onclick="saveConfirmedDivision()" style="min-height: 44px;">
                <i class="bi bi-floppy-fill me-1"></i> Lưu đội hình
            </button>
        </div>
    </div>

    <!-- Alert Banner / Diagnostic Message -->
    <div id="divisionAlert" class="alert d-none py-2 px-3 mb-3 small" role="alert"></div>

    <!-- Sơ đồ chiến thuật & Thông tin tỷ lệ sở trường -->
    <div class="row g-2 align-items-center mb-3">
        <div class="col-12 col-md-5">
            <label for="selFormation" class="form-label small fw-bold mb-1">Sơ đồ thi đấu:</label>
            <select id="selFormation" class="form-select form-select-sm" style="min-height: 44px;" onchange="onFormationChange()">
                @foreach (var f in allFormations)
                {
                    if (f.Code == currentFormation.Code)
                    {
                        <option value="@f.Code" data-capacity="@(f.PlayersPerSide * 2)" selected>@f.Name (@f.PitchType - @(f.PlayersPerSide * 2) người đá chính)</option>
                    }
                    else
                    {
                        <option value="@f.Code" data-capacity="@(f.PlayersPerSide * 2)">@f.Name (@f.PitchType - @(f.PlayersPerSide * 2) người đá chính)</option>
                    }
                }
            </select>
        </div>

        <div class="col-12 col-md-7">
            <div class="p-2 bg-white rounded border d-flex justify-content-around text-center small">
                <div>
                    <span class="text-muted d-block">Đá chính</span>
                    <strong class="text-primary fs-6" id="txtStarterCount">@(currentFormation.PlayersPerSide * 2)</strong>
                </div>
                <div class="border-start"></div>
                <div>
                    <span class="text-muted d-block">Dự bị</span>
                    <strong class="text-warning fs-6" id="txtSubCount">0</strong>
                </div>
                <div class="border-start"></div>
                <div>
                    <span class="text-muted d-block">Đúng sở trường</span>
                    <strong class="text-success fs-6" id="txtPrimaryRatio">--</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- VIEW MODE TABS: SA BÀN FIFA 2D vs DANH SÁCH THẺ VỊ TRÍ -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <ul class="nav nav-pills" id="divisionViewModeTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold px-3 py-2 shadow-sm" id="tab-mode-pitch" data-bs-toggle="pill" data-bs-target="#viewModePitch" type="button" role="tab" style="min-height: 42px;">
                    <i class="bi bi-diagram-3-fill me-1 text-success"></i> Sa bàn sân bóng FIFA (Kéo thả)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold px-3 py-2" id="tab-mode-list" data-bs-toggle="pill" data-bs-target="#viewModeList" type="button" role="tab" style="min-height: 42px;">
                    <i class="bi bi-card-list me-1 text-primary"></i> Danh sách thẻ vị trí
                </button>
            </li>
        </ul>

        <!-- Đổi bên xem trên sa bàn (Bên A / Bên B) -->
        <div class="btn-group btn-group-sm" id="pitchSideToggleGroup" role="group">
            <button type="button" class="btn btn-primary active fw-semibold px-3 py-2" id="btnPitchSideA" onclick="switchPitchSide('A')">
                <i class="bi bi-shield-shaded me-1"></i> Bên A (Áo sáng)
            </button>
            <button type="button" class="btn btn-outline-warning text-dark fw-semibold px-3 py-2" id="btnPitchSideB" onclick="switchPitchSide('B')">
                <i class="bi bi-shield-fill me-1"></i> Bên B (Áo tối)
            </button>
        </div>
    </div>

    <!-- Tap-to-Swap Banner (khi đang chọn 1 cầu thủ) -->
    <div id="swapNotice" class="alert alert-info py-2 px-3 mb-3 d-none align-items-center justify-content-between">
        <div class="small">
            <i class="bi bi-arrow-left-right me-1"></i> Đang chọn: <strong id="swapSourceName">--</strong>. Hãy chạm vào cầu thủ thứ hai (trên sân hoặc dự bị) để hoán đổi!
        </div>
        <button type="button" class="btn btn-sm btn-link text-decoration-none py-0" onclick="cancelSwapSelection()">Hủy</button>
    </div>

    <!-- TAB CONTENTS -->
    <div class="tab-content" id="divisionMainTabContent">
        <!-- TAB 1: SA BÀN SÂN BÓNG FIFA (KÉO THẢ) -->
        <div class="tab-pane fade show active" id="viewModePitch" role="tabpanel">
            <div class="fifa-pitch-wrapper">
                <!-- Header của sa bàn -->
                <div class="d-flex justify-content-between align-items-center text-white mb-2 px-2 small">
                    <div>
                        <span class="badge bg-success me-1">SƠ ĐỒ TRẬN</span>
                        <strong id="pitchFormationTitle">Sơ đồ 2-3-1</strong> · Đang xem: <span class="badge bg-primary" id="pitchSideBadge">Bên A (Áo sáng)</span>
                    </div>
                    <div class="text-white-50 d-none d-md-block">
                        <i class="bi bi-hand-index-thumb me-1"></i> Kéo thả vị trí cầu thủ như game FIFA
                    </div>
                </div>

                <!-- Sân bóng 2D FIFA -->
                <div class="fifa-pitch-container" id="fifaPitchContainer">
                    <!-- Các đường kẻ sân cỏ -->
                    <div class="fifa-pitch-markings"></div>
                    <div class="fifa-penalty-top"></div>
                    <div class="fifa-center-line"></div>
                    <div class="fifa-center-circle"></div>
                    <div class="fifa-center-spot"></div>
                    <div class="fifa-penalty-bottom"></div>
                    <div class="fifa-goal-bottom"></div>

                    <!-- Vị trí các cầu thủ được sinh động qua JS -->
                    <div id="fifaPitchField" style="position: absolute; inset: 0;"></div>
                </div>

                <!-- Băng ghế dự bị (Bench) -->
                <div class="fifa-bench-container" id="fifaBenchContainer" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDropToBench(event)">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-white">
                            <i class="bi bi-person-fill-gear text-warning me-1"></i> Băng ghế dự bị (<span id="fifaBenchCount">0</span> người)
                        </span>
                        <span class="small text-white-50" style="font-size: 0.72rem;">Kéo cầu thủ vào sân để thay người</span>
                    </div>
                    <div class="fifa-bench-list" id="fifaBenchList">
                        <!-- Danh sách dự bị sinh động qua JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: DANH SÁCH THẺ VỊ TRÍ (CLASSIC 3-COLUMN VIEW) -->
        <div class="tab-pane fade" id="viewModeList" role="tabpanel">
            <!-- Mobile Navigation Tabs (Touch-friendly >= 44px) -->
            <ul class="nav nav-pills nav-fill mb-3 d-md-none" id="divisionTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold py-2" id="tab-sideA" data-bs-toggle="pill" data-bs-target="#pane-sideA" type="button" role="tab" style="min-height: 44px;">
                        Bên A <span class="badge bg-primary ms-1" id="badgeCountA">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold py-2" id="tab-sideB" data-bs-toggle="pill" data-bs-target="#pane-sideB" type="button" role="tab" style="min-height: 44px;">
                        Bên B <span class="badge bg-warning text-dark ms-1" id="badgeCountB">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold py-2" id="tab-subs" data-bs-toggle="pill" data-bs-target="#pane-subs" type="button" role="tab" style="min-height: 44px;">
                        Dự bị <span class="badge bg-secondary ms-1" id="badgeCountSub">0</span>
                    </button>
                </li>
            </ul>

            <!-- Division Lineup Slots Container -->
            <div class="tab-content" id="divisionTabContent">
                <!-- Desktop Grid / Mobile Tab Panes -->
                <div class="row g-3">
                    <!-- Cột Bên A -->
                    <div class="col-12 col-md-5 tab-pane fade show active d-md-block" id="pane-sideA" role="tabpanel">
                        <div class="card border-primary-subtle shadow-sm h-100">
                            <div class="card-header bg-primary-subtle text-primary fw-bold py-2 d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-shield-shaded me-1"></i> Bên A (Áo sáng)</span>
                                <span class="badge bg-primary" id="headerCountA">0</span>
                            </div>
                            <div class="card-body p-2" id="slotsAContainer" style="min-height: 250px;">
                                <!-- Slots dynamically rendered via JavaScript -->
                            </div>
                        </div>
                    </div>

                    <!-- Cột Bên B -->
                    <div class="col-12 col-md-5 tab-pane fade d-md-block" id="pane-sideB" role="tabpanel">
                        <div class="card border-warning-subtle shadow-sm h-100">
                            <div class="card-header bg-warning-subtle text-dark fw-bold py-2 d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-shield-fill me-1"></i> Bên B (Áo tối)</span>
                                <span class="badge bg-warning text-dark" id="headerCountB">0</span>
                            </div>
                            <div class="card-body p-2" id="slotsBContainer" style="min-height: 250px;">
                                <!-- Slots dynamically rendered via JavaScript -->
                            </div>
                        </div>
                    </div>

                    <!-- Cột Dự bị -->
                    <div class="col-12 col-md-2 tab-pane fade d-md-block" id="pane-subs" role="tabpanel">
                        <div class="card border-secondary-subtle shadow-sm h-100">
                            <div class="card-header bg-light text-muted fw-bold py-2 d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-person-fill-gear me-1"></i> Dự bị</span>
                                <span class="badge bg-secondary" id="headerCountSub">0</span>
                            </div>
                            <div class="card-body p-2" id="subsContainer" style="min-height: 250px;">
                                <!-- Substitutes rendered via JavaScript -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (canEdit)
{
<!-- Modal Thiết lập quân số tham gia & Chỉ định dự bị -->
<div class="modal fade" id="settingsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold text-dark">
                    <i class="bi bi-people-fill text-primary me-2"></i>Chọn Danh Sách Tham Gia & Dự Bị
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="participantGuidance" class="alert alert-info py-2 small mb-3" role="status" aria-live="polite"></div>
                <p class="small text-muted">Tích Dự bị cho người vào sân sau. Bỏ tích Tham gia nếu cầu thủ vắng mặt. Có thể đổi sơ đồ bên ngoài nếu muốn tăng số người đá chính.</p>

                <div class="table-responsive" style="max-height: 350px;">
                    <table class="table table-sm table-hover align-middle small mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width: 44px;" class="text-center">Tham gia</th>
                                <th>Cầu thủ</th>
                                <th>Vị trí sở trường</th>
                                <th style="width: 80px;" class="text-center">Dự bị</th>
                                <th style="width: 110px;" class="text-center">Khóa bên</th>
                                <th style="width: 120px;" class="text-center">Khóa vị trí</th>
                            </tr>
                        </thead>
                        <tbody id="participantTableBody">
                            @foreach (var p in teamAPlayers)
                            {
                                var existingLineup = Model.Lineups.FirstOrDefault(l => l.PlayerId == p.Id);
                                bool isParticipant = existingLineup != null || !Model.Lineups.Any();
                                bool isSub = existingLineup != null && !existingLineup.IsStarting;
                                string lockedSide = "";
                                string lockedSlot = "";

                                <tr id="row-p-@p.Id" data-player-id="@p.Id" data-player-name="@p.FullName">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input chk-participant" aria-label="Tham gia: @p.FullName" value="@p.Id" @(isParticipant ? "checked" : "") style="width: 22px; height: 22px;" onchange="updateParticipantStats()" />
                                    </td>
                                    <td>
                                        <strong>#@(p.KitNumber?.ToString() ?? "-") @p.FullName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@(p.Position ?? "Chưa rõ")</span>
                                    </td>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input chk-substitute" aria-label="Dự bị: @p.FullName" value="@p.Id" @(isSub ? "checked" : "") style="width: 22px; height: 22px;" onchange="updateParticipantStats()" />
                                    </td>
                                    <td class="text-center">
                                        <select class="form-select form-select-sm sel-lock-side">
                                            <option value="">--</option>
                                            <option value="A" selected="@(lockedSide == "A")">Bên A</option>
                                            <option value="B" selected="@(lockedSide == "B")">Bên B</option>
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        <select class="form-select form-select-sm sel-lock-slot">
                                            <option value="">--</option>
                                            <option value="GK" selected="@(lockedSlot == "GK")">Thủ môn (GK)</option>
                                            <option value="CB_L" selected="@(lockedSlot == "CB_L")">Hậu vệ T</option>
                                            <option value="CB_R" selected="@(lockedSlot == "CB_R")">Hậu vệ P</option>
                                            <option value="MF_L" selected="@(lockedSlot == "MF_L")">Tiền vệ T</option>
                                            <option value="MF_C" selected="@(lockedSlot == "MF_C")">Tiền vệ Giữa</option>
                                            <option value="MF_R" selected="@(lockedSlot == "MF_R")">Tiền vệ P</option>
                                            <option value="FW" selected="@(lockedSlot == "FW")">Tiền đạo</option>
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between py-2">
                <div class="small">
                    Đã chọn tham gia: <strong class="text-primary" id="modalCountSelected">0</strong> | Dự bị: <strong class="text-warning" id="modalCountSubs">0</strong>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-arena-outline btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnApplyParticipants" class="btn btn-arena-primary btn-sm px-4 fw-bold" onclick="applyParticipantsAndDivide()">Xác nhận & chia đội</button>
                </div>
            </div>
        </div>
    </div>
</div>
}

<script>
    // State management
    const canEditTactics = @(canEdit ? "true" : "false");
    const matchId = '@Model.Id';
    let currentRevision = @Model.LineupRevision;
    let currentFormationCode = '@currentFormation.Code';
    let selectedPlayerForSwap = null; // { playerId, side, slotCode, name }
    let currentPitchSide = 'A'; // 'A' hoặc 'B' đang hiển thị trên sa bàn FIFA
    let draggedItem = null; // { playerId, side, slotCode, name }

    // Dữ liệu đội hình đang hiển thị (in-memory state)
    let stateSideA = []; // Array of { slotCode, slotName, category, playerId, playerName, kitNumber, isPrimary, isSecondary, isLockedSide, isLockedSlot }
    let stateSideB = [];
    let stateSubs = [];  // Array of { playerId, playerName, kitNumber, designatedSide }

    // Bản đồ tọa độ % trên sân bóng theo sơ đồ chiến thuật FIFA (y: 0% trên cùng [FW], 90% dưới cùng [GK])
    const formationCoords = {
        "7_231": {
            "GK":   { x: 50, y: 88 },
            "CB_L": { x: 28, y: 68 },
            "CB_R": { x: 72, y: 68 },
            "MF_L": { x: 18, y: 44 },
            "MF_C": { x: 50, y: 46 },
            "MF_R": { x: 82, y: 44 },
            "FW":   { x: 50, y: 20 }
        },
        "7_321": {
            "GK":   { x: 50, y: 88 },
            "DF_L": { x: 22, y: 68 },
            "DF_C": { x: 50, y: 70 },
            "DF_R": { x: 78, y: 68 },
            "MF_L": { x: 32, y: 44 },
            "MF_R": { x: 68, y: 44 },
            "FW":   { x: 50, y: 20 }
        },
        "5_121": {
            "GK":   { x: 50, y: 88 },
            "DF":   { x: 50, y: 68 },
            "MF_L": { x: 24, y: 44 },
            "MF_R": { x: 76, y: 44 },
            "FW":   { x: 50, y: 20 }
        },
        "5_211": {
            "GK":   { x: 50, y: 88 },
            "DF_L": { x: 30, y: 68 },
            "DF_R": { x: 70, y: 68 },
            "MF_C": { x: 50, y: 44 },
            "FW":   { x: 50, y: 20 }
        }
    };

    document.addEventListener("DOMContentLoaded", function () {
        initInitialState();
        updateParticipantStats();
    });

    function initInitialState() {
        @foreach (var l in Model.Lineups)
        {
            if (l.IsStarting && l.TeamSide == "A")
            {
                <text>
                stateSideA.push({
                    slotCode: '@(l.AssignedSlotCode ?? "SLOT")',
                    slotName: '@(l.AssignedPosition ?? l.AssignedSlotCode ?? "Vị trí")',
                    category: 'MF',
                    playerId: '@l.PlayerId',
                    playerName: '@Html.Raw(l.Player?.FullName ?? "")',
                    kitNumber: @(l.Player?.KitNumber?.ToString() ?? "null"),
                    isPrimaryPosition: true,
                    isSecondaryPosition: false,
                    isLockedSide: false,
                    isLockedSlot: false
                });
                </text>
            }
            else if (l.IsStarting && l.TeamSide == "B")
            {
                <text>
                stateSideB.push({
                    slotCode: '@(l.AssignedSlotCode ?? "SLOT")',
                    slotName: '@(l.AssignedPosition ?? l.AssignedSlotCode ?? "Vị trí")',
                    category: 'MF',
                    playerId: '@l.PlayerId',
                    playerName: '@Html.Raw(l.Player?.FullName ?? "")',
                    kitNumber: @(l.Player?.KitNumber?.ToString() ?? "null"),
                    isPrimaryPosition: true,
                    isSecondaryPosition: false,
                    isLockedSide: false,
                    isLockedSlot: false
                });
                </text>
            }
            else if (!l.IsStarting)
            {
                <text>
                stateSubs.push({
                    playerId: '@l.PlayerId',
                    playerName: '@Html.Raw(l.Player?.FullName ?? "")',
                    kitNumber: @(l.Player?.KitNumber?.ToString() ?? "null"),
                    designatedSide: '@(l.TeamSide ?? "")'
                });
                </text>
            }
        }

        renderAllSlots();
    }

    function switchPitchSide(side) {
        currentPitchSide = side;
        const btnA = document.getElementById('btnPitchSideA');
        const btnB = document.getElementById('btnPitchSideB');
        const badge = document.getElementById('pitchSideBadge');

        if (side === 'A') {
            btnA.className = 'btn btn-primary active fw-semibold px-3 py-2';
            btnB.className = 'btn btn-outline-warning text-dark fw-semibold px-3 py-2';
            badge.className = 'badge bg-primary';
            badge.innerText = 'Bên A (Áo sáng)';
        } else {
            btnA.className = 'btn btn-outline-primary fw-semibold px-3 py-2';
            btnB.className = 'btn btn-warning text-dark active fw-semibold px-3 py-2';
            badge.className = 'badge bg-warning text-dark';
            badge.innerText = 'Bên B (Áo tối)';
        }

        renderFifaPitch();
    }

    function toggleSettingsModal() {
        if (!canEditTactics) return;
        updateParticipantStats();
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('settingsModal'));
        modal.show();
    }

    function applyParticipantsAndDivide() {
        if (!canEditTactics) return;
        if (!updateParticipantStats()) return;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('settingsModal')).hide();
        runAutoDivision();
    }

    function onFormationChange() {
        currentFormationCode = document.getElementById('selFormation').value;
        const selText = document.getElementById('selFormation').selectedOptions[0].text;
        document.getElementById('pitchFormationTitle').innerText = selText.split('(')[0].trim();
        runAutoDivision();
    }

    function updateParticipantStats() {
        document.querySelectorAll('#participantTableBody tr').forEach(row => {
            const participating = row.querySelector('.chk-participant').checked;
            const substitute = row.querySelector('.chk-substitute');
            if (!participating) substitute.checked = false;
            substitute.disabled = !participating;
        });
        const checkedParticipants = document.querySelectorAll('.chk-participant:checked');
        const checkedSubs = document.querySelectorAll('.chk-substitute:checked');

        const totalSelected = checkedParticipants.length;
        const totalSubs = checkedSubs.length;

        document.getElementById('modalCountSelected').innerText = totalSelected;
        document.getElementById('modalCountSubs').innerText = totalSubs;
        const capacity = Number(document.getElementById('selFormation').selectedOptions[0].dataset.capacity);
        const starters = totalSelected - totalSubs;
        const difference = starters - capacity;
        const guidance = document.getElementById('participantGuidance');
        const summary = `${totalSelected} người tham gia · ${starters}/${capacity} suất đá chính · ${totalSubs} dự bị. `;
        guidance.textContent = summary + (difference > 0
            ? `Chọn thêm ${difference} người dự bị để tiếp tục chia đội.`
            : difference < 0
                ? `Cần thêm ${-difference} người đá chính: chọn thêm người tham gia, bỏ chọn dự bị hoặc đổi sơ đồ.`
                : 'Đã đủ quân số. Sẵn sàng chia đội.');
        guidance.className = `alert alert-${difference === 0 ? 'success' : 'info'} py-2 small mb-3`;
        document.getElementById('btnApplyParticipants').disabled = difference !== 0;
        return difference === 0;
    }

    // 1. Chạy chia đội tự động (AJAX Call to MatchesController.PreviewAutoDivision)
    async function runAutoDivision() {
        if (!canEditTactics) return;
        showAlert(null);
        if (!updateParticipantStats()) {
            toggleSettingsModal();
            return;
        }
        const btn = document.getElementById('btnRunDivision');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang tính toán...';

        showAlert(null);

        const participantIds = [];
        const explicitSubIds = [];
        const lockedSides = {};
        const lockedSlots = {};

        document.querySelectorAll('#participantTableBody tr').forEach(row => {
            const pId = row.dataset.playerId;
            const isPart = row.querySelector('.chk-participant').checked;
            const isSub = row.querySelector('.chk-substitute').checked;
            const side = row.querySelector('.sel-lock-side').value;
            const slot = row.querySelector('.sel-lock-slot').value;

            if (isPart) {
                participantIds.push(pId);
                if (isSub) explicitSubIds.push(pId);
                if (side) lockedSides[pId] = side;
                if (slot) lockedSlots[pId] = slot;
            }
        });

        try {
            const res = await fetch('/Matches/PreviewAutoDivision', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    matchId: matchId,
                    formationCode: document.getElementById('selFormation').value,
                    participantPlayerIds: participantIds,
                    explicitSubstitutePlayerIds: explicitSubIds,
                    lockedTeamSides: lockedSides,
                    lockedSlotCodes: lockedSlots,
                    seed: Math.floor(Math.random() * 100000)
                })
            });

            const json = await res.json();
            if (json.success && json.data) {
                const data = json.data;
                stateSideA = data.teamASlots;
                stateSideB = data.teamBSlots;
                stateSubs = data.substitutes;

                renderAllSlots();
                showAlert(`Chia đội thành công! Đã tối ưu ${data.totalPrimaryMatches} vị trí đúng sở trường chính.`, 'success');

                const totalStarters = stateSideA.length + stateSideB.length;
                document.getElementById('txtPrimaryRatio').innerText = `${data.totalPrimaryMatches}/${totalStarters}`;
            } else {
                const msg = json.data?.diagnosticMessage || json.message || 'Không thể chia đội thỏa mãn.';
                const suggestions = json.data?.remediationSuggestions?.join(' ') || '';
                showAlert(`${msg} ${suggestions}`, 'danger');
            }
        } catch (err) {
            showAlert('Lỗi kết nối máy chủ: ' + err.message, 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-lightning-charge-fill text-warning me-1"></i> Chia đội tự động';
        }
    }

    // 2. Render đồng bộ cả Sa bàn FIFA và Danh sách Thẻ vị trí
    function renderAllSlots() {
        renderFifaPitch();
        renderClassicSlots();
    }

    // 2.1. Render Sa bàn FIFA 2D
    function renderFifaPitch() {
        const pitchField = document.getElementById('fifaPitchField');
        const benchList = document.getElementById('fifaBenchList');
        const benchCount = document.getElementById('fifaBenchCount');

        const activeTeamSlots = (currentPitchSide === 'A') ? stateSideA : stateSideB;
        const totalSlots = activeTeamSlots.length;

        if (totalSlots === 0) {
            pitchField.innerHTML = `
                <div class="d-flex flex-column align-items-center justify-content-center text-center p-3" style="position: absolute; inset: 0; z-index: 10;">
                    <div class="p-3 rounded-4 shadow-lg" style="background: rgba(15, 23, 42, 0.88); backdrop-filter: blur(8px); max-width: 360px; border: 1px solid rgba(255,255,255,0.15);">
                        <i class="bi bi-diagram-3 text-warning fs-1 d-block mb-2"></i>
                        <h6 class="text-white fw-bold mb-1">Chưa xếp đội hình trên sa bàn</h6>
                        <p class="text-white-50 small mb-0">
                            ${canEditTactics 
                                ? 'Đội trưởng hãy bấm <strong>"Chia đội tự động"</strong> để xếp đội hình lên sa bàn.' 
                                : 'Đội trưởng chưa chốt đội hình cho trận đấu này.'}
                        </p>
                    </div>
                </div>
            `;
            benchCount.innerText = 0;
            benchList.innerHTML = '<span class="small text-white-50 fst-italic">Không có cầu thủ dự bị.</span>';
            return;
        }

        // Render các slot trên sân
        pitchField.innerHTML = activeTeamSlots.map((s, idx) => {
            const coords = getCoordinatesForSlot(s.slotCode, currentFormationCode, idx, totalSlots);
            const isSelected = selectedPlayerForSwap && selectedPlayerForSwap.playerId === s.playerId;
            const isPrimary = s.isPrimaryPosition !== false;
            const compatClass = isPrimary ? 'primary' : 'secondary';
            const badgeClass = currentPitchSide === 'A' ? 'side-A' : 'side-B';

            const dragAttrs = canEditTactics ? `
                     draggable="true"
                     ondragstart="handleDragStart(event, '${s.playerId}', '${currentPitchSide}', '${s.slotCode}', '${escapeHtml(s.playerName)}')"
                     ondragend="handleDragEnd(event)"
                     ondragover="handleDragOver(event)"
                     ondragleave="handleDragLeave(event)"
                     ondrop="handleDrop(event, '${s.playerId}', '${currentPitchSide}', '${s.slotCode}', '${escapeHtml(s.playerName)}')"
                     onclick="handleTapPlayer('${s.playerId}', '${currentPitchSide}', '${s.slotCode}', '${escapeHtml(s.playerName)}')"` : 'draggable="false"';

            return `
                <div class="fifa-player-token ${isSelected ? 'selected-swap' : ''}" 
                     style="left: ${coords.x}%; top: ${coords.y}%;"
                     ${dragAttrs}>
                    <div class="fifa-card-badge ${badgeClass}">
                        <span>#${s.kitNumber ?? '-'}</span>
                        <span class="fifa-compat-dot ${compatClass}" title="${isPrimary ? 'Đúng sở trường' : 'Vị trí phụ'}"></span>
                    </div>
                    <span class="fifa-slot-pill">${s.slotCode}</span>
                    <span class="fifa-name-pill" title="${escapeHtml(s.playerName)}">${escapeHtml(s.playerName)}</span>
                </div>
            `;
        }).join('');

        // Render băng ghế dự bị dưới sa bàn
        benchCount.innerText = stateSubs.length;
        if (stateSubs.length === 0) {
            benchList.innerHTML = '<span class="small text-white-50 fst-italic">Không có cầu thủ dự bị.</span>';
        } else {
            benchList.innerHTML = stateSubs.map(sub => {
                const isSelected = selectedPlayerForSwap && selectedPlayerForSwap.playerId === sub.playerId;
                const subDragAttrs = canEditTactics ? `
                         draggable="true"
                         ondragstart="handleDragStart(event, '${sub.playerId}', 'SUB', '', '${escapeHtml(sub.playerName)}')"
                         ondragend="handleDragEnd(event)"
                         ondragover="handleDragOver(event)"
                         ondragleave="handleDragLeave(event)"
                         ondrop="handleDrop(event, '${sub.playerId}', 'SUB', '', '${escapeHtml(sub.playerName)}')"
                         onclick="handleTapPlayer('${sub.playerId}', 'SUB', '', '${escapeHtml(sub.playerName)}')"` : 'draggable="false"';

                return `
                    <div class="fifa-sub-token ${isSelected ? 'selected-swap' : ''}"
                         ${subDragAttrs}>
                        <span class="badge bg-secondary rounded-circle">#${sub.kitNumber ?? '-'}</span>
                        <span>${escapeHtml(sub.playerName)}</span>
                    </div>
                `;
            }).join('');
        }
    }

    function getCoordinatesForSlot(slotCode, formationCode, index, totalSlots) {
        if (formationCoords[formationCode] && formationCoords[formationCode][slotCode]) {
            return formationCoords[formationCode][slotCode];
        }

        // Tọa độ thông minh dự phòng
        if (slotCode.startsWith('GK')) return { x: 50, y: 88 };
        if (slotCode.startsWith('CB') || slotCode.startsWith('DF')) {
            if (slotCode.includes('_L')) return { x: 28, y: 68 };
            if (slotCode.includes('_R')) return { x: 72, y: 68 };
            return { x: 50, y: 70 };
        }
        if (slotCode.startsWith('MF')) {
            if (slotCode.includes('_L')) return { x: 18, y: 44 };
            if (slotCode.includes('_R')) return { x: 82, y: 44 };
            return { x: 50, y: 46 };
        }
        if (slotCode.startsWith('FW')) return { x: 50, y: 20 };

        const yStep = 65 / Math.max(1, totalSlots);
        return { x: 25 + ((index * 30) % 50), y: 85 - (index * yStep) };
    }

    // 2.2. Render Danh sách thẻ vị trí cổ điển
    function renderClassicSlots() {
        const contA = document.getElementById('slotsAContainer');
        const contB = document.getElementById('slotsBContainer');
        const contSub = document.getElementById('subsContainer');

        contA.innerHTML = stateSideA.map((s, idx) => renderSlotItem(s, 'A', idx)).join('');
        contB.innerHTML = stateSideB.map((s, idx) => renderSlotItem(s, 'B', idx)).join('');
        contSub.innerHTML = stateSubs.map((s, idx) => renderSubItem(s, idx)).join('');

        document.getElementById('headerCountA').innerText = `${stateSideA.length} người`;
        document.getElementById('headerCountB').innerText = `${stateSideB.length} người`;
        document.getElementById('headerCountSub').innerText = `${stateSubs.length} người`;

        document.getElementById('badgeCountA').innerText = stateSideA.length;
        document.getElementById('badgeCountB').innerText = stateSideB.length;
        document.getElementById('badgeCountSub').innerText = stateSubs.length;

        document.getElementById('txtStarterCount').innerText = stateSideA.length + stateSideB.length;
        document.getElementById('txtSubCount').innerText = stateSubs.length;
    }

    function renderSlotItem(s, side, idx) {
        const isSelected = selectedPlayerForSwap && selectedPlayerForSwap.playerId === s.playerId;
        const borderClass = isSelected ? 'border-primary border-2 shadow-sm bg-primary-subtle' : 'border';
        const primaryBadge = s.isPrimaryPosition !== false
            ? '<span class="badge bg-success-subtle text-success border border-success-subtle">Đúng vị trí</span>' 
            : '<span class="badge bg-warning-subtle text-dark border border-warning-subtle">Vị trí phụ</span>';

        const dragAttrs = canEditTactics ? `
                 draggable="true"
                 ondragstart="handleDragStart(event, '${s.playerId}', '${side}', '${s.slotCode}', '${escapeHtml(s.playerName)}')"
                 ondragend="handleDragEnd(event)"
                 ondragover="handleDragOver(event)"
                 ondragleave="handleDragLeave(event)"
                 ondrop="handleDrop(event, '${s.playerId}', '${side}', '${s.slotCode}', '${escapeHtml(s.playerName)}')"
                 onclick="handleTapPlayer('${s.playerId}', '${side}', '${s.slotCode}', '${escapeHtml(s.playerName)}')"` : 'draggable="false"';
        const cursorClass = canEditTactics ? 'cursor-pointer' : '';

        return `
            <div class="p-2 mb-2 rounded ${borderClass} d-flex justify-content-between align-items-center ${cursorClass} player-touch-card" 
                 style="min-height: 48px; background-color: #fff;"
                 ${dragAttrs}>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-dark rounded-circle px-2 py-1" style="min-width: 26px;">#${s.kitNumber ?? '-'}</span>
                    <div>
                        <strong class="text-dark d-block">${escapeHtml(s.playerName)}</strong>
                        <small class="text-muted"><span class="badge bg-light text-secondary border me-1">${s.slotCode}</span> ${s.slotName}</small>
                    </div>
                </div>
                <div class="text-end">
                    ${primaryBadge}
                </div>
            </div>
        `;
    }

    function renderSubItem(s, idx) {
        const isSelected = selectedPlayerForSwap && selectedPlayerForSwap.playerId === s.playerId;
        const borderClass = isSelected ? 'border-primary border-2 shadow-sm bg-primary-subtle' : 'border';

        const dragAttrs = canEditTactics ? `
                 draggable="true"
                 ondragstart="handleDragStart(event, '${s.playerId}', 'SUB', '', '${escapeHtml(s.playerName)}')"
                 ondragend="handleDragEnd(event)"
                 ondragover="handleDragOver(event)"
                 ondragleave="handleDragLeave(event)"
                 ondrop="handleDrop(event, '${s.playerId}', 'SUB', '', '${escapeHtml(s.playerName)}')"
                 onclick="handleTapPlayer('${s.playerId}', 'SUB', '', '${escapeHtml(s.playerName)}')"` : 'draggable="false"';
        const cursorClass = canEditTactics ? 'cursor-pointer' : '';

        return `
            <div class="p-2 mb-2 rounded ${borderClass} d-flex justify-content-between align-items-center ${cursorClass} player-touch-card"
                 style="min-height: 48px; background-color: #f8f9fa;"
                 ${dragAttrs}>
                <div>
                    <strong class="text-dark d-block">#${s.kitNumber ?? '-'} ${escapeHtml(s.playerName)}</strong>
                    <span class="badge bg-secondary">Dự bị</span>
                </div>
            </div>
        `;
    }

    // ==========================================================
    // 3. DRAG AND DROP HANDLERS (KÉO THẢ KIỂU FIFA)
    // ==========================================================
    function handleDragStart(e, playerId, side, slotCode, name) {
        if (!canEditTactics) return;
        draggedItem = { playerId, side, slotCode, name };
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', JSON.stringify(draggedItem));
        e.currentTarget.classList.add('opacity-50');
    }

    function handleDragEnd(e) {
        e.currentTarget.classList.remove('opacity-50');
        document.querySelectorAll('.drag-hover').forEach(el => el.classList.remove('drag-hover'));
    }

    function handleDragOver(e) {
        if (!canEditTactics) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        e.currentTarget.classList.add('drag-hover');
    }

    function handleDragLeave(e) {
        if (!canEditTactics) return;
        e.currentTarget.classList.remove('drag-hover');
    }

    function handleDrop(e, targetPlayerId, targetSide, targetSlotCode, targetName) {
        if (!canEditTactics) return;
        e.preventDefault();
        e.currentTarget.classList.remove('drag-hover');
        if (!draggedItem) return;
        if (draggedItem.playerId === targetPlayerId) return;

        executeSwap(draggedItem, { playerId: targetPlayerId, side: targetSide, slotCode: targetSlotCode, name: targetName });
        draggedItem = null;
    }

    function handleDropToBench(e) {
        if (!canEditTactics) return;
        e.preventDefault();
        e.currentTarget.classList.remove('drag-hover');
        if (!draggedItem) return;
        if (draggedItem.side === 'SUB') return; // Đã là dự bị rồi

        // Nếu kéo cầu thủ đá chính thả vào băng ghế dự bị:
        // Đổi chỗ với cầu thủ dự bị đầu tiên hoặc chuyển thành dự bị
        if (stateSubs.length > 0) {
            const firstSub = stateSubs[0];
            executeSwap(draggedItem, { playerId: firstSub.playerId, side: 'SUB', slotCode: '', name: firstSub.playerName });
        }
        draggedItem = null;
    }

    // ==========================================================
    // 4. TAP-TO-SWAP (CHẠM ĐỔI VỊ TRÍ TRÊN MOBILE / MÀN CẢM ỨNG)
    // ==========================================================
    function handleTapPlayer(playerId, side, slotCode, name) {
        if (!canEditTactics) return;
        if (!selectedPlayerForSwap) {
            selectedPlayerForSwap = { playerId, side, slotCode, name };
            document.getElementById('swapSourceName').innerText = name;
            document.getElementById('swapNotice').classList.remove('d-none');
            document.getElementById('swapNotice').classList.add('d-flex');
            renderAllSlots();
            return;
        }

        if (selectedPlayerForSwap.playerId === playerId) {
            cancelSwapSelection();
            return;
        }

        executeSwap(selectedPlayerForSwap, { playerId, side, slotCode, name });
        cancelSwapSelection();
    }

    function cancelSwapSelection() {
        selectedPlayerForSwap = null;
        document.getElementById('swapNotice').classList.add('d-none');
        document.getElementById('swapNotice').classList.remove('d-flex');
        renderAllSlots();
    }

    function executeSwap(first, second) {
        let p1 = null, p2 = null;

        if (first.side === 'A') p1 = stateSideA.find(x => x.playerId === first.playerId);
        else if (first.side === 'B') p1 = stateSideB.find(x => x.playerId === first.playerId);
        else p1 = stateSubs.find(x => x.playerId === first.playerId);

        if (second.side === 'A') p2 = stateSideA.find(x => x.playerId === second.playerId);
        else if (second.side === 'B') p2 = stateSideB.find(x => x.playerId === second.playerId);
        else p2 = stateSubs.find(x => x.playerId === second.playerId);

        if (!p1 || !p2) return;

        // Hoán đổi thông tin cầu thủ
        const tempId = p1.playerId;
        const tempName = p1.playerName;
        const tempKit = p1.kitNumber;

        p1.playerId = p2.playerId;
        p1.playerName = p2.playerName;
        p1.kitNumber = p2.kitNumber;

        p2.playerId = tempId;
        p2.playerName = tempName;
        p2.kitNumber = tempKit;

        renderAllSlots();
        showAlert(`Đã hoán đổi vị trí giữa ${first.name} và ${second.name}.`, 'info');
    }

    // ==========================================================
    // 5. LƯU CHÍNH THỨC ĐỘI HÌNH (ConfirmInternalDivision)
    // ==========================================================
    async function saveConfirmedDivision() {
        if (!canEditTactics) return;
        const btn = document.getElementById('btnConfirmDivision');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

        const assignments = [];
        stateSideA.forEach(s => assignments.push({ playerId: s.playerId, teamSide: 'A', slotCode: s.slotCode }));
        stateSideB.forEach(s => assignments.push({ playerId: s.playerId, teamSide: 'B', slotCode: s.slotCode }));

        const subs = stateSubs.map(s => ({ playerId: s.playerId, designatedSide: s.designatedSide || null }));
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch('/Matches/ConfirmInternalDivision', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    matchId: matchId,
                    formationCode: currentFormationCode,
                    expectedRevision: currentRevision,
                    submissionToken: crypto.randomUUID(),
                    assignments: assignments,
                    substitutes: subs
                })
            });

            const json = await res.json();
            if (json.success) {
                currentRevision = json.newRevision;
                showAlert('Đã lưu đội hình chia đội thành công vào hệ thống!', 'success');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showAlert(json.message || 'Lỗi khi lưu đội hình.', 'danger');
            }
        } catch (err) {
            showAlert('Lỗi kết nối khi lưu: ' + err.message, 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-floppy-fill me-1"></i> Lưu đội hình';
        }
    }

    function showAlert(msg, type = 'info') {
        const el = document.getElementById('divisionAlert');
        if (!msg) {
            el.classList.add('d-none');
            return;
        }
        el.className = `alert alert-${type} py-2 px-3 mb-3 small d-block`;
        el.innerHTML = msg;
    }

    function escapeHtml(text) {
        if (!text) return '';
        return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
</script>
