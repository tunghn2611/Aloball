@model AloBall.Web.Data.Entities.MatchGame
@{
    bool isInternal = Model.Category == AloBall.Web.Data.Entities.MatchCategory.Internal;
    bool isManagerA = ViewBag.IsManagerA ?? false;
    bool isManagerB = ViewBag.IsManagerB ?? false;
    bool memberA = ViewBag.MemberA ?? false;
    bool memberB = ViewBag.MemberB ?? false;

    // Xác định góc nhìn của người dùng hiện tại
    bool viewerIsSideB = !isInternal && (isManagerB || memberB);
    string myTeamSide = isInternal ? "A" : (viewerIsSideB ? "B" : "A");
    var myTeam = viewerIsSideB ? Model.TeamB : Model.TeamA;
    string myTeamName = myTeam?.Name ?? (viewerIsSideB ? (Model.TeamBExternalName ?? "Đội Khách") : "Đội Nhà");
    bool canEdit = isInternal ? isManagerA : (viewerIsSideB ? isManagerB : isManagerA);

    var teamAPlayers = Model.TeamA.Players.Where(p => p.IsActive).OrderBy(p => p.KitNumber ?? 999).ToList();
    var teamBPlayers = Model.TeamB?.Players.Where(p => p.IsActive).OrderBy(p => p.KitNumber ?? 999).ToList() ?? new List<AloBall.Web.Data.Entities.Player>();
    var myTeamPlayers = viewerIsSideB ? teamBPlayers : teamAPlayers;

    string teamAName = Model.TeamA?.Name ?? "Bên A";
    string teamBName = Model.TeamB?.Name ?? Model.TeamBExternalName ?? "Bên B";

    var allFormations = AloBall.Web.Services.TeamDivision.FormationRegistry.AllFormations;
    var currentFormation = AloBall.Web.Services.TeamDivision.FormationRegistry.GetByCode(Model.FormationCode, Model.PitchType);
    string activePitchFormat = currentFormation.PitchType; // "5 người", "7 người", "11 người"
}

<style>
    /* ==========================================================================
       ALOBALL SMART TACTICAL BOARD (SA BÀN FIFA ĐẤU NỘI BỘ & GIAO HỮU)
       ========================================================================== */
    .tactical-board-wrapper {
        background: linear-gradient(180deg, #071912 0%, #0a261c 100%);
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
        margin-bottom: 24px;
        color: #f8fafc;
        user-select: none;
    }

    /* Format & Formation Bar */
    .tactical-format-btn {
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        color: #e2e8f0;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 14px;
        border-radius: 8px;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .tactical-format-btn:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
    }
    .tactical-format-btn.active {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        color: #fff !important;
        border-color: #34d399 !important;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
    }

    /* Pitch container */
    .smart-pitch-container {
        position: relative;
        width: 100%;
        max-width: 580px;
        aspect-ratio: 3 / 4;
        min-height: 480px;
        margin: 0 auto;
        background: radial-gradient(circle at 50% 50%, #15803d 0%, #166534 65%, #0f3d20 100%),
                    repeating-linear-gradient(0deg, rgba(255,255,255,0.035) 0, rgba(255,255,255,0.035) 45px, transparent 45px, transparent 90px);
        border: 4px solid #0f3d20;
        border-radius: 16px;
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.55), inset 0 0 60px rgba(0, 0, 0, 0.45);
        overflow: hidden;
    }

    /* Pitch line markings */
    .smart-pitch-markings {
        position: absolute;
        inset: 14px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 4px;
        pointer-events: none;
    }
    .smart-center-line {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 2px;
        background: rgba(255, 255, 255, 0.7);
    }
    .smart-center-circle {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100px;
        height: 100px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }
    .smart-center-spot {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 8px;
        height: 8px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }
    .smart-penalty-top {
        position: absolute;
        top: 0;
        left: 50%;
        width: 150px;
        height: 60px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-top: none;
        transform: translateX(-50%);
    }
    .smart-penalty-bottom {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 150px;
        height: 60px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-bottom: none;
        transform: translateX(-50%);
    }
    .smart-goal-bottom {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 80px;
        height: 24px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-bottom: none;
        transform: translateX(-50%);
    }

    /* Tactical Slot & Card Token */
    .tactical-slot-anchor {
        position: absolute;
        transform: translate(-50%, -50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        z-index: 5;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .tactical-slot-anchor.drag-hover {
        transform: translate(-50%, -50%) scale(1.18);
        filter: drop-shadow(0 0 12px #38bdf8);
    }

    .ab-slot-empty {
        width: 68px;
        height: 72px;
        border: 2px dashed rgba(255, 255, 255, 0.4);
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.35);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.75);
        cursor: pointer;
        backdrop-filter: blur(2px);
        transition: all 0.2s ease;
    }
    .ab-slot-empty:hover {
        border-color: #38bdf8;
        background: rgba(56, 189, 248, 0.15);
        color: #fff;
    }

    /* Premium Football Player Card */
    .ab-card-premium {
        position: relative;
        width: 78px;
        background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: 4px;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        cursor: grab;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }
    .ab-card-premium:hover:not(.readonly-card) {
        transform: translateY(-4px) scale(1.05);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.8), 0 0 14px rgba(56, 189, 248, 0.6);
        border-color: #38bdf8;
    }
    .ab-card-premium.side-B-card {
        border-color: #facc15;
    }
    .ab-card-premium.side-B-card:hover:not(.readonly-card) {
        border-color: #f59e0b;
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.8), 0 0 14px rgba(245, 158, 11, 0.6);
    }
    .ab-card-premium.readonly-card {
        cursor: default;
    }

    /* Card Top Bar (Pos Badge + Kit No) */
    .ab-card-topbar {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 2px 2px 2px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 2px;
    }
    .ab-pos-badge {
        font-size: 0.62rem;
        font-weight: 800;
        padding: 1px 4px;
        border-radius: 4px;
        color: #fff;
        line-height: 1.1;
    }
    .ab-pos-GK { background: #eab308; color: #000; }
    .ab-pos-DF { background: #2563eb; }
    .ab-pos-MF { background: #16a34a; }
    .ab-pos-FW { background: #dc2626; }

    .ab-kit-num {
        color: #facc15;
        font-weight: 900;
        font-size: 0.72rem;
    }

    /* Card Avatar */
    .ab-card-avatar {
        position: relative;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1.5px solid rgba(255, 255, 255, 0.7);
        overflow: hidden;
        margin: 2px 0 3px 0;
        background: #0f172a;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .ab-card-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .ab-card-avatar .ab-avatar-fallback {
        color: #e2e8f0;
        font-weight: 800;
        font-size: 0.85rem;
    }

    /* Card Player Name */
    .ab-card-name {
        width: 100%;
        font-size: 0.66rem;
        font-weight: 800;
        color: #ffffff;
        text-transform: uppercase;
        letter-spacing: 0.2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding: 0 2px;
        margin-bottom: 2px;
        text-shadow: 0 1px 3px rgba(0,0,0,0.8);
    }

    /* Card Meta details (Foot & Experience) */
    .ab-card-meta {
        width: 100%;
        display: flex;
        justify-content: center;
        gap: 3px;
        font-size: 0.56rem;
        color: #cbd5e1;
        font-weight: 600;
        background: rgba(0, 0, 0, 0.45);
        border-radius: 4px;
        padding: 1px 3px;
    }

    /* Card Reason Pill */
    .ab-card-reason-pill {
        margin-top: 2px;
        font-size: 0.53rem;
        padding: 1px 4px;
        border-radius: 4px;
        background: rgba(16, 185, 129, 0.2);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.3);
        white-space: nowrap;
        max-width: 72px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Tap-to-Swap Selected State */
    .ab-card-premium.selected-for-swap {
        border-color: #38bdf8 !important;
        box-shadow: 0 0 20px rgba(56, 189, 248, 0.95), inset 0 0 8px rgba(56, 189, 248, 0.5) !important;
        animation: pulseSwapCard 1.1s infinite;
    }
    @@keyframes pulseSwapCard {
        0%, 100% { transform: scale(1.05); }
        50% { transform: scale(1.14); }
    }

    /* Pitch Box for Dual Pitch view */
    .tactical-pitch-box {
        transition: border-color 0.2s ease;
    }
    .tactical-pitch-box:hover {
        border-color: rgba(255, 255, 255, 0.3) !important;
    }

    /* Substitutes Bench */
    .smart-bench-wrapper {
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 14px;
        padding: 14px;
        margin-top: 20px;
    }
    .smart-bench-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        min-height: 85px;
        align-items: center;
    }
    .smart-bench-item {
        transition: transform 0.15s ease;
    }
    .smart-bench-item:hover {
        transform: translateY(-3px);
    }

    /* Mobile adjustments */
    @@media (max-width: 768px) {
        .smart-pitch-container {
            max-width: 100%;
            min-height: 440px;
        }
        .ab-card-premium {
            width: 66px;
            padding: 3px;
        }
        .ab-card-avatar {
            width: 30px;
            height: 30px;
        }
        .ab-card-name {
            font-size: 0.6rem;
        }
        .ab-card-meta {
            font-size: 0.52rem;
        }
        .ab-card-reason-pill {
            display: none;
        }
    }
</style>

<div class="tactical-board-wrapper" id="smartTacticalBoard">
    <!-- TOP CONTROL PANEL: Pitch Format, Quick Division Options & Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2 py-1">
                    <i class="bi bi-diagram-3-fill me-1"></i> SA BÀN CHIẾN THUẬT FIFA
                </span>
                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50" id="badgeRoleIndicator">
                    <i class="bi bi-pencil-fill me-1"></i> @(canEdit ? $"Quyền Đội trưởng ({myTeamName})" : $"Thành viên (Chế độ xem - {myTeamName})")
                </span>
            </div>
            <h5 class="fw-bold mb-0 text-white">
                @(isInternal ? "Phân Đội Hình & 2 Sa Bàn Thi Đấu Nội Bộ" : $"Sơ Đồ Thi Đấu Chiến Thuật · {myTeamName}")
            </h5>
        </div>

        <!-- MANAGER ACTION BUTTONS -->
        <div class="d-flex flex-wrap align-items-center gap-2" id="managerActionButtons">
            <button type="button" class="btn btn-sm btn-outline-info" id="btnParticipantSettings" onclick="openParticipantSettingsModal()">
                <i class="bi bi-sliders me-1"></i> Cài đặt quân số
            </button>

            @if (isInternal)
            {
                <!-- 2 TÙY CHỌN XẾP NHANH ĐẤU NỘI BỘ -->
                <button type="button" class="btn btn-sm btn-success fw-bold px-3 shadow" id="btnModeAVsB" onclick="triggerDivision('a_vs_b')" title="Đội A điểm cao nhất, Đội B kế tiếp, còn lại dự bị">
                    <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> Đội A vs Đội B
                </button>
                <button type="button" class="btn btn-sm btn-info text-dark fw-bold px-3 shadow" id="btnModeBalanced" onclick="triggerDivision('balanced')" title="Điểm số chia đều cân bằng cho 2 đội">
                    <i class="bi bi-scales me-1"></i> Trận đấu cân bằng
                </button>
            }
            else
            {
                <!-- NÚT TỰ ĐỘNG XẾP CHO GIAO HỮU -->
                <button type="button" class="btn btn-sm btn-success fw-bold px-3 shadow" id="btnAutoDivide" onclick="triggerDivision('friendly')">
                    <i class="bi bi-magic me-1"></i> Tự động xếp sơ đồ
                </button>
            }

            <button type="button" class="btn btn-sm btn-warning text-dark fw-bold px-3 shadow" id="btnSaveLineup" onclick="saveLineupToServer()">
                <i class="bi bi-check-circle-fill me-1"></i> Lưu đội hình
            </button>
        </div>
    </div>

    <!-- FORMAT & FORMATION PRESET SELECTORS -->
    <div class="row g-3 align-items-center mb-3">
        <!-- 1. Format Sân (5, 7, 11 người) -->
        <div class="col-12 col-md-5">
            <div class="small text-white-50 mb-1 fw-semibold">1. Chọn thể thức sân:</div>
            <div class="btn-group w-100" role="group" aria-label="Format sân">
                <button type="button" class="tactical-format-btn @(activePitchFormat.Contains("5") ? "active" : "")" @(canEdit ? "" : "disabled") onclick="setPitchFormat('5 người')">
                    Sân 5 (5v5)
                </button>
                <button type="button" class="tactical-format-btn @(activePitchFormat.Contains("7") ? "active" : "")" @(canEdit ? "" : "disabled") onclick="setPitchFormat('7 người')">
                    Sân 7 (7v7)
                </button>
                <button type="button" class="tactical-format-btn @(activePitchFormat.Contains("11") ? "active" : "")" @(canEdit ? "" : "disabled") onclick="setPitchFormat('11 người')">
                    Sân 11 (11v11)
                </button>
            </div>
        </div>

        <!-- 2. Sơ đồ chiến thuật theo thể thức -->
        <div class="col-12 col-md-7">
            <div class="small text-white-50 mb-1 fw-semibold">2. Chọn sơ đồ chiến thuật (áp dụng cho cả 2 bên):</div>
            <select id="tacticalFormationSelect" class="form-select form-select-sm bg-dark text-white border-secondary" @(canEdit ? "" : "disabled") onchange="onFormationSelectChanged()">
                <!-- Options populated dynamically based on active pitch format -->
            </select>
        </div>
    </div>

    <!-- EXPLANATION & STATS BAR -->
    <div class="p-2 mb-3 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 d-flex flex-wrap justify-content-between align-items-center gap-2 small">
        <div class="d-flex align-items-center gap-3">
            <div><span class="text-white-50">Tổng đá chính:</span> <strong class="text-info fs-6" id="statStartersCount">0</strong></div>
            <div class="border-start border-secondary border-opacity-50 ps-3"><span class="text-white-50">Dự bị:</span> <strong class="text-warning fs-6" id="statSubsCount">0</strong></div>
            <div class="border-start border-secondary border-opacity-50 ps-3"><span class="text-white-50">Đúng sở trường:</span> <strong class="text-success fs-6" id="statPrimaryCount">0%</strong></div>
        </div>
        <div class="text-white-50 small">
            @if (isInternal)
            {
                <span><i class="bi bi-info-circle text-info me-1"></i> Tùy chọn <strong>"Đội A vs Đội B"</strong>: Đội A mạnh nhất, Đội B kế tiếp. Tùy chọn <strong>"Trận đấu cân bằng"</strong>: Chia đều sức mạnh 2 bên.</span>
            }
            else
            {
                <span><i class="bi bi-info-circle text-info me-1"></i> Ưu tiên Thủ môn &rarr; Vị trí sở trường &rarr; Điểm kinh nghiệm. Cầu thủ điểm thấp hơn tự động vào dự bị.</span>
            }
        </div>
    </div>

    <!-- TAP-TO-SWAP NOTIFICATION BANNER -->
    <div id="swapAlertBanner" class="alert alert-info py-2 px-3 mb-3 d-none align-items-center justify-content-between shadow">
        <div class="small">
            <i class="bi bi-arrow-left-right me-1 text-primary"></i>
            Đang chọn: <strong id="swapPlayerName">--</strong> (<span id="swapPlayerSide">--</span>).
            <span class="ms-1">Chạm vào một thẻ khác ở bất kỳ Sa bàn nào hoặc Băng ghế dự bị để hoán đổi vị trí!</span>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary text-dark py-0 px-2" onclick="cancelSwapSelection()">Hủy</button>
    </div>

    <!-- THE PITCHES VIEW -->
    @if (isInternal)
    {
        <!-- CHẾ ĐỘ NỘI BỘ: HIỂN THỊ ĐỒNG THỜI 2 SA BÀN (SA BÀN ĐỘI A VÀ SA BÀN ĐỘI B) -->
        <div class="row g-3" id="dualPitchesWrapper">
            <!-- CỘT SA BÀN ĐỘI A -->
            <div class="col-12 col-xl-6">
                <div class="tactical-pitch-box p-3 rounded-4" style="background: rgba(16, 185, 129, 0.06); border: 1.5px solid rgba(16, 185, 129, 0.4); box-shadow: 0 8px 24px rgba(0,0,0,0.35);">
                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success fs-6 px-2 py-1 shadow-sm"><i class="bi bi-shield-shaded me-1"></i> ĐỘI A</span>
                            <span class="fw-bold text-white fs-6" id="labelTeamAName">@teamAName</span>
                        </div>
                        <div class="text-end small">
                            <span class="text-white-50">Điểm TB:</span> <strong class="text-warning fs-6" id="avgScoreA">0</strong>
                            <span class="mx-1 text-white-50">|</span>
                            <span class="text-white-50">Đá chính:</span> <strong class="text-info fs-6" id="countA">0</strong>
                        </div>
                    </div>
                    <div class="smart-pitch-container" id="pitchA">
                        <div class="smart-pitch-markings"></div>
                        <div class="smart-penalty-top"></div>
                        <div class="smart-center-line"></div>
                        <div class="smart-center-circle"></div>
                        <div class="smart-center-spot"></div>
                        <div class="smart-penalty-bottom"></div>
                        <div class="smart-goal-bottom"></div>
                        <!-- Dynamic Slots container for Team A -->
                        <div id="pitchSlotsFieldA" style="position: absolute; inset: 0;"></div>
                    </div>
                </div>
            </div>

            <!-- CỘT SA BÀN ĐỘI B -->
            <div class="col-12 col-xl-6">
                <div class="tactical-pitch-box p-3 rounded-4" style="background: rgba(234, 179, 8, 0.06); border: 1.5px solid rgba(234, 179, 8, 0.4); box-shadow: 0 8px 24px rgba(0,0,0,0.35);">
                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark fs-6 px-2 py-1 shadow-sm"><i class="bi bi-shield-fill me-1"></i> ĐỘI B</span>
                            <span class="fw-bold text-white fs-6" id="labelTeamBName">@teamBName</span>
                        </div>
                        <div class="text-end small">
                            <span class="text-white-50">Điểm TB:</span> <strong class="text-warning fs-6" id="avgScoreB">0</strong>
                            <span class="mx-1 text-white-50">|</span>
                            <span class="text-white-50">Đá chính:</span> <strong class="text-info fs-6" id="countB">0</strong>
                        </div>
                    </div>
                    <div class="smart-pitch-container" id="pitchB">
                        <div class="smart-pitch-markings"></div>
                        <div class="smart-penalty-top"></div>
                        <div class="smart-center-line"></div>
                        <div class="smart-center-circle"></div>
                        <div class="smart-center-spot"></div>
                        <div class="smart-penalty-bottom"></div>
                        <div class="smart-goal-bottom"></div>
                        <!-- Dynamic Slots container for Team B -->
                        <div id="pitchSlotsFieldB" style="position: absolute; inset: 0;"></div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- CHẾ ĐỘ GIAO HỮU: CHỈ HIỂN THỊ 1 SA BÀN DUY NHẤT CỦA ĐỘI MÌNH (BẢO VỆ TÍNH BẢO MẬT ĐỐI THỦ) -->
        <div class="smart-pitch-container" id="pitchSingle">
            <div class="smart-pitch-markings"></div>
            <div class="smart-penalty-top"></div>
            <div class="smart-center-line"></div>
            <div class="smart-center-circle"></div>
            <div class="smart-center-spot"></div>
            <div class="smart-penalty-bottom"></div>
            <div class="smart-goal-bottom"></div>
            <!-- Dynamic Slots container -->
            <div id="pitchSlotsFieldSingle" style="position: absolute; inset: 0;"></div>
        </div>
    }

    <!-- BENCH / SUBSTITUTES TRAY -->
    <div class="smart-bench-wrapper">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="small fw-bold text-white-50">
                <i class="bi bi-people-fill text-warning me-1"></i>
                BĂNG GHẾ DỰ BỊ (<span id="benchTotalCount">0</span> cầu thủ)
            </div>
            @if (canEdit)
            {
                <div class="text-white-50 small" style="font-size: 0.75rem;">
                    Kéo thả hoặc chạm thẻ để thay người vào sân của Đội A hoặc Đội B
                </div>
            }
        </div>
        <div class="smart-bench-list" id="benchListField" ondragover="onBenchDragOver(event)" ondrop="onBenchDrop(event)">
            <!-- Bench Player Cards populated here -->
        </div>
    </div>
</div>

<!-- MODAL CÀI ĐẶT QUÂN SỐ VÀ KHÓA VỊ TRÍ (CHỈ ĐỘI TRƯỞNG) -->
@if (canEdit)
{
<div class="modal fade" id="participantSettingsModal" tabindex="-1" aria-labelledby="participantSettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-dark">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-bold" id="participantSettingsModalLabel">
                    <i class="bi bi-sliders me-1 text-primary"></i> Cài Đặt Quân Số & Ràng Buộc Đội Hình · @myTeamName
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <p class="small text-muted mb-0">
                        Tích chọn cầu thủ ra sân tham gia thi đấu. Người không đủ suất sẽ tự động vào dự bị.
                    </p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm py-1 px-2" onclick="toggleSelectAllParticipants(true)">
                            <i class="bi bi-check-all me-1"></i>Chọn tất cả
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2" onclick="toggleSelectAllParticipants(false)">
                            <i class="bi bi-dash-square me-1"></i>Bỏ chọn
                        </button>
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 380px;">
                    <table class="table table-sm table-hover align-middle small mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width: 44px;" class="text-center">
                                    <input type="checkbox" id="chkSelectAllParticipants" class="form-check-input" checked onchange="toggleSelectAllParticipants(this.checked)" title="Chọn/Bỏ chọn tất cả" />
                                </th>
                                <th>Cầu thủ</th>
                                <th>Sở trường</th>
                                <th>Kinh nghiệm</th>
                                <th style="width: 80px;" class="text-center">Dự bị</th>
                                @if (isInternal)
                                {
                                    <th style="width: 110px;" class="text-center">Khóa bên</th>
                                }
                                <th style="width: 130px;" class="text-center">Khóa vị trí</th>
                            </tr>
                        </thead>
                        <tbody id="participantTableBody">
                            @foreach (var p in myTeamPlayers)
                            {
                                var existingLineup = Model.Lineups.FirstOrDefault(l => l.PlayerId == p.Id);
                                bool isParticipant = existingLineup != null || !Model.Lineups.Any();
                                bool isSub = existingLineup != null && !existingLineup.IsStarting;

                                <tr id="row-p-@p.Id" data-player-id="@p.Id" data-player-name="@p.FullName">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input chk-participant" value="@p.Id" @(isParticipant ? "checked" : "") onchange="onParticipantCheckboxChanged()" />
                                    </td>
                                    <td>
                                        <strong>#@(p.KitNumber?.ToString() ?? "-") @p.FullName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@(p.Position ?? "Chưa rõ")</span>
                                    </td>
                                    <td>
                                        <span class="small text-muted">@(p.Experience ?? "-")</span>
                                    </td>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input chk-substitute" value="@p.Id" @(isSub ? "checked" : "") onchange="refreshModalParticipantCount()" />
                                    </td>
                                    @if (isInternal)
                                    {
                                        <td class="text-center">
                                            <select class="form-select form-select-sm sel-lock-side">
                                                <option value="">--</option>
                                                <option value="A">Bên A</option>
                                                <option value="B">Bên B</option>
                                            </select>
                                        </td>
                                    }
                                    <td class="text-center">
                                        <select class="form-select form-select-sm sel-lock-slot">
                                            <option value="">--</option>
                                            <option value="GK">GK (Thủ môn)</option>
                                            <option value="CB">CB (Trung vệ)</option>
                                            <option value="LB">LB (Hậu vệ T)</option>
                                            <option value="RB">RB (Hậu vệ P)</option>
                                            <option value="CM">CM (Tiền vệ giữa)</option>
                                            <option value="LM">LM (Tiền vệ T)</option>
                                            <option value="RM">RM (Tiền vệ P)</option>
                                            <option value="ST">ST (Tiền đạo)</option>
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between py-2">
                <div class="small">
                    Đã chọn tham gia: <strong class="text-primary" id="modalTotalPart">0</strong> |
                    Chỉ định dự bị: <strong class="text-warning" id="modalTotalSub">0</strong>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    @if (isInternal)
                    {
                        <button type="button" class="btn btn-success btn-sm fw-bold px-3" onclick="applyModalSettingsAndDivide('a_vs_b')">
                            <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> Xếp Đội A vs B
                        </button>
                        <button type="button" class="btn btn-info text-dark btn-sm fw-bold px-3" onclick="applyModalSettingsAndDivide('balanced')">
                            <i class="bi bi-scales me-1"></i> Xếp Trận Cân Bằng
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-sm fw-bold px-3" onclick="applyModalSettingsAndDivide('friendly')">
                            <i class="bi bi-magic me-1"></i> Áp dụng & Xếp đội hình
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
}

<script>
    // =========================================================================
    // REUSABLE FORMATION TEMPLATES & CONFIGURATION
    // =========================================================================
    const formationTemplates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allFormations));
    const isInternalMatch = @(isInternal ? "true" : "false");
    const isManagerA = @(isManagerA ? "true" : "false");
    const isManagerB = @(isManagerB ? "true" : "false");
    const canManage = @(canEdit ? "true" : "false");
    const myTeamSide = '@myTeamSide';
    const myTeamName = '@Html.Raw(myTeamName)';
    const teamAName = '@Html.Raw(teamAName)';
    const teamBName = '@Html.Raw(teamBName)';
    const tacticalMatchId = '@Model.Id';
    let currentLineupRevision = @Model.LineupRevision;
    let selectedPitchFormat = '@activePitchFormat';
    let activeFormationCode = '@currentFormation.Code';
    let isManagerRole = canManage;
    let selectedSwapSource = null; // { playerId, side, slotCode, playerName, isBench }
    let draggedTokenData = null;   // { playerId, side, slotCode, playerName, isBench }
    let currentDivisionMode = isInternalMatch ? 'a_vs_b' : 'friendly';

    // Roster Seeds
    const myTeamPlayerSeeds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(myTeamPlayers.Select(p => new {
        playerId = p.Id.ToString(),
        playerName = p.FullName,
        kitNumber = p.KitNumber,
        photoUrl = p.PhotoUrl,
        preferredFoot = p.PreferredFoot,
        experience = p.Experience,
        category = AloBall.Web.Services.TeamDivision.PositionCompatibilityMatrix.NormalizePositionString(p.Position ?? "MF")
    })));

    // Lineup In-Memory State
    let sideASlots = []; // Array of slot assignments for Team A
    let sideBSlots = []; // Array of slot assignments for Team B
    let benchPlayers = []; // Substitutes

    document.addEventListener("DOMContentLoaded", function () {
        initPitchFormatPresets();
        populateInitialLineupState();
        updateRoleAndPermissions();
        renderAllTacticalPitches();
        renderBenchTray();
        updateTacticalStats();
    });

    // Populate initial formation options and match format
    function initPitchFormatPresets() {
        populateFormationDropdown(selectedPitchFormat);
    }

    function setPitchFormat(format) {
        if (!isManagerRole) return;
        selectedPitchFormat = format;

        // Cập nhật giao diện nút format
        document.querySelectorAll('.tactical-format-btn').forEach(btn => {
            btn.classList.toggle('active', btn.innerText.includes(format.replace(' người', '')));
        });

        populateFormationDropdown(format);

        // Chọn sơ đồ đầu tiên của thể thức này và kích hoạt chia tự động tức thì
        const selectEl = document.getElementById('tacticalFormationSelect');
        if (selectEl && selectEl.options.length > 0) {
            activeFormationCode = selectEl.value;
            triggerDivision(currentDivisionMode);
        }
    }

    function populateFormationDropdown(format) {
        const selectEl = document.getElementById('tacticalFormationSelect');
        if (!selectEl) return;
        selectEl.innerHTML = '';

        const matching = formationTemplates.filter(f => (f.pitchType || f.PitchType) === format);
        matching.forEach(f => {
            const code = f.code || f.Code;
            const name = f.name || f.Name;
            const players = f.playersPerSide || f.PlayersPerSide;

            const opt = document.createElement('option');
            opt.value = code;
            opt.text = `${name} (${players} người/bên)`;
            if (code === activeFormationCode) opt.selected = true;
            selectEl.appendChild(opt);
        });

        if (selectEl.options.length > 0 && !matching.some(f => (f.code || f.Code) === activeFormationCode)) {
            selectEl.selectedIndex = 0;
            activeFormationCode = selectEl.value;
        }
    }

    function onFormationSelectChanged() {
        if (!isManagerRole) return;
        const selectEl = document.getElementById('tacticalFormationSelect');
        if (selectEl) {
            activeFormationCode = selectEl.value;
            triggerDivision(currentDivisionMode);
        }
    }

    function updateRoleAndPermissions() {
        isManagerRole = canManage;

        const badgeEl = document.getElementById('badgeRoleIndicator');
        if (badgeEl) {
            if (isManagerRole) {
                badgeEl.className = 'badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50';
                badgeEl.innerHTML = '<i class="bi bi-pencil-fill me-1"></i> Quyền Đội trưởng (' + escapeHtml(myTeamName) + ')';
            } else {
                badgeEl.className = 'badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-50';
                badgeEl.innerHTML = '<i class="bi bi-eye-fill me-1"></i> Thành viên (Chế độ xem - ' + escapeHtml(myTeamName) + ')';
            }
        }

        const actionsEl = document.getElementById('managerActionButtons');
        if (actionsEl) {
            actionsEl.style.display = isManagerRole ? 'flex' : 'none';
        }

        document.querySelectorAll('.tactical-format-btn').forEach(btn => {
            btn.disabled = !isManagerRole;
        });
        const selectEl = document.getElementById('tacticalFormationSelect');
        if (selectEl) selectEl.disabled = !isManagerRole;
    }

    // Initialize state from existing lineups in model
    function populateInitialLineupState() {
        @foreach (var l in Model.Lineups)
        {
            bool isForSideA = isInternal ? (l.TeamSide == "A" || l.TeamSide == null) : (l.TeamId == Model.TeamAId);
            bool isForSideB = isInternal ? (l.TeamSide == "B") : (Model.TeamBId.HasValue && l.TeamId == Model.TeamBId.Value);

            // Khi là trận giao hữu, chỉ nạp dữ liệu của đội người dùng đang xem
            bool isRelevant = isInternal || (viewerIsSideB ? isForSideB : isForSideA);

            if (isRelevant)
            {
                if (l.IsStarting && isForSideA)
                {
                    <text>
                    sideASlots.push({
                        slotCode: '@(l.AssignedSlotCode ?? "SLOT")',
                        slotName: '@(l.AssignedPosition ?? l.AssignedSlotCode ?? "Vị trí")',
                        category: '@(AloBall.Web.Services.TeamDivision.PositionCompatibilityMatrix.NormalizePositionString(l.AssignedSlotCode ?? l.AssignedPosition ?? "MF"))',
                        playerId: '@l.PlayerId',
                        playerName: '@Html.Raw(l.Player?.FullName ?? "")',
                        kitNumber: @(l.Player?.KitNumber?.ToString() ?? "null"),
                        photoUrl: '@(l.Player?.PhotoUrl ?? "")',
                        preferredFoot: '@(l.Player?.PreferredFoot ?? "")',
                        experience: '@(l.Player?.Experience ?? "")',
                        isPrimaryPosition: true,
                        assignmentReason: 'Đã lưu đội hình'
                    });
                    </text>
                }
                else if (l.IsStarting && isForSideB)
                {
                    <text>
                    sideBSlots.push({
                        slotCode: '@(l.AssignedSlotCode ?? "SLOT")',
                        slotName: '@(l.AssignedPosition ?? l.AssignedSlotCode ?? "Vị trí")',
                        category: '@(AloBall.Web.Services.TeamDivision.PositionCompatibilityMatrix.NormalizePositionString(l.AssignedSlotCode ?? l.AssignedPosition ?? "MF"))',
                        playerId: '@l.PlayerId',
                        playerName: '@Html.Raw(l.Player?.FullName ?? "")',
                        kitNumber: @(l.Player?.KitNumber?.ToString() ?? "null"),
                        photoUrl: '@(l.Player?.PhotoUrl ?? "")',
                        preferredFoot: '@(l.Player?.PreferredFoot ?? "")',
                        experience: '@(l.Player?.Experience ?? "")',
                        isPrimaryPosition: true,
                        assignmentReason: 'Đã lưu đội hình'
                    });
                    </text>
                }
                else if (!l.IsStarting)
                {
                    <text>
                    benchPlayers.push({
                        playerId: '@l.PlayerId',
                        playerName: '@Html.Raw(l.Player?.FullName ?? "")',
                        kitNumber: @(l.Player?.KitNumber?.ToString() ?? "null"),
                        photoUrl: '@(l.Player?.PhotoUrl ?? "")',
                        preferredFoot: '@(l.Player?.PreferredFoot ?? "")',
                        experience: '@(l.Player?.Experience ?? "")',
                        category: '@(AloBall.Web.Services.TeamDivision.PositionCompatibilityMatrix.NormalizePositionString(l.Player?.Position ?? "MF"))',
                        designatedSide: '@(isForSideA ? "A" : "B")',
                        substituteReason: 'Dự bị chiến thuật'
                    });
                    </text>
                }
            }
        }

        // Nếu trận chưa có đội hình lưu trước đó: Tự động sắp sẵn
        if (sideASlots.length === 0 && myTeamPlayerSeeds.length > 0) {
            triggerDivision(isInternalMatch ? 'a_vs_b' : 'friendly');
        }
    }

    // =========================================================================
    // SMART DIVISION ENGINES (ĐỘI A VS ĐỘI B & TRẬN ĐẤU CÂN BẰNG)
    // =========================================================================
    function getPlayerSkillScore(p) {
        let score = 70;
        const exp = (p.experience || p.Experience || '').toLowerCase();
        if (exp.includes('chuyên nghiệp') || exp.includes('bán chuyên') || exp.includes('ăn tập')) score = 95;
        else if (exp.includes('5+') || exp.includes('> 5') || exp.includes('trên 5')) score = 88;
        else if (exp.includes('3-5') || exp.includes('4')) score = 82;
        else if (exp.includes('1-2') || exp.includes('2-3') || exp.includes('1-3')) score = 76;
        else if (exp.includes('< 1') || exp.includes('mới')) score = 70;

        const kit = p.kitNumber ?? p.KitNumber;
        if (kit && kit < 20) score += 2;
        return score;
    }

    function getNormalizedFormationSlots() {
        const activeFormation = formationTemplates.find(f => (f.code || f.Code) === activeFormationCode) || formationTemplates[0];
        if (!activeFormation) return [];
        const rawSlots = activeFormation.slots || activeFormation.Slots || [];
        return rawSlots.map(s => ({
            slotCode: s.slotCode || s.SlotCode,
            slotName: s.slotName || s.SlotName,
            category: s.category || s.Category,
            xPercent: s.xPercent ?? s.XPercent ?? 50,
            yPercent: s.yPercent ?? s.YPercent ?? 50
        }));
    }

    function triggerDivision(mode) {
        if (!isManagerRole) return;
        currentDivisionMode = mode;

        // Feedback loading trên nút
        const btnAVsB = document.getElementById('btnModeAVsB');
        const btnBalanced = document.getElementById('btnModeBalanced');
        const btnAuto = document.getElementById('btnAutoDivide');

        if (mode === 'a_vs_b' && btnAVsB) btnAVsB.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang xếp...`;
        if (mode === 'balanced' && btnBalanced) btnBalanced.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang chia...`;
        if (mode === 'friendly' && btnAuto) btnAuto.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang xếp...`;

        // Lấy ứng viên từ Modal hoặc toàn bộ danh sách
        const selectedIds = getSelectedModalParticipantIds();
        let candidatePool = myTeamPlayerSeeds;
        if (selectedIds && selectedIds.length > 0) {
            candidatePool = myTeamPlayerSeeds.filter(p => {
                const id = p.playerId || p.PlayerId;
                return selectedIds.some(sel => sel.toLowerCase() === id.toLowerCase());
            });
        }

        // Chạy chia đội tương ứng
        if (isInternalMatch) {
            if (mode === 'a_vs_b') {
                runInternalDivision_AVsB(candidatePool);
            } else {
                runInternalDivision_Balanced(candidatePool);
            }
        } else {
            runFriendlySingleDivision(candidatePool);
        }

        setTimeout(() => {
            if (btnAVsB) btnAVsB.innerHTML = `<i class="bi bi-lightning-charge-fill me-1 text-warning"></i> Đội A vs Đội B`;
            if (btnBalanced) btnBalanced.innerHTML = `<i class="bi bi-scales me-1"></i> Trận đấu cân bằng`;
            if (btnAuto) btnAuto.innerHTML = `<i class="bi bi-magic me-1"></i> Tự động xếp sơ đồ`;
        }, 300);
    }

    // -------------------------------------------------------------------------
    // 1. TÙY CHỌN 1: "ĐỘI A VS ĐỘI B"
    // Điểm Đội A cao nhất, Đội B từng vị trí điểm thấp hơn A, còn lại dự bị
    // -------------------------------------------------------------------------
    function runInternalDivision_AVsB(candidatePool) {
        const formationSlots = getNormalizedFormationSlots();
        if (formationSlots.length === 0) return;

        sideASlots.length = 0;
        sideBSlots.length = 0;
        benchPlayers.length = 0;

        const normalizedPool = (candidatePool || []).map(p => ({
            playerId: p.playerId || p.PlayerId,
            playerName: p.playerName || p.PlayerName,
            kitNumber: p.kitNumber ?? p.KitNumber,
            photoUrl: p.photoUrl || p.PhotoUrl,
            preferredFoot: p.preferredFoot || p.PreferredFoot,
            experience: p.experience || p.Experience,
            category: p.category || p.Category || 'MF'
        }));

        const explicitSubIds = getSelectedModalSubstituteIds() || [];
        const pool = normalizedPool.filter(p => !explicitSubIds.some(id => id.toLowerCase() === p.playerId.toLowerCase()));
        const forcedSubs = normalizedPool.filter(p => explicitSubIds.some(id => id.toLowerCase() === p.playerId.toLowerCase()));

        // Sắp xếp giảm dần theo điểm năng lực
        const sortedPool = [...pool].sort((a, b) => getPlayerSkillScore(b) - getPlayerSkillScore(a));
        const assignedIds = new Set();

        // --- BƯỚC 1: XẾP ĐỘI A (LẤY NHỮNG CẦU THỦ ĐIỂM CAO NHẤT) ---
        // 1.1 GK cho Đội A
        const gkSlotA = formationSlots.find(s => s.category === 'GK');
        if (gkSlotA) {
            let bestGk = sortedPool.find(p => !assignedIds.has(p.playerId) && p.category === 'GK') || sortedPool.find(p => !assignedIds.has(p.playerId));
            if (bestGk) {
                assignedIds.add(bestGk.playerId);
                sideASlots.push(buildAssignedSlot(gkSlotA, bestGk, 'Đội A - Thủ môn xuất sắc nhất'));
            }
        }
        // 1.2 Outfield khớp vị trí cho Đội A
        const outfieldSlotsA = formationSlots.filter(s => s.category !== 'GK');
        outfieldSlotsA.forEach(slot => {
            const match = sortedPool.find(p => !assignedIds.has(p.playerId) && p.category === slot.category);
            if (match) {
                assignedIds.add(match.playerId);
                sideASlots.push(buildAssignedSlot(slot, match, 'Đội A - Đúng sở trường'));
            }
        });
        // 1.3 Lấp đầy các vị trí còn lại của Đội A bằng cầu thủ điểm cao nhất
        outfieldSlotsA.forEach(slot => {
            if (!sideASlots.some(s => s.slotCode === slot.slotCode)) {
                const nextBest = sortedPool.find(p => !assignedIds.has(p.playerId));
                if (nextBest) {
                    assignedIds.add(nextBest.playerId);
                    sideASlots.push(buildAssignedSlot(slot, nextBest, 'Đội A - Phân bổ chiến thuật'));
                }
            }
        });

        // --- BƯỚC 2: XẾP ĐỘI B (CÁC VỊ TRÍ KẾ TIẾP, ĐIỂM THẤP HƠN ĐỘI A) ---
        // 2.1 GK cho Đội B
        const gkSlotB = formationSlots.find(s => s.category === 'GK');
        if (gkSlotB) {
            let secondGk = sortedPool.find(p => !assignedIds.has(p.playerId) && p.category === 'GK') || sortedPool.find(p => !assignedIds.has(p.playerId));
            if (secondGk) {
                assignedIds.add(secondGk.playerId);
                sideBSlots.push(buildAssignedSlot(gkSlotB, secondGk, 'Đội B - Thủ môn kế tiếp'));
            }
        }
        // 2.2 Outfield khớp vị trí cho Đội B
        const outfieldSlotsB = formationSlots.filter(s => s.category !== 'GK');
        outfieldSlotsB.forEach(slot => {
            const match = sortedPool.find(p => !assignedIds.has(p.playerId) && p.category === slot.category);
            if (match) {
                assignedIds.add(match.playerId);
                sideBSlots.push(buildAssignedSlot(slot, match, 'Đội B - Đúng sở trường'));
            }
        });
        // 2.3 Lấp đầy các vị trí còn lại của Đội B
        outfieldSlotsB.forEach(slot => {
            if (!sideBSlots.some(s => s.slotCode === slot.slotCode)) {
                const nextBest = sortedPool.find(p => !assignedIds.has(p.playerId));
                if (nextBest) {
                    assignedIds.add(nextBest.playerId);
                    sideBSlots.push(buildAssignedSlot(slot, nextBest, 'Đội B - Phân bổ chiến thuật'));
                }
            }
        });

        // --- BƯỚC 3: CÁC CẦU THỦ CÒN LẠI VÀO BĂNG GHẾ DỰ BỊ ---
        forcedSubs.forEach(p => benchPlayers.push(buildBenchPlayer(p, 'Dự bị chỉ định', 'A')));
        sortedPool.forEach(p => {
            if (!assignedIds.has(p.playerId)) {
                benchPlayers.push(buildBenchPlayer(p, 'Dự bị chiến thuật', 'B'));
            }
        });

        renderAllTacticalPitches();
        renderBenchTray();
        updateTacticalStats();
    }

    // -------------------------------------------------------------------------
    // 2. TÙY CHỌN 2: "TRẬN ĐẤU CÂN BẰNG"
    // Điểm số và sức mạnh chia đều cho 2 đội (Alternating / Balanced Draft)
    // -------------------------------------------------------------------------
    function runInternalDivision_Balanced(candidatePool) {
        const formationSlots = getNormalizedFormationSlots();
        if (formationSlots.length === 0) return;

        sideASlots.length = 0;
        sideBSlots.length = 0;
        benchPlayers.length = 0;

        const normalizedPool = (candidatePool || []).map(p => ({
            playerId: p.playerId || p.PlayerId,
            playerName: p.playerName || p.PlayerName,
            kitNumber: p.kitNumber ?? p.KitNumber,
            photoUrl: p.photoUrl || p.PhotoUrl,
            preferredFoot: p.preferredFoot || p.PreferredFoot,
            experience: p.experience || p.Experience,
            category: p.category || p.Category || 'MF'
        }));

        const explicitSubIds = getSelectedModalSubstituteIds() || [];
        const pool = normalizedPool.filter(p => !explicitSubIds.some(id => id.toLowerCase() === p.playerId.toLowerCase()));
        const forcedSubs = normalizedPool.filter(p => explicitSubIds.some(id => id.toLowerCase() === p.playerId.toLowerCase()));

        // Sắp xếp giảm dần theo điểm
        const sortedPool = [...pool].sort((a, b) => getPlayerSkillScore(b) - getPlayerSkillScore(a));
        const assignedIds = new Set();

        let totalScoreA = 0;
        let totalScoreB = 0;

        // 2.1 Chia Thủ môn (GK)
        const gkSlot = formationSlots.find(s => s.category === 'GK');
        if (gkSlot) {
            const gks = sortedPool.filter(p => p.category === 'GK');
            if (gks.length >= 2) {
                // GK1 -> A, GK2 -> B
                assignedIds.add(gks[0].playerId);
                sideASlots.push(buildAssignedSlot(gkSlot, gks[0], 'GK Đội A (Cân bằng)'));
                totalScoreA += getPlayerSkillScore(gks[0]);

                assignedIds.add(gks[1].playerId);
                sideBSlots.push(buildAssignedSlot(gkSlot, gks[1], 'GK Đội B (Cân bằng)'));
                totalScoreB += getPlayerSkillScore(gks[1]);
            } else if (gks.length === 1) {
                assignedIds.add(gks[0].playerId);
                sideASlots.push(buildAssignedSlot(gkSlot, gks[0], 'GK Đội A'));
                totalScoreA += getPlayerSkillScore(gks[0]);

                const subGk = sortedPool.find(p => !assignedIds.has(p.playerId));
                if (subGk) {
                    assignedIds.add(subGk.playerId);
                    sideBSlots.push(buildAssignedSlot(gkSlot, subGk, 'GK Đội B (Bù trừ)'));
                    totalScoreB += getPlayerSkillScore(subGk);
                }
            }
        }

        // 2.2 Chia theo từng nhóm vị trí Outfield: DF -> MF -> FW
        const categories = ['DF', 'MF', 'FW'];
        categories.forEach(cat => {
            const slotsOfCat = formationSlots.filter(s => s.category === cat);
            const candidates = sortedPool.filter(p => !assignedIds.has(p.playerId) && p.category === cat);

            slotsOfCat.forEach((slot, idx) => {
                // Ô cho Đội A
                if (!sideASlots.some(s => s.slotCode === slot.slotCode)) {
                    // Chọn cầu thủ sao cho cân bằng tổng điểm
                    let pick = null;
                    if (candidates.length > 0) {
                        // Nếu A đang thấp điểm hơn B, lấy người điểm cao hơn
                        if (totalScoreA <= totalScoreB) {
                            pick = candidates.shift();
                        } else if (candidates.length > 1) {
                            pick = candidates.splice(1, 1)[0];
                        } else {
                            pick = candidates.shift();
                        }
                    }
                    if (pick) {
                        assignedIds.add(pick.playerId);
                        sideASlots.push(buildAssignedSlot(slot, pick, 'Cân bằng sở trường'));
                        totalScoreA += getPlayerSkillScore(pick);
                    }
                }

                // Ô cho Đội B
                if (!sideBSlots.some(s => s.slotCode === slot.slotCode)) {
                    let pick = null;
                    if (candidates.length > 0) {
                        pick = candidates.shift();
                    }
                    if (pick) {
                        assignedIds.add(pick.playerId);
                        sideBSlots.push(buildAssignedSlot(slot, pick, 'Cân bằng sở trường'));
                        totalScoreB += getPlayerSkillScore(pick);
                    }
                }
            });
        });

        // 2.3 Lấp đầy các vị trí còn trống theo nguyên tắc Greedy bù trừ tổng điểm
        const remainingOutfieldSlots = formationSlots.filter(s => s.category !== 'GK');
        remainingOutfieldSlots.forEach(slot => {
            if (!sideASlots.some(s => s.slotCode === slot.slotCode)) {
                const cand = sortedPool.find(p => !assignedIds.has(p.playerId));
                if (cand) {
                    assignedIds.add(cand.playerId);
                    sideASlots.push(buildAssignedSlot(slot, cand, 'Cân bằng quân số'));
                    totalScoreA += getPlayerSkillScore(cand);
                }
            }
            if (!sideBSlots.some(s => s.slotCode === slot.slotCode)) {
                const cand = sortedPool.find(p => !assignedIds.has(p.playerId));
                if (cand) {
                    assignedIds.add(cand.playerId);
                    sideBSlots.push(buildAssignedSlot(slot, cand, 'Cân bằng quân số'));
                    totalScoreB += getPlayerSkillScore(cand);
                }
            }
        });

        // 2.4 Cầu thủ còn lại vào Dự bị
        forcedSubs.forEach(p => benchPlayers.push(buildBenchPlayer(p, 'Dự bị chỉ định', 'A')));
        sortedPool.forEach(p => {
            if (!assignedIds.has(p.playerId)) {
                benchPlayers.push(buildBenchPlayer(p, 'Dự bị chiến thuật', 'B'));
            }
        });

        renderAllTacticalPitches();
        renderBenchTray();
        updateTacticalStats();
    }

    // -------------------------------------------------------------------------
    // 3. TỰ ĐỘNG XẾP CHO TRẬN GIAO HỮU (CHỈ 1 ĐỘI CỦA MÌNH)
    // -------------------------------------------------------------------------
    function runFriendlySingleDivision(candidatePool) {
        const formationSlots = getNormalizedFormationSlots();
        if (formationSlots.length === 0) return;

        const targetSlots = myTeamSide === 'B' ? sideBSlots : sideASlots;
        targetSlots.length = 0;
        benchPlayers.length = 0;

        const normalizedPool = (candidatePool || []).map(p => ({
            playerId: p.playerId || p.PlayerId,
            playerName: p.playerName || p.PlayerName,
            kitNumber: p.kitNumber ?? p.KitNumber,
            photoUrl: p.photoUrl || p.PhotoUrl,
            preferredFoot: p.preferredFoot || p.PreferredFoot,
            experience: p.experience || p.Experience,
            category: p.category || p.Category || 'MF'
        }));

        const explicitSubIds = getSelectedModalSubstituteIds() || [];
        const pool = normalizedPool.filter(p => !explicitSubIds.some(id => id.toLowerCase() === p.playerId.toLowerCase()));
        const forcedSubs = normalizedPool.filter(p => explicitSubIds.some(id => id.toLowerCase() === p.playerId.toLowerCase()));

        const sortedPool = [...pool].sort((a, b) => getPlayerSkillScore(b) - getPlayerSkillScore(a));
        const assignedIds = new Set();

        // GK
        const gkSlot = formationSlots.find(s => s.category === 'GK');
        if (gkSlot) {
            let bestGk = sortedPool.find(p => p.category === 'GK') || sortedPool[0];
            if (bestGk) {
                assignedIds.add(bestGk.playerId);
                targetSlots.push(buildAssignedSlot(gkSlot, bestGk, 'Thủ môn sở trường'));
            }
        }
        // Outfield sở trường
        const outfieldSlots = formationSlots.filter(s => s.category !== 'GK');
        outfieldSlots.forEach(slot => {
            const match = sortedPool.find(p => !assignedIds.has(p.playerId) && p.category === slot.category);
            if (match) {
                assignedIds.add(match.playerId);
                targetSlots.push(buildAssignedSlot(slot, match, 'Đúng sở trường'));
            }
        });
        // Lấp đầy ô trống
        outfieldSlots.forEach(slot => {
            if (!targetSlots.some(s => s.slotCode === slot.slotCode)) {
                const next = sortedPool.find(p => !assignedIds.has(p.playerId));
                if (next) {
                    assignedIds.add(next.playerId);
                    targetSlots.push(buildAssignedSlot(slot, next, 'Phân bổ chiến thuật'));
                }
            }
        });
        // Dự bị
        forcedSubs.forEach(p => benchPlayers.push(buildBenchPlayer(p, 'Dự bị chỉ định', myTeamSide)));
        sortedPool.forEach(p => {
            if (!assignedIds.has(p.playerId)) {
                benchPlayers.push(buildBenchPlayer(p, 'Dự bị chiến thuật', myTeamSide));
            }
        });

        renderAllTacticalPitches();
        renderBenchTray();
        updateTacticalStats();
    }

    // Helper tạo object slot đá chính
    function buildAssignedSlot(slotDef, player, reason) {
        return {
            slotCode: slotDef.slotCode,
            slotName: slotDef.slotName,
            category: slotDef.category,
            xPercent: slotDef.xPercent,
            yPercent: slotDef.yPercent,
            playerId: player.playerId,
            playerName: player.playerName,
            kitNumber: player.kitNumber,
            photoUrl: player.photoUrl,
            preferredFoot: player.preferredFoot,
            experience: player.experience,
            isPrimaryPosition: player.category === slotDef.category,
            assignmentReason: reason
        };
    }

    // Helper tạo object dự bị
    function buildBenchPlayer(player, reason, side) {
        return {
            playerId: player.playerId,
            playerName: player.playerName,
            kitNumber: player.kitNumber,
            photoUrl: player.photoUrl,
            preferredFoot: player.preferredFoot,
            experience: player.experience,
            category: player.category,
            designatedSide: side,
            substituteReason: reason
        };
    }

    // =========================================================================
    // RENDER TACTICAL PITCHES (HỖ TRỢ ĐỒNG THỜI 2 SA BÀN ĐỘI A & ĐỘI B HOẶC 1 SA BÀN)
    // =========================================================================
    function renderAllTacticalPitches() {
        if (isInternalMatch) {
            renderPitchToField('pitchSlotsFieldA', sideASlots, 'A');
            renderPitchToField('pitchSlotsFieldB', sideBSlots, 'B');
        } else {
            const singleField = document.getElementById('pitchSlotsFieldSingle');
            if (singleField) {
                const currentSlots = myTeamSide === 'B' ? sideBSlots : sideASlots;
                renderPitchToField('pitchSlotsFieldSingle', currentSlots, myTeamSide);
            }
        }
    }

    function renderPitchToField(containerId, slotsList, side) {
        const fieldEl = document.getElementById(containerId);
        if (!fieldEl) return;
        fieldEl.innerHTML = '';

        const formationSlots = getNormalizedFormationSlots();

        formationSlots.forEach(s => {
            const slotCode = s.slotCode;
            const slotCategory = s.category;
            const xPercent = s.xPercent;
            const yPercent = s.yPercent;

            const anchorEl = document.createElement('div');
            anchorEl.className = 'tactical-slot-anchor';
            anchorEl.style.left = `${xPercent}%`;
            anchorEl.style.top = `${yPercent}%`;
            anchorEl.dataset.slotCode = slotCode;
            anchorEl.dataset.slotCategory = slotCategory;
            anchorEl.dataset.side = side;

            const assignment = slotsList.find(slot => slot.slotCode === slotCode);

            if (assignment) {
                const cardEl = createPlayerCardElement(assignment, side, false);
                anchorEl.appendChild(cardEl);
            } else {
                const emptyEl = document.createElement('div');
                emptyEl.className = 'ab-slot-empty';
                emptyEl.innerHTML = `
                    <span class="badge ab-pos-${slotCategory} mb-1" style="font-size: 0.62rem;">${slotCode}</span>
                    <span style="font-size: 0.58rem;">Trống</span>
                `;
                if (isManagerRole) {
                    emptyEl.onclick = () => onEmptySlotClicked(slotCode, side);
                }
                anchorEl.appendChild(emptyEl);
            }

            if (isManagerRole) {
                anchorEl.ondragover = (e) => onSlotDragOver(e, anchorEl);
                anchorEl.ondragleave = () => anchorEl.classList.remove('drag-hover');
                anchorEl.ondrop = (e) => onSlotDrop(e, slotCode, side);
            }

            fieldEl.appendChild(anchorEl);
        });
    }

    // Create an AloBall Premium Player Card DOM element
    function createPlayerCardElement(player, side, isBench) {
        const card = document.createElement('div');
        const posCat = player.category || 'MF';
        card.className = `ab-card-premium ${side === 'B' ? 'side-B-card' : ''} ${!isManagerRole ? 'readonly-card' : ''}`;
        card.dataset.playerId = player.playerId;
        card.dataset.playerName = player.playerName;
        card.dataset.side = side;
        card.dataset.slotCode = player.slotCode || '';
        card.title = player.assignmentReason || player.substituteReason || player.playerName;

        if (isManagerRole) {
            card.draggable = true;
            card.ondragstart = (e) => onCardDragStart(e, player, side, isBench);
            card.ondragend = () => card.classList.remove('opacity-50');
            card.onclick = () => onCardClickedForSwap(player, side, isBench);
            card.tabIndex = 0;
            card.onkeydown = (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    onCardClickedForSwap(player, side, isBench);
                } else if (e.key === 'Escape') {
                    cancelSwapSelection();
                }
            };
        }

        // Đang chọn trong cơ chế Tap-to-swap
        if (selectedSwapSource && selectedSwapSource.playerId === player.playerId) {
            card.classList.add('selected-for-swap');
        }

        const initials = getInitials(player.playerName);
        const shortName = getShortName(player.playerName);
        const footIcon = player.preferredFoot === 'Trái' ? '👟 T' : player.preferredFoot === 'Hai chân' ? '👟 2C' : '👟 P';
        const expLabel = player.experience ? player.experience.replace(' năm', 'n') : 'Cầu thủ';

        card.innerHTML = `
            <div class="ab-card-topbar">
                <span class="ab-pos-badge ab-pos-${posCat}">${player.slotCode || 'SUB'}</span>
                <span class="ab-kit-num">#${player.kitNumber || '-'}</span>
            </div>
            <div class="ab-card-avatar">
                ${player.photoUrl ? `<img src="${escapeHtml(player.photoUrl)}" alt="${escapeHtml(player.playerName)}" />` : `<span class="ab-avatar-fallback">${initials}</span>`}
            </div>
            <div class="ab-card-name">${escapeHtml(shortName)}</div>
            <div class="ab-card-meta">
                <span>${footIcon}</span>
                <span>${expLabel}</span>
            </div>
            ${player.assignmentReason ? `<div class="ab-card-reason-pill">${escapeHtml(player.assignmentReason)}</div>` : ''}
        `;

        return card;
    }

    // Render Bench / Substitutes Tray
    function renderBenchTray() {
        const benchEl = document.getElementById('benchListField');
        if (!benchEl) return;
        benchEl.innerHTML = '';
        document.getElementById('benchTotalCount').innerText = benchPlayers.length;

        if (benchPlayers.length === 0) {
            benchEl.innerHTML = `<span class="text-white-50 small fst-italic">Tất cả cầu thủ đang đá chính (Chưa có dự bị)</span>`;
            return;
        }

        benchPlayers.forEach(p => {
            const wrap = document.createElement('div');
            wrap.className = 'smart-bench-item';
            const cardEl = createPlayerCardElement(p, p.designatedSide || 'A', true);
            wrap.appendChild(cardEl);
            benchEl.appendChild(wrap);
        });
    }

    // =========================================================================
    // TAP-TO-SWAP & INTERACTIVE DRAG-AND-DROP (GIỮA 2 SA BÀN VÀ DỰ BỊ)
    // =========================================================================
    function onCardClickedForSwap(player, side, isBench) {
        if (!isManagerRole) return;

        if (!selectedSwapSource) {
            selectedSwapSource = {
                playerId: player.playerId,
                playerName: player.playerName,
                side: side,
                slotCode: player.slotCode,
                isBench: isBench
            };
            document.getElementById('swapPlayerName').innerText = player.playerName;
            document.getElementById('swapPlayerSide').innerText = isBench ? 'Dự bị' : (side === 'A' ? 'Đội A' : 'Đội B');
            const alertEl = document.getElementById('swapAlertBanner');
            alertEl.classList.remove('d-none');
            alertEl.classList.add('d-flex');
            renderAllTacticalPitches();
            renderBenchTray();
        } else {
            if (selectedSwapSource.playerId === player.playerId) {
                cancelSwapSelection();
                return;
            }

            executeSwap(selectedSwapSource, {
                playerId: player.playerId,
                playerName: player.playerName,
                side: side,
                slotCode: player.slotCode,
                isBench: isBench
            });

            cancelSwapSelection();
        }
    }

    function onEmptySlotClicked(targetSlotCode, targetSide) {
        if (!isManagerRole || !selectedSwapSource) return;
        movePlayerToSlot(selectedSwapSource, targetSlotCode, targetSide);
        cancelSwapSelection();
    }

    function cancelSwapSelection() {
        selectedSwapSource = null;
        const alertEl = document.getElementById('swapAlertBanner');
        if (alertEl) {
            alertEl.classList.add('d-none');
            alertEl.classList.remove('d-flex');
        }
        renderAllTacticalPitches();
        renderBenchTray();
    }

    function executeSwap(source, target) {
        // Cả 2 cùng trên sân (có thể cùng Đội A, cùng Đội B hoặc 1 người Đội A, 1 người Đội B)
        if (!source.isBench && !target.isBench) {
            const listSource = source.side === 'A' ? sideASlots : sideBSlots;
            const listTarget = target.side === 'A' ? sideASlots : sideBSlots;

            const p1 = listSource.find(s => s.playerId === source.playerId);
            const p2 = listTarget.find(s => s.playerId === target.playerId);

            if (p1 && p2) {
                const tempSlot = p1.slotCode;
                p1.slotCode = p2.slotCode;
                p2.slotCode = tempSlot;

                if (source.side !== target.side) {
                    listSource.splice(listSource.indexOf(p1), 1);
                    listTarget.splice(listTarget.indexOf(p2), 1);
                    listTarget.push(p1);
                    listSource.push(p2);
                }
            }
        }
        // Source sân, Target dự bị
        else if (!source.isBench && target.isBench) {
            const listPitch = source.side === 'A' ? sideASlots : sideBSlots;
            const starter = listPitch.find(s => s.playerId === source.playerId);
            const sub = benchPlayers.find(b => b.playerId === target.playerId);

            if (starter && sub) {
                const slotCode = starter.slotCode;
                listPitch.splice(listPitch.indexOf(starter), 1);
                benchPlayers.splice(benchPlayers.indexOf(sub), 1);

                sub.slotCode = slotCode;
                starter.slotCode = null;

                listPitch.push(sub);
                benchPlayers.push(starter);
            }
        }
        // Source dự bị, Target sân
        else if (source.isBench && !target.isBench) {
            executeSwap(target, source);
            return;
        }

        renderAllTacticalPitches();
        renderBenchTray();
        updateTacticalStats();
    }

    function movePlayerToSlot(source, targetSlotCode, targetSide) {
        if (!source.isBench) {
            const listSource = source.side === 'A' ? sideASlots : sideBSlots;
            const p = listSource.find(s => s.playerId === source.playerId);
            if (p) {
                p.slotCode = targetSlotCode;
                if (source.side !== targetSide) {
                    listSource.splice(listSource.indexOf(p), 1);
                    const listTarget = targetSide === 'A' ? sideASlots : sideBSlots;
                    listTarget.push(p);
                }
            }
        } else {
            const sub = benchPlayers.find(b => b.playerId === source.playerId);
            if (sub) {
                benchPlayers.splice(benchPlayers.indexOf(sub), 1);
                sub.slotCode = targetSlotCode;
                const listTarget = targetSide === 'A' ? sideASlots : sideBSlots;
                listTarget.push(sub);
            }
        }

        renderAllTacticalPitches();
        renderBenchTray();
        updateTacticalStats();
    }

    // HTML5 Drag and Drop handlers
    function onCardDragStart(e, player, side, isBench) {
        draggedTokenData = {
            playerId: player.playerId,
            playerName: player.playerName,
            side: side,
            slotCode: player.slotCode,
            isBench: isBench
        };
        e.target.classList.add('opacity-50');
        e.dataTransfer.setData('text/plain', player.playerId);
    }

    function onSlotDragOver(e, anchorEl) {
        e.preventDefault();
        anchorEl.classList.add('drag-hover');
    }

    function onSlotDrop(e, targetSlotCode, targetSide) {
        e.preventDefault();
        e.currentTarget.classList.remove('drag-hover');
        if (!draggedTokenData) return;

        const currentSlots = targetSide === 'A' ? sideASlots : sideBSlots;
        const targetPlayer = currentSlots.find(s => s.slotCode === targetSlotCode);

        if (targetPlayer) {
            executeSwap(draggedTokenData, {
                playerId: targetPlayer.playerId,
                playerName: targetPlayer.playerName,
                side: targetSide,
                slotCode: targetSlotCode,
                isBench: false
            });
        } else {
            movePlayerToSlot(draggedTokenData, targetSlotCode, targetSide);
        }

        draggedTokenData = null;
    }

    function onBenchDragOver(e) {
        e.preventDefault();
    }

    function onBenchDrop(e) {
        e.preventDefault();
        if (!draggedTokenData || draggedTokenData.isBench) return;

        const listPitch = draggedTokenData.side === 'A' ? sideASlots : sideBSlots;
        const starter = listPitch.find(s => s.playerId === draggedTokenData.playerId);
        if (starter) {
            listPitch.splice(listPitch.indexOf(starter), 1);
            starter.slotCode = null;
            benchPlayers.push(starter);
            renderAllTacticalPitches();
            renderBenchTray();
            updateTacticalStats();
        }
        draggedTokenData = null;
    }

    // =========================================================================
    // SAVE ACTIONS & STATS
    // =========================================================================
    function saveLineupToServer() {
        if (!isManagerRole) return;

        const btnSave = document.getElementById('btnSaveLineup');
        btnSave.disabled = true;
        btnSave.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...`;

        const assignments = [];
        sideASlots.forEach(s => assignments.push({ playerId: s.playerId, teamSide: 'A', slotCode: s.slotCode }));
        sideBSlots.forEach(s => assignments.push({ playerId: s.playerId, teamSide: 'B', slotCode: s.slotCode }));

        const substitutes = benchPlayers.map(b => ({ playerId: b.playerId, designatedSide: b.designatedSide || 'A' }));

        const requestBody = {
            matchId: tacticalMatchId,
            formationCode: activeFormationCode,
            expectedRevision: currentLineupRevision,
            assignments: assignments,
            substitutes: substitutes
        };

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('/Matches/ConfirmInternalDivision', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(requestBody)
        })
        .then(res => res.json())
        .then(res => {
            btnSave.disabled = false;
            btnSave.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> Lưu đội hình`;

            if (res.success) {
                currentLineupRevision = res.newRevision;
                alert('Đã lưu sơ đồ và đội hình thi đấu thành công!');
            } else {
                alert(res.message || 'Lỗi khi lưu đội hình.');
            }
        })
        .catch(err => {
            btnSave.disabled = false;
            btnSave.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> Lưu đội hình`;
            alert('Lỗi mạng khi lưu đội hình.');
        });
    }

    // Update stats bar and team average scores
    function updateTacticalStats() {
        const totalStarters = sideASlots.length + (isInternalMatch ? sideBSlots.length : 0);
        const totalSubs = benchPlayers.length;

        // Tính điểm trung bình của từng đội
        let sumA = 0;
        let primA = 0;
        sideASlots.forEach(s => {
            sumA += getPlayerSkillScore(s);
            if (s.isPrimaryPosition) primA++;
        });
        const avgA = sideASlots.length > 0 ? Math.round(sumA / sideASlots.length) : 0;

        let sumB = 0;
        let primB = 0;
        sideBSlots.forEach(s => {
            sumB += getPlayerSkillScore(s);
            if (s.isPrimaryPosition) primB++;
        });
        const avgB = sideBSlots.length > 0 ? Math.round(sumB / sideBSlots.length) : 0;

        const countAEl = document.getElementById('countA');
        const avgAEl = document.getElementById('avgScoreA');
        if (countAEl) countAEl.innerText = `${sideASlots.length}`;
        if (avgAEl) avgAEl.innerText = `${avgA} đ`;

        const countBEl = document.getElementById('countB');
        const avgBEl = document.getElementById('avgScoreB');
        if (countBEl) countBEl.innerText = `${sideBSlots.length}`;
        if (avgBEl) avgBEl.innerText = `${avgB} đ`;

        document.getElementById('statStartersCount').innerText = `${totalStarters} cầu thủ`;
        document.getElementById('statSubsCount').innerText = totalSubs;
        const totalPrimary = primA + (isInternalMatch ? primB : 0);
        document.getElementById('statPrimaryCount').innerText = totalStarters > 0 ? `${Math.round((totalPrimary / totalStarters) * 100)}%` : '--';
    }

    // =========================================================================
    // MODAL PARTICIPANT SETTINGS HELPERS
    // =========================================================================
    function openParticipantSettingsModal() {
        refreshModalParticipantCount();
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('participantSettingsModal'));
        modal.show();
    }

    function toggleSelectAllParticipants(checked) {
        document.querySelectorAll('.chk-participant').forEach(chk => {
            chk.checked = checked;
        });
        const masterChk = document.getElementById('chkSelectAllParticipants');
        if (masterChk) masterChk.checked = checked;
        refreshModalParticipantCount();
    }

    function onParticipantCheckboxChanged() {
        const all = document.querySelectorAll('.chk-participant');
        const checked = document.querySelectorAll('.chk-participant:checked');
        const masterChk = document.getElementById('chkSelectAllParticipants');
        if (masterChk) masterChk.checked = (all.length > 0 && all.length === checked.length);
        refreshModalParticipantCount();
    }

    function refreshModalParticipantCount() {
        const parts = document.querySelectorAll('.chk-participant:checked').length;
        const subs = document.querySelectorAll('.chk-substitute:checked').length;
        const pEl = document.getElementById('modalTotalPart');
        const sEl = document.getElementById('modalTotalSub');
        if (pEl) pEl.innerText = parts;
        if (sEl) sEl.innerText = subs;
    }

    function applyModalSettingsAndDivide(mode) {
        const modalEl = document.getElementById('participantSettingsModal');
        if (modalEl) {
            bootstrap.Modal.getOrCreateInstance(modalEl).hide();
        }
        triggerDivision(mode || currentDivisionMode);
    }

    function getSelectedModalParticipantIds() {
        const checked = document.querySelectorAll('.chk-participant:checked');
        if (checked.length === 0) return null;
        return Array.from(checked).map(c => c.value);
    }

    function getSelectedModalSubstituteIds() {
        const checked = document.querySelectorAll('.chk-substitute:checked');
        return Array.from(checked).map(c => c.value);
    }

    function getInitials(name) {
        if (!name) return 'AB';
        const parts = name.trim().split(/\s+/);
        if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }

    function getShortName(name) {
        if (!name) return 'CẦU THỦ';
        const parts = name.trim().split(/\s+/);
        if (parts.length <= 2) return name;
        return parts.slice(-2).join(' ');
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
</script>
